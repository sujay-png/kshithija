---
// Footer.astro
---

<footer class="bg-[#24211a] text-[#eae4d3] py-12 px-6">
  <div class="container mx-auto max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Column 1: Brand & About -->
      <div class="flex flex-col space-y-4">
        <!-- Logo Box -->
        <div class="w-24 h-24 bg-white rounded-xl p-2 flex items-center justify-center shadow-sm overflow-hidden">
          <img 
            src="/images/logo.webp" 
            alt="Kshithija Enterprises Logo" 
            class="w-16 h-16 object-contain"
            onerror="this.style.display='none'; const fb = this.nextElementSibling; if (fb) fb.classList.remove('hidden');"
          />
          <div class="hidden w-16 h-16 rounded-full border-2 border-gray-700 flex flex-col items-center justify-center text-gray-800 relative">
            <span class="text-2xl">🌿</span>
            <span class="absolute top-0 right-0 text-[10px] font-bold">®</span>
          </div>
        </div>

        <p class="text-sm leading-relaxed text-[#d6cdb7]">
          Natural beauty and wellness products manufacturers, Mangaluru.
        </p>

        <!-- Social Media Icons -->
        <div class="flex items-center space-x-2 pt-2">
          <!-- Facebook -->
          <a 
            href="https://facebook.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Facebook"
            class="w-8 h-8 rounded bg-[#3b5998] hover:opacity-90 flex items-center justify-center text-white transition-opacity"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Instagram"
            class="w-8 h-8 rounded bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] hover:opacity-90 flex items-center justify-center text-white transition-opacity"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a 
            href="https://linkedin.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="LinkedIn"
            class="w-8 h-8 rounded bg-[#0077b5] hover:opacity-90 flex items-center justify-center text-white transition-opacity"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- YouTube -->
          <a 
            href="https://youtube.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="YouTube"
            class="w-8 h-8 rounded bg-[#cd201f] hover:opacity-90 flex items-center justify-center text-white transition-opacity"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3 class="text-sm font-bold tracking-widest text-[#f5efe0] uppercase mb-4">
          NAVIGATION
        </h3>
        <ul class="space-y-2 text-sm text-[#d6cdb7]">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/products" class="hover:text-white transition-colors">Products</a></li>
          <li><a href="/beauty-products" class="hover:text-white transition-colors">Beauty Products</a></li>
          <li><a href="/wellness-products" class="hover:text-white transition-colors">Wellness Products</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blogs</a></li>
          <li><a href="/career" class="hover:text-white transition-colors">Careers</a></li>
          <li><a href="/affiliate-registration" class="hover:text-white transition-colors">Affiliate Registration</a></li>
          <li><a href="/affiliate-login" class="hover:text-white transition-colors">Affiliate Login</a></li>
          <li><a href="/affiliate-dashboard" class="hover:text-white transition-colors">Affiliate Dashboard</a></li>
        </ul>
      </div>

      <!-- Column 3: Store Hours -->
      <div>
        <h3 class="text-sm font-bold tracking-widest text-[#f5efe0] uppercase mb-4">
          STORE HOURS
        </h3>
        <ul class="space-y-3 text-sm text-[#d6cdb7]">
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Mon-Fri : 10am-5pm</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Saturday : 10am-6pm</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Sunday : Closed</span>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="text-sm font-bold tracking-widest text-[#f5efe0] uppercase mb-4">
          CONTACT
        </h3>
        <ul class="space-y-3 text-sm text-[#d6cdb7] mb-4">
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Mangaluru - 575003</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:kshithijamlr@gmail.com" class="hover:text-white transition-colors">
              kshithijamlr@gmail.com
            </a>
          </li>
          <li class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-[#c4b38d] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:9482126493" class="hover:text-white transition-colors">
              9482126493
            </a>
          </li>
        </ul>

        <!-- Map Embed / Preview Card -->
        <div class="relative w-full h-32 rounded overflow-hidden border border-gray-600 bg-gray-200 shadow">
          <iframe 
            title="Kshithija Enterprises Location Map"
            src="https://maps.google.com/maps?q=Kshithija+Enterprises+Mangaluru&t=&z=14&ie=UTF8&iwloc=&output=embed" 
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a 
            href="https://maps.google.com/?q=Kshithija+Enterprises+Mangaluru" 
            target="_blank" 
            rel="noopener noreferrer"
            class="absolute top-2 left-2 bg-white text-gray-800 text-xs px-2 py-1 rounded shadow flex items-center space-x-1 hover:bg-gray-100"
          >
            <span>Maps</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</footer>
