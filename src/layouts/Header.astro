---
// src/layouts/Header.astro
// Fully responsive header optimized for mobile, tablet, laptop, and ultra-wide screens
---

<header class="sticky top-0 z-50 bg-[#071911] shadow-md transition-all">
  <div class="flex items-stretch w-full min-h-[64px] sm:min-h-[70px] bg-white">
    
    <!-- Left: Dark Slanted Brand Section (Responsive clip-path on desktop, compact on mobile) -->
    <div class="relative bg-[#071911] text-white flex items-center pl-4 sm:pl-6 pr-6 sm:pr-12 shrink-0 lg:[clip-path:polygon(0_0,calc(100%-35px)_0,100%_100%,0_100%)]">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
        <!-- Logo Icon -->
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center bg-[#0d2a1d] text-white relative shadow-inner overflow-hidden shrink-0">
          <img 
            src="/images/logo.webp" 
            alt="Kshithija Enterprises Logo" 
            class="w-6 h-6 sm:w-7 sm:h-7 object-contain"
            onerror="this.style.display='none'; const fb = this.nextElementSibling; if (fb) fb.classList.remove('hidden');" 
          />
   
        </div>
        
        <!-- Brand Name -->
        <div class="flex flex-col">
          <span class="text-base sm:text-xl font-bold tracking-tight text-[#2ea843] leading-none group-hover:text-[#38c452] transition-colors">
            Kshithija
          </span>
          <span class="text-[9px] sm:text-[10px] font-semibold tracking-widest uppercase text-white/90 leading-tight mt-0.5">
            Enterprises
          </span>
        </div>
      </a>
    </div>

    <!-- Right: Navbar Body -->
    <div class="flex items-center justify-end lg:justify-between flex-1 px-3 sm:px-6 lg:px-8 gap-3 sm:gap-4">
      
      <!-- Desktop Nav Links (Hidden on mobile/tablet, visible on lg and up) -->
      <nav class="hidden lg:block">
        <ul class="flex items-center space-x-5 xl:space-x-7 list-none m-0 p-0 text-[14px] font-medium text-gray-700 whitespace-nowrap">
          <li><a href="/" class="hover:text-[#0a7a3b] transition-colors">Home</a></li>
          <li><a href="/products" class="hover:text-[#0a7a3b] transition-colors">Products</a></li>
          <li><a href="/beauty" class="hover:text-[#0a7a3b] transition-colors">Beauty Products</a></li>
          <li><a href="/wellness" class="hover:text-[#0a7a3b] transition-colors">Wellness Products</a></li>
          <li><a href="/blog" class="hover:text-[#0a7a3b] transition-colors">Blogs</a></li>
          <li><a href="/career" class="hover:text-[#0a7a3b] transition-colors">Career</a></li>
          <li><a href="/contact-us" class="hover:text-[#0a7a3b] transition-colors">Contact-Us</a></li>
        </ul>
      </nav>

      <!-- Action Items & Mobile Controls -->
      <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
        
        <!-- Quick Cart Trigger Button (Works on both mobile & desktop) -->
        <button
          type="button"
          id="header-cart-btn"
          aria-label="Open Shopping Basket"
          class="relative p-2 rounded-xl text-gray-700 hover:text-[#0a7a3b] hover:bg-gray-100 transition-colors cursor-pointer flex items-center justify-center"
        >
          <svg class="w-5 h-5 sm:w-5 sm:h-5 text-[#0d2a1d]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            id="header-cart-counter"
            class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-[#1c643b] text-white text-[10px] font-bold flex items-center justify-center shadow-xs"
          >
            0
          </span>
        </button>

        <!-- Login / My Account Link -->
        <a 
          href="/login" 
          id="header-auth-link"
          class="flex items-center gap-1.5 text-gray-700 hover:text-[#0a7a3b] text-xs sm:text-sm font-medium px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-colors group"
        >
          <div class="p-1 rounded-full bg-gray-100 group-hover:bg-[#0a7a3b] group-hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="hidden sm:inline" id="header-auth-label">Login</span>
        </a>

        <!-- Mobile Hamburger Menu Toggle Button (Hidden on lg+) -->
        <button
          type="button"
          id="mobile-menu-toggle-btn"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label="Toggle Navigation Menu"
          class="lg:hidden p-2 rounded-xl text-gray-700 hover:text-[#0a7a3b] hover:bg-gray-100 transition-colors cursor-pointer flex items-center justify-center focus:outline-none"
        >
          <svg id="hamburger-icon-svg" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon-svg" class="hidden w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 bg-black/50 backdrop-blur-xs z-40 hidden lg:hidden opacity-0 transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- Mobile Navigation Slide-out Drawer -->
  <div
    id="mobile-nav-drawer"
    class="fixed top-[64px] sm:top-[70px] right-0 bottom-0 w-[290px] sm:w-[340px] max-w-[85vw] bg-white shadow-2xl z-50 hidden lg:hidden flex-col justify-between overflow-y-auto border-l border-[#e8dfcf] transform translate-x-full transition-transform duration-300 ease-out"
    role="dialog"
    aria-label="Mobile Navigation"
  >
    <div class="p-5 space-y-6">
      
      <!-- User Account Header Bar in Drawer -->
      <div id="mobile-user-status" class="p-3.5 rounded-2xl bg-[#fbf9f4] border border-[#e8dfcf] flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-[#1c643b] text-white flex items-center justify-center text-sm font-bold shadow-xs">
            👤
          </div>
          <div>
            <span id="mobile-username" class="text-xs font-bold text-[#082213] block">Welcome Guest</span>
            <span id="mobile-user-sub" class="text-[11px] text-[#607065] block">Natural Ayurvedic Care</span>
          </div>
        </div>
        <a 
          href="/login" 
          id="mobile-account-cta" 
          class="text-xs font-semibold text-[#1c643b] hover:underline"
        >
          Sign In &rarr;
        </a>
      </div>

      <!-- Main Navigation Links List -->
      <nav>
        <ul class="space-y-1 text-sm font-semibold text-[#082213]">
          <li>
            <a href="/" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">🏠</span>
              <span>Home</span>
            </a>
          </li>
          <li>
            <a href="/products" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">🧴</span>
              <span>All Products</span>
            </a>
          </li>
          <li>
            <a href="/beauty" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">✨</span>
              <span>Beauty Products</span>
            </a>
          </li>
          <li>
            <a href="/wellness" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">🌿</span>
              <span>Wellness Products</span>
            </a>
          </li>
          <li>
            <a href="/blog" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">📖</span>
              <span>Blogs & Guides</span>
            </a>
          </li>
          <li>
            <a href="/career" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">💼</span>
              <span>Career</span>
            </a>
          </li>
          <li>
            <a href="/contact-us" class="mobile-nav-link flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-[#eaf4ed] hover:text-[#1c643b] transition-colors">
              <span class="text-base">📞</span>
              <span>Contact Us</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Quick Account & Customer Links -->
      <div class="pt-4 border-t border-[#f0eae0] space-y-1">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[#7a8a80] px-3 block mb-1">
          Account & Orders
        </span>
        <a href="/orders" class="mobile-nav-link flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-semibold text-[#082213] hover:bg-[#faf7f2] transition-colors">
          <span class="flex items-center gap-2">
            <span>📦</span>
            <span>My Orders & Delivery</span>
          </span>
          <span class="text-gray-400">&rarr;</span>
        </a>
        <a href="/affiliate-registration" class="mobile-nav-link flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-semibold text-[#082213] hover:bg-[#faf7f2] transition-colors">
          <span class="flex items-center gap-2">
            <span>🤝</span>
            <span>Affiliate Program</span>
          </span>
          <span class="text-gray-400">&rarr;</span>
        </a>
      </div>

    </div>

    <!-- Drawer Footer: Quick Help & WhatsApp Call -->
    <div class="p-5 border-t border-[#f0eae0] bg-[#faf8f5] space-y-2.5">
      <div class="flex items-center justify-between text-xs text-[#55695b]">
        <span>Need assistance?</span>
        <a href="tel:9482126493" class="font-bold text-[#1c643b] hover:underline">📞 +91 9482126493</a>
      </div>
      <a
        href="https://wa.me/919482126493?text=Hi%20Kshithija%2C%20I%20have%20an%20inquiry%20regarding%20your%20products."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-2.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-xs font-bold flex items-center justify-center gap-2 shadow-sm transition-colors"
      >
        <span>💬</span>
        <span>Chat on WhatsApp</span>
      </a>
    </div>

  </div>
</header>

<!-- Header Client Script: Mobile menu drawer, cart counter badge, & auth state -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Mobile Menu Drawer Toggle
    const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const hamburgerIcon = document.getElementById('hamburger-icon-svg');
    const closeIcon = document.getElementById('close-icon-svg');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    function openMobileMenu() {
      if (!drawer || !backdrop) return;
      isOpen = true;
      toggleBtn?.setAttribute('aria-expanded', 'true');
      drawer.classList.remove('hidden');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('opacity-0');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      });
    }

    function closeMobileMenu() {
      if (!drawer || !backdrop) return;
      isOpen = false;
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer.classList.add('translate-x-full');
      backdrop.classList.add('opacity-0');
      document.body.style.overflow = '';
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');

      setTimeout(() => {
        if (!isOpen) {
          drawer.classList.add('hidden');
          backdrop.classList.add('hidden');
        }
      }, 300);
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) closeMobileMenu();
      else openMobileMenu();
    });

    backdrop?.addEventListener('click', closeMobileMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMobileMenu();
    });

    // 2. Cart Icon Trigger: opens CartDrawer
    const headerCartBtn = document.getElementById('header-cart-btn');
    headerCartBtn?.addEventListener('click', () => {
      const openCartBtn = document.getElementById('open-cart-btn');
      if (openCartBtn) {
        openCartBtn.click();
      } else {
        window.location.href = '/cart';
      }
    });

    // 3. Dynamic Cart Item Counter Badge
    function syncCartCount() {
      try {
        const raw = localStorage.getItem('kshithija_cart_v1');
        const cart = raw ? JSON.parse(raw) : [];
        const total = cart.reduce((sum, item) => sum + (parseInt(item.quantity) || 1), 0);
        const counter = document.getElementById('header-cart-counter');
        if (counter) {
          if (total > 0) {
            counter.textContent = total > 99 ? '99+' : String(total);
            counter.classList.remove('hidden');
          } else {
            counter.classList.add('hidden');
          }
        }
      } catch (e) {}
    }

    syncCartCount();
    window.addEventListener('storage', syncCartCount);
    window.addEventListener('cart-updated', syncCartCount);

    // 4. User Authentication State in Header & Drawer
    try {
      const userRaw = localStorage.getItem('kshithija_auth_user');
      if (userRaw) {
        const user = JSON.parse(userRaw);
        const authLink = document.getElementById('header-auth-link');
        const authLabel = document.getElementById('header-auth-label');
        const mobileUsername = document.getElementById('mobile-username');
        const mobileUserSub = document.getElementById('mobile-user-sub');
        const mobileAccountCta = document.getElementById('mobile-account-cta');

        const displayName = user.firstName || user.displayName || user.username || 'Account';

        if (authLink) authLink.href = '/my-account';
        if (authLabel) authLabel.textContent = displayName;

        if (mobileUsername) mobileUsername.textContent = displayName;
        if (mobileUserSub) mobileUserSub.textContent = user.email || 'Verified Customer';
        if (mobileAccountCta) {
          mobileAccountCta.href = '/my-account';
          mobileAccountCta.textContent = 'Dashboard →';
        }
      }
    } catch (e) {}
  });
</script>
