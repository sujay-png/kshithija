---
// src/pages/contact-us.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Kshithija Enterprises">
  
  <!-- Hero Section -->
  <section class="relative w-full bg-[#082213] py-12 sm:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden text-white">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#2ea843]/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="inline-flex items-center justify-center gap-2 text-xs sm:text-[13px] text-[#c0d6c7] bg-black/25 backdrop-blur-xs px-3.5 py-1 rounded-full border border-white/10">
          <li>
            <a href="/" class="hover:text-white transition-colors">Home</a>
          </li>
          <li class="text-[#729c80]">/</li>
          <li class="font-semibold text-white tracking-wide" aria-current="page">Contact Us</li>
        </ol>
      </nav>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-white tracking-tight mb-3">
        Get in Touch With Us
      </h1>
    
    </div>
  </section>

  <!-- Main Contact Content Section -->
  <section class="relative w-full bg-[#fbf9f4] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf]">
    <div class="max-w-7xl mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
    

        <!-- Right Column: Interactive Contact Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-[#e8dfcf] shadow-md">
            
            <div class="mb-6">
              <span class="inline-block px-3.5 py-1 rounded-full bg-[#f4ede0] text-[#082213] text-[11px] font-bold tracking-widest uppercase border border-[#ded5c5] mb-2">
                Send a Message
              </span>
              <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#082213]">
                How Can We Help You?
              </h2>

              
              <p class="text-xs sm:text-sm text-[#5a6e61] mt-1">
                Fill in the form below and our team will get back to you promptly.
              </p>
            </div>

            <!-- Hidden Iframe to handle Cross-Origin WordPress Form Submission seamlessly -->
            <iframe name="wp_form_target" id="wp_form_target" class="hidden" style="display:none; width:0; height:0; border:0;" title="WP Form Target"></iframe>

            <form 
              id="contact-form" 
              action="https://kshithija.in/wp-admin/admin-ajax.php" 
              method="POST" 
              target="wp_form_target"
              class="space-y-4 sm:space-y-5"
            >
              <!-- WordPress Elementor Pro Form Integration Fields -->
              <input type="hidden" name="action" value="elementor_pro_forms_send_form" />
              <input type="hidden" id="wp_post_id" name="post_id" value="782" />
              <input type="hidden" id="wp_form_id" name="form_id" value="6789792" />
              <input type="hidden" name="referer_title" value="Natural Products - Contact kshithija Enterprises" />
              <input type="hidden" id="wp_queried_id" name="queried_id" value="782" />
              <!-- Mapped message field for Elementor's existing form field (field_5fa3091) -->
              <input type="hidden" id="wp_field_message_combined" name="form_fields[field_5fa3091]" value="" />
              
              <!-- Row 1: Name and Phone -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Name -->
                <div>
                  <label for="name" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Your Name <span class="text-[#c25e30]">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="form_fields[name]"
                    required
                    placeholder="Enter your full name"
                    class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
                  />
                </div>

                <!-- Phone -->
                <div>
                  <label for="phone" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Phone Number <span class="text-[#c25e30]">*</span>
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="form_fields[phone]"
                    required
                    placeholder="+91 94821 26493"
                    class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
                  />
                </div>
              </div>

              <!-- Row 2: Email and Subject -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Email -->
                <div>
                  <label for="email" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Your Email Address <span class="text-[#c25e30]">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="form_fields[email]"
                    required
                    placeholder="name@example.com"
                    class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
                  />
                </div>

                <!-- Subject -->
                <div>
                  <label for="subject" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Subject <span class="text-[#c25e30]">*</span>
                  </label>
                  <input
                    type="text"
                    id="subject"
                    name="form_fields[subject]"
                    required
                    placeholder="Order inquiry, Product advice..."
                    class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
                  />
                </div>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-xs font-semibold text-[#082213] mb-1.5">
                  Your Message <span class="text-[#c25e30]">*</span>
                </label>
                <textarea
                  id="message"
                  name="form_fields[message]"
                  rows="5"
                  required
                  placeholder="How can we assist you today? Tell us about your concern or requirement..."
                  class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all resize-none"
                ></textarea>
              </div>

              <!-- Submit Button with loading state -->
              <div class="flex flex-col sm:flex-row items-center gap-4 pt-1">
                <button
                  type="submit"
                  id="contact-submit-btn"
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] active:scale-95 text-white text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all shadow-md hover:shadow-lg cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <svg id="contact-submit-spinner" class="hidden animate-spin w-4 h-4 text-white" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                  </svg>
                  <span id="contact-submit-text">Send Message</span>
                  <span id="contact-submit-arrow">→</span>
                </button>

               
              </div>
            </form>

            <!-- Success Alert -->
            <div 
              id="contact-success" 
              class="hidden mt-6 p-6 sm:p-8 rounded-2xl bg-[#eaf4ed] border border-[#b8dfc4] text-center shadow-xs"
            >
              <div class="w-12 h-12 rounded-full bg-[#164e2d] text-white flex items-center justify-center mx-auto mb-3 text-xl shadow-xs">
                ✓
              </div>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#082213]">Message Sent Successfully!</h3>
              <p class="text-xs sm:text-sm text-[#2e593d] mt-2 max-w-md mx-auto leading-relaxed">
                Thank you for contacting Kshithija Enterprises. Your email notification has been dispatched to our team, and we will get back to you shortly.
              </p>

             
            </div>

          </div>
        </div>

      </div>

   

    </div>
  </section>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit-btn');
    const submitSpinner = document.getElementById('contact-submit-spinner');
    const submitText = document.getElementById('contact-submit-text');
    const submitArrow = document.getElementById('contact-submit-arrow');
    const successBanner = document.getElementById('contact-success');
    const waLink = document.getElementById('contact-wa-link');

    if (form) {
      form.addEventListener('submit', (e) => {
        // Collect user input
        const name = document.getElementById('name')?.value.trim() || '';
        const phone = document.getElementById('phone')?.value.trim() || '';
        const email = document.getElementById('email')?.value.trim() || '';
        const subject = document.getElementById('subject')?.value.trim() || '';
        const message = document.getElementById('message')?.value.trim() || '';

        // Format combined message for Elementor template field compatibility
        const combinedField = document.getElementById('wp_field_message_combined');
        if (combinedField) {
          combinedField.value = `Subject: ${subject}\nPhone: ${phone}\nName: ${name}\nEmail: ${email}\n\nMessage:\n${message}`;
        }

       

        // Visual loading state
        if (submitBtn) {
          submitBtn.disabled = true;
          if (submitSpinner) submitSpinner.classList.remove('hidden');
          if (submitArrow) submitArrow.classList.add('hidden');
          if (submitText) submitText.textContent = 'Sending Message...';
        }

        // Also fire background fetch to ensure WordPress receives the submission
        try {
          const formData = new FormData(form);
          fetch('https://kshithija.in/wp-admin/admin-ajax.php', {
            method: 'POST',
            body: formData,
            mode: 'no-cors'
          }).catch(() => {});
        } catch (err) {}

        // Allow form to submit to hidden iframe target, then display confirmation
        setTimeout(() => {
          form.classList.add('hidden');
          if (successBanner) {
            successBanner.classList.remove('hidden');
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }, 1200);
      });
    }
  });
</script>
