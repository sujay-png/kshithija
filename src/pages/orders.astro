---
// src/pages/orders.astro
// Standalone, highly attractive Orders page for Kshithija Enterprises in Light Mode with black text
import Layout from '../layouts/Layout.astro';
import AccountSidebar from '@components/common/AccountSidebar.astro';
---

<Layout title="My Orders - Kshithija Enterprises">
  
  <main class="min-h-screen bg-[#f8fafc] text-[#0f172a] py-8 sm:py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    
    <!-- Subtle Botanical Ambient Background Glows -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-[#2ea843]/10 rounded-full blur-3xl pointer-events-none select-none"></div>
    <div class="absolute -bottom-32 right-10 w-96 h-96 bg-[#c99f5b]/10 rounded-full blur-3xl pointer-events-none select-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">

      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-[#64748b]">
        <ol class="inline-flex items-center gap-2">
          <li><a href="/" class="hover:text-[#0c3920] transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/my-account" class="hover:text-[#0c3920] transition-colors">My account</a></li>
          <li>/</li>
          <li class="font-semibold text-[#082213]" aria-current="page">Orders</li>
        </ol>
      </nav>

      <!-- Main Layout: Sidebar (exact Flowbite design) + Light-Mode Orders Content -->
      <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-start">
        
        <!-- Persistent Sidebar -->
        <AccountSidebar activeItem="orders" />

        <!-- Right Content Section: Light-Mode Orders Table Layout with Black Text -->
        <div class="flex-1 w-full min-w-0 space-y-4">
          
          <!-- Clean Light Card Container -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-sm border border-[#e2e8f0] text-[#082213]">
            
            <!-- Header with Title & Filter Controls -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-[#e2e8f0]">
              
              <!-- Title & Order Count Badge -->
              <div class="flex items-center gap-3">
                <h1 class="text-xl sm:text-2xl font-bold text-[#082213] tracking-tight">
                  My orders
                </h1>
                <span id="orders-count-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#eaf4ed] text-[#1c643b] border border-[#2ea843]/30">
                  0 orders
                </span>
              </div>

              <!-- Filter Controls (Exact match to screenshot in Light Mode) -->
              <div class="flex items-center gap-2.5 text-xs sm:text-sm text-[#475569] flex-wrap">
                
                <!-- Search Input -->
                <div class="relative">
                  <input
                    type="text"
                    id="order-search"
                    placeholder="Search by ID..."
                    class="bg-[#f8fafc] text-[#082213] text-xs rounded-lg pl-8 pr-3 py-1.5 border border-[#cbd5e1] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#0c3920] placeholder-[#94a3b8] w-36 sm:w-44"
                  />
                  <svg class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-[#64748b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>

            

              </div>

            </div>

           

            <!-- Loading Spinner State -->
            <div id="state-loading" class="py-16 text-center text-[#64748b]">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-[#0c3920] border-t-transparent mb-3"></div>
              <p class="text-xs font-semibold text-[#082213]">Loading orders </p>
            </div>

            <!-- Not Logged In State (No dummy orders!) -->
            <div id="state-not-logged-in" class="hidden py-16 text-center text-[#64748b]">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#f1f5f9] border border-[#e2e8f0] flex items-center justify-center text-2xl">
                🔒
              </div>
              <h3 class="text-base font-bold text-[#082213] mb-1">Sign in to view your orders</h3>
              <p class="text-xs text-[#64748b] max-w-sm mx-auto mb-5 leading-relaxed">
                Log in with your Kshithija customer credentials to fetch your real WooCommerce orders and delivery updates.
              </p>
              <a
                href="/login?redirect=/orders"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs font-semibold transition shadow-xs cursor-pointer"
              >
                <span>Sign In to Your Account</span>
                <span>→</span>
              </a>
            </div>

            <!-- Logged In, But 0 Orders Found in WordPress -->
            <div id="state-no-orders" class="hidden py-16 text-center text-[#64748b]">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#f1f5f9] border border-[#e2e8f0] flex items-center justify-center text-2xl">
                📦
              </div>
              <h3 class="text-base font-bold text-[#082213] mb-1">No orders found</h3>
              <p class="text-xs text-[#64748b] max-w-sm mx-auto mb-5 leading-relaxed">
                You haven't placed any orders yet on Kshithija Enterprises. Explore our natural wellness and botanical beauty products.
              </p>
              <a
                href="/products"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs font-semibold transition shadow-xs cursor-pointer"
              >
                <span>Browse Products</span>
                <span>→</span>
              </a>
            </div>

            <!-- Orders Table List (Divided rows with black text) -->
            <div id="orders-list-rows" class="divide-y divide-[#e2e8f0] hidden">
              <!-- Populated dynamically with ONLY real WordPress orders -->
            </div>

            <!-- Empty Search State -->
            <div id="empty-state" class="hidden py-16 text-center text-[#64748b]">
              <span class="text-3xl block mb-2">🔍</span>
              <p class="text-sm font-bold text-[#082213] mb-1">No matching orders found</p>
              <p class="text-xs text-[#64748b] mb-4">Try clearing your search query or changing filter settings.</p>
              <button
                type="button"
                id="btn-reset"
                class="px-4 py-2 rounded-lg bg-[#f1f5f9] hover:bg-[#e2e8f0] text-[#082213] text-xs font-semibold cursor-pointer transition"
              >
                Reset Filters
              </button>
            </div>

          </div>

     

        </div>

      </div>

    </div>

    <!-- VIEW DETAILS MODAL (Light Mode) -->
    <div id="modal-order-details" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden flex items-center justify-center p-4">
      <div class="bg-white text-[#082213] rounded-3xl border border-[#cbd5e1] max-w-2xl w-full p-6 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <button type="button" id="btn-close-modal" class="absolute top-5 right-5 text-[#64748b] hover:text-[#082213] p-1.5 rounded-full hover:bg-[#f1f5f9] text-base cursor-pointer transition">✕</button>
        
        <div id="modal-order-content" class="space-y-6 text-xs sm:text-sm">
          <!-- Dynamically populated matching user screenshot -->
        </div>

        <div class="mt-7 pt-4 border-t border-[#e2e8f0] flex items-center justify-end">
          <button
            type="button"
            id="btn-close-modal-footer"
            class="px-5 py-2 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] text-white text-xs font-semibold cursor-pointer transition shadow-xs"
          >
            Close
          </button>
        </div>
      </div>
    </div>

  </main>

</Layout>

<script>
  import { getStoredToken, getStoredUser, getCustomerOrders, getCustomerProfile, type CustomerAddress } from '../lib/auth';
  import { cancelWooCommerceOrder } from '../lib/checkout';

  interface OrderData {
    rawId?: number;
    orderId: string;
    date: string;
    price: string;
    subtotal?: string;
    discount?: string;
    customerNote?: string;
    status: 'pending' | 'on-hold' | 'pre-order' | 'in-transit' | 'confirmed' | 'cancelled' | 'refunded' | 'failed';
    statusLabel: string;
    itemsSummary: string;
    itemsList: Array<{ name: string; qty: number; price: string }>;
    awbNumber: string;
    isLive?: boolean;
    source?: string;
    paymentMethod?: string;
    shippingAddress?: string;
    billingAddress?: string;
    billing?: CustomerAddress | null;
    shipping?: CustomerAddress | null;
  }

  // Zero dummy orders - only live WordPress WooCommerce orders
  let ordersList: OrderData[] = [];
  let cachedCustomerProfile: any = null;
  let filterStatus = 'all';
  let searchQuery = '';

  function getBadgeMarkup(status: string, label: string) {
    if (status === 'pending') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#fffbeb] text-[#b45309] border border-[#fde68a]">
          <span>⏳</span>
          <span>${label || 'Pending payment'}</span>
        </span>
      `;
    }
    if (status === 'on-hold') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#fff7ed] text-[#c2410c] border border-[#ffedd5]">
          <span>⏸️</span>
          <span>${label || 'On hold'}</span>
        </span>
      `;
    }
    if (status === 'pre-order') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#f0f9ff] text-[#0284c7] border border-[#bae6fd]">
          <span>⚙️</span>
          <span>${label || 'Processing'}</span>
        </span>
      `;
    }
    if (status === 'in-transit') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#f8fafc] text-[#475569] border border-[#cbd5e1]">
          <span>🚚</span>
          <span>${label || 'In Transit'}</span>
        </span>
      `;
    }
    if (status === 'confirmed') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#f0fdf4] text-[#16a34a] border border-[#bbf7d0]">
          <span>✓</span>
          <span>${label || 'Completed'}</span>
        </span>
      `;
    }
    if (status === 'cancelled') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#fef2f2] text-[#dc2626] border border-[#fecaca]">
          <span>✕</span>
          <span>${label || 'Cancelled'}</span>
        </span>
      `;
    }
    if (status === 'refunded') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#fdf4ff] text-[#a21caf] border border-[#f5d0fe]">
          <span>↩</span>
          <span>${label || 'Refunded'}</span>
        </span>
      `;
    }
    if (status === 'failed') {
      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#fff1f2] text-[#e11d48] border border-[#fecdd3]">
          <span>⚠️</span>
          <span>${label || 'Failed'}</span>
        </span>
      `;
    }
    return `<span>${label}</span>`;
  }

  function renderOrders() {
    const container = document.getElementById('orders-list-rows');
    const emptyState = document.getElementById('empty-state');
    const countBadge = document.getElementById('orders-count-badge');
    if (!container) return;

    if (ordersList.length === 0) {
      container.innerHTML = '';
      container.classList.add('hidden');
      emptyState?.classList.add('hidden');
      if (countBadge) countBadge.textContent = '0 orders';
      return;
    }

    const filtered = ordersList.filter((order) => {
      if (filterStatus !== 'all' && order.status !== filterStatus) return false;
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        const matchesId = order.orderId.toLowerCase().includes(q);
        const matchesItems = order.itemsSummary.toLowerCase().includes(q);
        if (!matchesId && !matchesItems) return false;
      }
      return true;
    });

    if (countBadge) {
      countBadge.textContent = `${filtered.length} order${filtered.length === 1 ? '' : 's'}`;
    }

    if (filtered.length === 0) {
      container.innerHTML = '';
      container.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      return;
    }

    emptyState?.classList.add('hidden');
    container.classList.remove('hidden');

    container.innerHTML = filtered.map((o) => {
      const isPending = o.status === 'pre-order' || o.status === 'in-transit';

      return `
        <div class="py-4.5 flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs transition-colors hover:bg-[#f8fafc] rounded-xl px-2">
          
          <!-- Column 1: Order ID (Black bold text + WP badge if live) -->
          <div class="w-full md:w-44 shrink-0">
            <span class="text-[11px] text-[#64748b] block mb-0.5">Order ID:</span>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-xs sm:text-sm font-bold text-[#082213] tracking-wide">${o.orderId}</span>
             
            </div>
          </div>

          <!-- Column 2: Date (Black bold text) -->
          <div class="w-full md:w-28 shrink-0">
            <span class="text-[11px] text-[#64748b] block mb-0.5">Date:</span>
            <span class="text-xs sm:text-sm font-bold text-[#082213]">${o.date}</span>
          </div>

          <!-- Column 3: Price (Black bold text) -->
          <div class="w-full md:w-24 shrink-0">
            <span class="text-[11px] text-[#64748b] block mb-0.5">Price:</span>
            <span class="text-xs sm:text-sm font-bold text-[#082213]">${o.price}</span>
          </div>

          <!-- Column 4: Status Badge -->
          <div class="w-full md:w-32 shrink-0">
            <span class="text-[11px] text-[#64748b] block mb-1">Status:</span>
            ${getBadgeMarkup(o.status, o.statusLabel)}
          </div>

          <!-- Column 5: Action Buttons (Right Aligned) -->
          <div class="flex items-center gap-2 shrink-0 justify-start md:justify-end mt-1 md:mt-0 flex-wrap">
            <button
              type="button"
              data-action="view"
              data-id="${o.orderId}"
              class="px-3.5 py-1.5 rounded-lg border border-[#cbd5e1] bg-white hover:bg-[#f8fafc] text-[#082213] text-xs font-semibold transition cursor-pointer shadow-2xs"
            >
              View
            </button>

            ${(o.status !== 'cancelled' && o.status !== 'refunded') ? `
              <button
                type="button"
                data-action="cancel"
                data-id="${o.orderId}"
                class="px-3.5 py-1.5 rounded-lg border border-red-500 text-red-600 hover:bg-red-50 text-xs font-semibold transition cursor-pointer"
              >
                Cancel
              </button>
            ` : ''}
          </div>

        </div>
      `;
    }).join('');

    bindButtonActions();
  }

  let selectedOrder: OrderData | null = null;

  function bindButtonActions() {
    // 1. Cancel order action (Cancels order & refunds online payment)
    document.querySelectorAll('[data-action="cancel"]').forEach((b) => {
      b.addEventListener('click', async () => {
        const id = b.getAttribute('data-id');
        const item = ordersList.find((o) => o.orderId === id);
        if (!item) return;

        const confirmMsg = `Are you sure you want to cancel order ${item.orderId}?\nIf you paid online via Razorpay, a full refund of ${item.price} will be refunded to your original payment method.`;
        if (!confirm(confirmMsg)) return;

        const btnEl = b as HTMLButtonElement;
        const originalText = btnEl.textContent;
        btnEl.disabled = true;
        btnEl.textContent = 'Processing...';

        try {
          const rawNum = item.rawId || Number(item.orderId.replace(/\D/g, ''));
          const token = getStoredToken();
          const result = await cancelWooCommerceOrder({
            order_id: Number(rawNum),
            reason: 'Customer requested cancellation via My Orders',
            token: token || undefined,
          });

          if (result.success) {
            item.status = (result.status === 'refunded' || result.refund_id) ? 'refunded' : 'cancelled';
            item.statusLabel = result.status_label || (item.status === 'refunded' ? 'Refunded' : 'Cancelled');
            renderOrders();
            alert(result.message || `Order ${item.orderId} was cancelled successfully.`);
          } else {
            alert(result.message || 'Unable to cancel order. Please contact store support.');
            btnEl.disabled = false;
            btnEl.textContent = originalText;
          }
        } catch (err) {
          console.error('Cancellation error:', err);
          alert('Failed to connect to cancellation server. Please try again.');
          btnEl.disabled = false;
          btnEl.textContent = originalText;
        }
      });
    });

    // 2. View details action
    document.querySelectorAll('[data-action="view"]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.getAttribute('data-id');
        const item = ordersList.find((o) => o.orderId === id);
        if (item) {
          selectedOrder = item;
          openModal(item);
        }
      });
    });
  }

  async function openModal(item: OrderData) {
    const modal = document.getElementById('modal-order-details');
    const content = document.getElementById('modal-order-content');
    if (!modal || !content) return;

    // Asynchronously ensure backend profile address is fetched
    if (!cachedCustomerProfile) {
      try {
        cachedCustomerProfile = await getCustomerProfile();
      } catch {}
    }

    const rawNum = item.rawId || item.orderId.replace(/\D/g, '') || item.orderId;
    const user = getStoredUser();

    // Resolve Billing address strictly from billing sources
    const b = item.billing || cachedCustomerProfile?.billing || {};
    const bFirstName = b.firstName || cachedCustomerProfile?.firstName || user?.firstName || '';
    const bLastName = b.lastName || cachedCustomerProfile?.lastName || user?.lastName || '';
    const bFullName = (bFirstName || bLastName) ? `${bFirstName} ${bLastName}`.trim() : (user?.displayName || 'Customer');
    const bAddress1 = b.address1 || '';
    const bAddress2 = b.address2 || '';
    const bCity = b.city || '';
    const bPostcode = b.postcode || '';
    const bState = b.state || '';
    const bCountry = b.country || 'IN';
    const bEmail = b.email || cachedCustomerProfile?.email || user?.email || '';
    const bPhone = b.phone || cachedCustomerProfile?.phone || '';
    const hasBilling = Boolean(bAddress1 || bCity || bState || bPostcode);

    // Resolve Shipping address strictly from shipping sources (never copy from billing)
    const s = item.shipping || cachedCustomerProfile?.shipping || {};
    const sFirstName = s.firstName || '';
    const sLastName = s.lastName || '';
    const sFullName = (sFirstName || sLastName) ? `${sFirstName} ${sLastName}`.trim() : bFullName;
    const sAddress1 = s.address1 || '';
    const sAddress2 = s.address2 || '';
    const sCity = s.city || '';
    const sPostcode = s.postcode || '';
    const sState = s.state || '';
    const sCountry = s.country || 'IN';
    const sPhone = s.phone || '';
    const hasShipping = Boolean(sAddress1 || sCity || sState || sPostcode);

    const isCompleted = item.status === 'confirmed' || (item.statusLabel || '').toLowerCase() === 'completed';

    content.innerHTML = `
      <!-- 1. Top Order Status Line (Matches user screenshot) -->
      <p class="text-xs sm:text-sm text-[#082213] leading-relaxed">
        Order <span class="font-bold">#${rawNum}</span> was placed on <span class="font-bold">${item.date}</span> and is currently <span class="font-bold">${item.statusLabel}</span>.
      </p>

      <!-- 2. Order details Section -->
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-[#082213] tracking-tight mb-3">
          Order details
        </h2>

        <div class="border border-[#cbd5e1] rounded-xl overflow-hidden bg-white shadow-2xs">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-[#cbd5e1] bg-[#f8fafc]">
                <th class="py-3 px-4 font-bold text-[#082213]">Product</th>
                <th class="py-3 px-4 font-bold text-[#082213] text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e2e8f0]">
              ${item.itemsList.map(i => `
                <tr>
                  <td class="py-3 px-4">
                    <span class="text-[#0284c7] font-medium hover:underline cursor-pointer">${i.name}</span>
                    <span class="text-[#64748b]"> × ${i.qty}</span>
                  </td>
                  <td class="py-3 px-4 text-right font-medium text-[#082213]">
                    ${i.price}
                  </td>
                </tr>
              `).join('')}

              <!-- Subtotal -->
              <tr class="bg-white">
                <td class="py-3 px-4 font-bold text-[#082213]">Subtotal:</td>
                <td class="py-3 px-4 text-right font-medium text-[#082213]">${item.subtotal || item.price}</td>
              </tr>

              <!-- Discount (if any) -->
              ${item.discount ? `
                <tr class="bg-white">
                  <td class="py-3 px-4 font-bold text-[#082213]">Discount:</td>
                  <td class="py-3 px-4 text-right font-medium text-[#16a34a]">${item.discount}</td>
                </tr>
              ` : ''}

              <!-- Total -->
              <tr class="bg-white border-t border-[#e2e8f0]">
                <td class="py-3 px-4 font-bold text-[#082213]">Total:</td>
                <td class="py-3 px-4 text-right font-bold text-[#082213]">${item.price}</td>
              </tr>

              <!-- Customer Note (if any) -->
              ${item.customerNote ? `
                <tr class="bg-[#f8fafc]">
                  <td class="py-3 px-4 font-bold text-[#082213]">Note:</td>
                  <td class="py-3 px-4 text-right text-[#475569] italic">${item.customerNote}</td>
                </tr>
              ` : ''}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 3. Order again Button (Shown only when status is Completed) -->
      ${isCompleted ? `
        <div>
          <a
            href="/cart"
            class="inline-block px-4 py-2 rounded-lg border border-[#38bdf8] text-[#0284c7] hover:bg-[#f0f9ff] text-xs font-semibold transition cursor-pointer"
          >
            Order again
          </a>
        </div>
      ` : ''}

      <!-- 4. Customer Addresses Section (Billing & Shipping Addresses strictly separated) -->
      <div class="grid grid-cols-1 ${hasShipping ? 'sm:grid-cols-2' : ''} gap-4">
        <!-- Billing address Section -->
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#082213] tracking-tight mb-3">
            Billing address
          </h2>

          <div class="border border-[#cbd5e1] rounded-xl p-5 bg-white text-xs sm:text-sm text-[#475569] leading-relaxed space-y-1 shadow-2xs h-full">
            <p class="font-medium text-[#082213]">${bFullName}</p>
            ${bAddress1 ? `<p>${bAddress1}</p>` : ''}
            ${bAddress2 ? `<p>${bAddress2}</p>` : ''}
            ${(bCity || bPostcode) ? `<p>${bCity} ${bPostcode}</p>` : ''}
            ${bState ? `<p>${bState}</p>` : ''}
            ${bCountry ? `<p class="text-[11px] uppercase tracking-wider text-[#94a3b8]">${bCountry}</p>` : ''}
            ${!hasBilling ? `<p class="italic text-[#94a3b8]">No billing address </p>` : ''}
            ${bEmail ? `
              <p class="pt-2 flex items-center gap-1.5 text-[#082213]">
                <span>✉</span>
                <a href="mailto:${bEmail}" class="hover:underline text-[#0284c7]">${bEmail}</a>
              </p>
            ` : ''}
            ${bPhone ? `
              <p class="flex items-center gap-1.5 text-[#082213]">
                <span>📞</span>
                <span>${bPhone}</span>
              </p>
            ` : ''}
          </div>
        </div>

        <!-- Shipping address Section (Only if present, or if different) -->
        ${hasShipping ? `
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-[#082213] tracking-tight mb-3">
              Shipping address
            </h2>

            <div class="border border-[#cbd5e1] rounded-xl p-5 bg-white text-xs sm:text-sm text-[#475569] leading-relaxed space-y-1 shadow-2xs h-full">
              <p class="font-medium text-[#082213]">${sFullName}</p>
              ${sAddress1 ? `<p>${sAddress1}</p>` : ''}
              ${sAddress2 ? `<p>${sAddress2}</p>` : ''}
              ${(sCity || sPostcode) ? `<p>${sCity} ${sPostcode}</p>` : ''}
              ${sState ? `<p>${sState}</p>` : ''}
              ${sCountry ? `<p class="text-[11px] uppercase tracking-wider text-[#94a3b8]">${sCountry}</p>` : ''}
              ${sPhone ? `
                <p class="pt-2 flex items-center gap-1.5 text-[#082213]">
                  <span>📞</span>
                  <span>${sPhone}</span>
                </p>
              ` : ''}
            </div>
          </div>
        ` : ''}
      </div>
    `;

    modal.classList.remove('hidden');
  }

  async function syncWordPressOrders(isManual = false) {
    const stateLoading = document.getElementById('state-loading');
    const stateNotLoggedIn = document.getElementById('state-not-logged-in');
    const stateNoOrders = document.getElementById('state-no-orders');
    const ordersContainer = document.getElementById('orders-list-rows');
    const wpStatusDot = document.getElementById('wp-status-dot');
    const wpStatusText = document.getElementById('wp-status-text');
    const wpAuthAction = document.getElementById('wp-auth-action');

    const token = getStoredToken();
    const user = getStoredUser();

    // 1. Not Logged In handling (No dummy orders shown!)
    if (!token) {
      if (stateLoading) stateLoading.classList.add('hidden');
      if (ordersContainer) ordersContainer.classList.add('hidden');
      if (stateNoOrders) stateNoOrders.classList.add('hidden');
      if (stateNotLoggedIn) stateNotLoggedIn.classList.remove('hidden');

      if (wpStatusDot) {
        wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#f59e0b] inline-block';
      }
      if (wpStatusText) {
        wpStatusText.textContent = 'WordPress connected — Sign in to view your orders';
      }
      if (wpAuthAction) {
        wpAuthAction.innerHTML = `
          <a href="/login?redirect=/orders" class="text-[#0c3920] font-semibold hover:underline flex items-center gap-1">
            Sign In →
          </a>
        `;
      }

      ordersList = [];
      renderOrders();
      return;
    }

    // 2. Logged In: show loading spinner and user header
    if (stateNotLoggedIn) stateNotLoggedIn.classList.add('hidden');
    if (stateLoading) stateLoading.classList.remove('hidden');
    if (ordersContainer) ordersContainer.classList.add('hidden');
    if (stateNoOrders) stateNoOrders.classList.add('hidden');

    if (wpStatusDot) {
      wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#16a34a] inline-block animate-pulse';
    }
    
    

    try {
      // Concurrently fetch orders and backend customer address
      const [wpOrders, profile] = await Promise.all([
        getCustomerOrders().catch((err) => {
          console.error('[Orders Sync Error]', err);
          return null;
        }),
        getCustomerProfile().catch(() => null),
      ]);

      if (profile) {
        cachedCustomerProfile = profile;
      }

      if (wpOrders === null) {
        if (wpStatusText) {
          wpStatusText.textContent = 'Could not sync from WordPress — verify connection & sign in';
        }
        if (wpStatusDot) {
          wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#ef4444] inline-block';
        }
        if (ordersList.length === 0 && stateNoOrders) {
          stateNoOrders.classList.remove('hidden');
        }
      } else if (wpOrders.length === 0) {
        ordersList = [];
        renderOrders();
        if (stateNoOrders) stateNoOrders.classList.remove('hidden');
        if (ordersContainer) ordersContainer.classList.add('hidden');
        if (wpStatusText) {
          wpStatusText.textContent = 'Connected to WordPress (0 orders found for this account)';
        }
        if (wpStatusDot) {
          wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#16a34a] inline-block';
        }
      } else {
        ordersList = wpOrders.map((o) => {
          let mappedStatus: OrderData['status'] = 'in-transit';
          const s = (o.status || '').toLowerCase().trim();
          const labelLower = (o.statusLabel || '').toLowerCase().trim();
          let statusLabel = o.statusLabel || (o.status ? o.status.charAt(0).toUpperCase() + o.status.slice(1) : 'Processing');

          if (s === 'completed' || s === 'delivered' || s === 'confirmed') {
            mappedStatus = 'confirmed';
            statusLabel = 'Completed';
          } else if (s === 'pending' || s === 'pending-payment' || s === 'pending payment' || s.includes('pending') || labelLower.includes('pending')) {
            mappedStatus = 'pending';
            statusLabel = 'Pending payment';
          } else if (s === 'on-hold' || s === 'onhold' || s === 'on hold' || labelLower.includes('on hold')) {
            mappedStatus = 'on-hold';
            statusLabel = 'On hold';
          } else if (s === 'processing') {
            mappedStatus = 'pre-order';
            statusLabel = 'Processing';
          } else if (s === 'cancelled') {
            mappedStatus = 'cancelled';
            statusLabel = 'Cancelled';
          } else if (s === 'refunded') {
            mappedStatus = 'refunded';
            statusLabel = 'Refunded';
          } else if (s === 'failed') {
            mappedStatus = 'failed';
            statusLabel = 'Failed';
          } else {
            mappedStatus = 'in-transit';
            statusLabel = o.statusLabel || 'In Transit';
          }

          const dateStr = o.dateCreated
            ? new Date(o.dateCreated).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })
            : 'Recent';

          const items = o.items && o.items.length > 0 ? o.items : [];

          return {
            rawId: o.id,
            orderId: `#${o.orderNumber || o.id}`,
            date: dateStr,
            price: o.total || `₹${o.rawTotal || '0.00'}`,
            subtotal: o.subtotal,
            discount: o.discount,
            customerNote: o.customerNote,
            status: mappedStatus,
            statusLabel: statusLabel,
            itemsSummary: items.length > 0 ? items.map((i) => i.name).join(', ') : 'Natural Wellness Products',
            itemsList: items.length > 0
              ? items.map((i) => ({
                  name: i.name,
                  qty: i.quantity || 1,
                  price: i.subtotal || `₹${(parseFloat(o.rawTotal || '0') / (items.length || 1)).toFixed(2)}`,
                }))
              : [{ name: 'Natural Wellness Product', qty: 1, price: o.total || '₹0.00' }],
            awbNumber: `WP-${o.id}`,
            isLive: true,
            source: 'WooCommerce',
            paymentMethod: o.paymentMethod || 'Online Payment',
            shippingAddress: o.shippingAddress || '',
            billingAddress: o.billingAddress || '',
            billing: o.billing || profile?.billing || null,
            shipping: o.shipping || profile?.shipping || null,
          };
        });

        if (stateNoOrders) stateNoOrders.classList.add('hidden');
        if (ordersContainer) ordersContainer.classList.remove('hidden');
        renderOrders();

     
      }

      if (wpStatusDot) {
        wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#16a34a] inline-block';
      }
    } catch (err) {
      console.error('Error syncing WordPress orders:', err);
      if (wpStatusText) {
        wpStatusText.textContent = 'Could not sync orders from WordPress';
      }
      if (wpStatusDot) {
        wpStatusDot.className = 'w-2 h-2 rounded-full bg-[#ef4444] inline-block';
      }
      if (ordersList.length === 0 && stateNoOrders) {
        stateNoOrders.classList.remove('hidden');
      }
    } finally {
      // Guarantee loading state is removed in all paths!
      if (stateLoading) {
        stateLoading.classList.add('hidden');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    // 1. Initial sync from WordPress
    await syncWordPressOrders();

    // 2. Search input listener
    const searchInput = document.getElementById('order-search') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        renderOrders();
      });
    }

    // 3. Reset filters button listener
    const resetBtn = document.getElementById('btn-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        filterStatus = 'all';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        renderOrders();
      });
    }

    // 4. Modal close handlers
    const modal = document.getElementById('modal-order-details');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnCloseModalFooter = document.getElementById('btn-close-modal-footer');

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
    if (btnCloseModalFooter) btnCloseModalFooter.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // 5. Escape key to close modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });


    // 7. Auto-refresh when tab gains focus or user switches back from WooCommerce
    window.addEventListener('focus', () => {
      syncWordPressOrders();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        syncWordPressOrders();
      }
    });

    // 8. Background live polling every 25 seconds
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        syncWordPressOrders();
      }
    }, 25000);

    // 9. Auth state change listener (when login/logout happens)
    window.addEventListener('auth:state-change', () => {
      syncWordPressOrders();
    });
  });
</script>
