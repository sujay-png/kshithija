---
// src/pages/product/index.astro - Redirect /product to /products
const targetUrl = '/products';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/products" />
    <link rel="canonical" href="https://kshithija.in/products" />
    <script is:inline>
      window.location.replace('/products');
    </script>
    <title>Redirecting to /products...</title>
  </head>
  <body>
    <p>Redirecting to <a href="/products">/products</a>...</p>
  </body>
</html>
