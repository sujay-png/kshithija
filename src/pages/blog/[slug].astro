---
// src/pages/blog/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getBlogSeo } from '../../data/seo';
import {
  getAllPosts,
  getFeaturedImage,
  getAuthorName,
  getPostCategories,
  formatDate,
  estimateReadTime,
  stripHtml,
  sanitizeBlogContent,
  type WPPost,
} from '../../lib/wordpress';
import { getProducts, type Product } from '../../lib/products';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: WPPost;
  allPosts: WPPost[];
}

const { post, allPosts } = Astro.props;

const img = getFeaturedImage(post);
const date = formatDate(post.date);
const read = estimateReadTime(post.content?.rendered || post.excerpt?.rendered || '');
const author = getAuthorName(post);
const cats = getPostCategories(post);
const title = stripHtml(post.title.rendered);
const excerpt = stripHtml(post.excerpt?.rendered || '');

// Related posts (excluding current)
const relatedPosts = (allPosts || [])
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);

// Products Catalogue for Right Sidebar (3-4 products)
const allProducts = await getProducts();
const fullText = `${title} ${excerpt} ${post.content?.rendered || ''}`.toLowerCase();

function pickSidebarProducts(products: Product[], text: string): Product[] {
  const inStock = products.filter((p) => p.inStock !== false && p.badge !== 'Sold Out');
  const scored = inStock.map((prod) => {
    let score = 0;
    const pid = prod.id.toLowerCase();
    const pname = prod.name.toLowerCase();

    if (text.includes('hair') || text.includes('dandruff') || text.includes('scalp')) {
      if (pid.includes('grow-hair') || pid.includes('anti-dandruff') || pname.includes('hair')) score += 20;
    }
    if (text.includes('skin') || text.includes('moistur') || text.includes('cream') || text.includes('dry skin') || text.includes('aloe') || text.includes('face') || text.includes('tan')) {
      if (pid.includes('vishaka') || pid.includes('aloe') || pid.includes('vasel') || pname.includes('cream')) score += 20;
    }
    if (text.includes('energy') || text.includes('sugar') || text.includes('supplement') || text.includes('wellness') || text.includes('health') || text.includes('honey')) {
      if (pid.includes('chaithanya') || pid.includes('honey')) score += 20;
    }
    if (prod.featured) score += 3;
    if (prod.onSale) score += 2;
    return { prod, score };
  });

  scored.sort((a, b) => b.score - a.score);
  const picked = scored.slice(0, 4).map((s) => s.prod);
  return picked.length >= 3 ? picked : inStock.slice(0, 4);
}

const sidebarProducts = pickSidebarProducts(allProducts, fullText);

// WhatsApp Share URL
const pageUrl = `https://kshithija.in/blog/${post.slug}`;
const shareText = encodeURIComponent(`Read this article: ${title} on Kshithija Enterprises: ${pageUrl}`);
const waShareUrl = `https://wa.me/?text=${shareText}`;
const blogSeo = getBlogSeo({
  slug: post.slug,
  title,
  excerpt,
  image: img,
  date: post.date,
  author,
});
---

<Layout {...blogSeo}>

  <!-- Article Header & Breadcrumbs -->
  <header class="w-full bg-white pt-8 sm:pt-12 pb-6 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf]">
    <div class="max-w-4xl mx-auto">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-[#5a6e61]">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" class="hover:text-[#0c3920] transition-colors">Home</a>
          </li>
          <li class="text-[#98a89e]">/</li>
          <li>
            <a href="/blog" class="hover:text-[#0c3920] transition-colors">Blog</a>
          </li>
          <li class="text-[#98a89e]">/</li>
          <li class="font-semibold text-[#082213] truncate max-w-xs sm:max-w-md" aria-current="page">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Category & Meta -->
      <div class="flex items-center gap-3 text-xs text-[#5a6e61] mb-4 flex-wrap">
        {cats.map((c) => (
          <span class="inline-block px-3 py-1 rounded-full bg-[#eaf4ed] text-[#1c643b] text-xs font-semibold tracking-wider uppercase">
            {c.name}
          </span>
        ))}
        <span>Published on {date}</span>
        <span>·</span>
        <span>{read}</span>
      </div>

      <!-- Main Article Headline -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-serif font-bold text-[#082213] leading-tight tracking-tight mb-6">
        {title}
      </h1>


    </div>
  </header>

  <!-- Article Body Content & Right Sidebar Product Catalogue -->
  <article class="w-full bg-white py-10 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- Main Blog Post Column (8 Columns on desktop) -->
        <main class="lg:col-span-8 bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-[#e8dfcf] shadow-xs">
          <!-- Rendered HTML Content with elegant typography -->
          <div 
            class="blog-content prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-[#082213] prose-p:text-[#384a3e] prose-p:leading-relaxed prose-a:text-[#164e2d] prose-a:underline hover:prose-a:text-[#082213] prose-img:rounded-2xl prose-img:shadow-sm text-sm sm:text-base leading-relaxed space-y-5"
            set:html={sanitizeBlogContent(post.content.rendered)}
          />
        </main>

        <!-- Right Side: 3-4 Product Catalogue Sidebar with Buy Now CTA (4 Columns on desktop, Sticky) -->
        <aside class="lg:col-span-4 lg:sticky lg:top-24 space-y-5">
          
  

          <!-- Product Catalogue Cards List (3-4 products) -->
          <div class="space-y-3.5">
            {sidebarProducts.map((prod) => (
              <div class="bg-white rounded-2xl border border-[#ded5c5] p-4 shadow-2xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
                
                <div class="flex gap-3.5 items-start mb-3">
                  <!-- Product Image with Link -->
                  <a
                    href={`/product/${prod.id}`}
                    class="block w-20 h-20 sm:w-22 sm:h-22 rounded-xl overflow-hidden bg-[#faf7f2] border border-[#e8dfcf] shrink-0 relative group-hover:border-[#1c643b] transition-colors"
                    aria-label={`View ${prod.name}`}
                  >
                    <img
                      src={prod.image}
                      alt={prod.name}
                      loading="lazy"
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                      onerror={prod.fallbackImage ? `if(this.src !== '${prod.fallbackImage}') { this.src = '${prod.fallbackImage}'; }` : undefined}
                    />
                    {prod.badge && (
                      <span class="absolute top-1 left-1 bg-[#858012] text-white text-[9px] font-bold px-1.5 py-0.5 rounded-sm shadow-xs uppercase">
                        {prod.badge}
                      </span>
                    )}
                  </a>

                  <!-- Product Details -->
                  <div class="flex-1 min-w-0">
                    <span class="text-[10px] font-bold text-[#1c643b] uppercase tracking-wider block mb-0.5">
                      {prod.category || 'Ayurvedic Care'}
                    </span>
                    <a href={`/product/${prod.id}`} class="block">
                      <h4 class="text-xs sm:text-sm font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug line-clamp-2">
                        {prod.name}
                      </h4>
                    </a>
                    
                    <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                      <span class="text-sm font-bold text-[#082213] font-sans">
                        {prod.price}
                      </span>
                      {prod.originalPrice && prod.onSale && (
                        <span class="text-xs text-gray-400 line-through">
                          {prod.originalPrice}
                        </span>
                      )}
                      {prod.size && (
                        <span class="text-[10px] bg-[#f4ede0] text-[#55695b] px-1.5 py-0.5 rounded font-medium">
                          {prod.size}
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Buy Now CTA & Add to Cart Action Bar -->
                <div class="pt-3 border-t border-[#f0eae0] flex items-center gap-2">
                  <!-- Primary Buy Now CTA Button (Adds to cart & proceeds straight to /checkout) -->
                  <button
                    type="button"
                    data-buy-now
                    data-product-id={prod.id}
                    data-product-name={prod.name}
                    data-product-price={prod.price}
                    data-product-image={prod.image}
                    class="flex-1 py-2 px-3 rounded-xl bg-[#0c3920] hover:bg-[#15502e] active:scale-98 text-white text-xs font-bold tracking-wide uppercase shadow-xs hover:shadow-md transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                  >
                    <span>⚡</span>
                    <span class="btn-label">Buy Now</span>
                  </button>

                  <!-- Add to Cart (Quick Bag button to open slide drawer) -->
                  <button
                    type="button"
                    data-add-to-cart
                    data-product-id={prod.id}
                    data-product-name={prod.name}
                    data-product-price={prod.price}
                    data-product-image={prod.image}
                    class="p-2 rounded-xl bg-[#f4ede0] hover:bg-[#eae0cf] text-[#082213] border border-[#ded5c5] transition-colors cursor-pointer"
                    title="Add to Cart"
                    aria-label={`Add ${prod.name} to cart`}
                  >
                    <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                  </button>

                  <!-- View Product Link -->
                  <a
                    href={`/product/${prod.id}`}
                    class="py-2 px-2.5 rounded-xl bg-white hover:bg-[#faf7f2] text-[#082213] border border-[#ded5c5] text-xs font-semibold transition-colors text-center"
                    title={`View ${prod.name}`}
                  >
                    View
                  </a>
                </div>

              </div>
            ))}
          </div>

          <!-- Trust Badges Sidebar Card -->
          <div class="p-4 rounded-2xl bg-white border border-[#ded5c5] text-xs text-[#3e5044] space-y-2 shadow-2xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#0c3920] block mb-1">
              Why Choose Kshithija
            </span>
            <div class="flex items-center gap-2">
              <span class="text-[#1c643b] font-bold">✓</span>
              <span>100% Pure Botanical Ingredients</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#1c643b] font-bold">✓</span>
              <span>Direct Dispatch from Mangaluru</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#1c643b] font-bold">✓</span>
              <span>Online Payment & COD Available</span>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </article>

  <!-- Related Articles Grid -->
  {relatedPosts.length > 0 && (
    <section class="w-full bg-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-t border-[#e8dfcf]">
      <div class="max-w-7xl mx-auto">
        
        <div class="flex items-center justify-between mb-8 sm:mb-10">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#1c643b] block mb-1">
              Further Reading
            </span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#082213]">
              Related Skincare & Herbal Guides
            </h2>
          </div>
          <a
            href="/blog"
            class="text-xs sm:text-sm font-semibold text-[#0c3920] hover:underline"
          >
            View All Blogs →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {relatedPosts.map((rel) => {
            const relImg = getFeaturedImage(rel);
            const relDate = formatDate(rel.date);
            const relRead = estimateReadTime(rel.content?.rendered || rel.excerpt?.rendered || '');
            const relTitle = stripHtml(rel.title.rendered);
            const relExcerpt = stripHtml(rel.excerpt.rendered);

            return (
              <a
                href={`/blog/${rel.slug}`}
                class="group bg-white rounded-3xl overflow-hidden border border-[#e8dfcf] shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
              >
                <div>
                  <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#faf7f2]">
                    <img
                      src={relImg.src}
                      alt={relImg.alt}
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-5 sm:p-6">
                    <div class="text-[11px] text-[#6d7e73] mb-2">
                      <span>{relDate} · {relRead}</span>
                    </div>
                    <h3 class="text-base font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug line-clamp-2 mb-2">
                      {relTitle}
                    </h3>
                    <p class="text-xs text-[#526357] leading-relaxed line-clamp-2">
                      {relExcerpt}
                    </p>
                  </div>
                </div>
                <div class="px-5 sm:px-6 pb-5 pt-1 text-xs font-bold text-[#164e2d] group-hover:underline">
                  Read Article →
                </div>
              </a>
            );
          })}
        </div>

      </div>
    </section>
  )}

</Layout>

<style is:global>
  /* Blog Prose Enhancements */
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #082213;
  }
  .blog-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #082213;
  }
  .blog-content p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: #3e5044;
  }
  .blog-content ul, .blog-content ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    list-style-type: disc;
    color: #3e5044;
  }
  .blog-content li {
    margin-bottom: 0.35rem;
  }
  .blog-content img {
    border-radius: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
    height: auto;
  }

  /* CRITICAL: Constrain all WordPress & Elementor SVGs to prevent giant icon blowups */
  .blog-content svg,
  .blog-content .e-font-icon-svg,
  .blog-content .fa-toggle,
  .blog-content .elementor-accordion-icon svg {
    width: 14px !important;
    height: 14px !important;
    max-width: 16px !important;
    max-height: 16px !important;
    min-width: 0 !important;
    min-height: 0 !important;
    display: inline-block !important;
    vertical-align: middle !important;
    flex-shrink: 0 !important;
  }

  /* Details & Summary reset to remove browser default markers */
  .blog-content details summary {
    list-style: none !important;
  }
  .blog-content details summary::-webkit-details-marker,
  .blog-content details summary::marker {
    display: none !important;
  }

  /* ==========================================================================
     High-End Botanical FAQ Accordion Styling for Blog Posts
     ========================================================================== */
  .blog-content .elementor-accordion,
  .blog-content .eael-adv-accordion,
  .blog-content .elementor-toggle,
  .blog-content .e-n-accordion {
    margin-top: 2rem !important;
    margin-bottom: 2.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.85rem !important;
  }

  .blog-content .elementor-accordion-item,
  .blog-content .eael-accordion-list,
  .blog-content .elementor-toggle-item,
  .blog-content .e-n-accordion-item {
    border: 1px solid #e8dfcf !important;
    border-radius: 1.25rem !important;
    background-color: #fcfaf6 !important;
    overflow: hidden !important;
    box-shadow: 0 1px 3px rgba(8, 34, 19, 0.03) !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .blog-content .elementor-accordion-item:hover,
  .blog-content .eael-accordion-list:hover,
  .blog-content .elementor-toggle-item:hover,
  .blog-content .e-n-accordion-item:hover {
    border-color: #c2dfcb !important;
    box-shadow: 0 4px 14px rgba(22, 78, 45, 0.07) !important;
  }

  .blog-content .elementor-tab-title,
  .blog-content .eael-accordion-header,
  .blog-content .e-n-accordion-item-title {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 1.125rem 1.5rem !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
    color: #082213 !important;
    background-color: #faf7f2 !important;
    cursor: pointer !important;
    user-select: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
    gap: 1rem !important;
    border-bottom: 1px solid transparent !important;
    outline: none !important;
  }

  .blog-content .elementor-tab-title:hover,
  .blog-content .eael-accordion-header:hover,
  .blog-content .e-n-accordion-item-title:hover {
    background-color: #f2ece1 !important;
    color: #164e2d !important;
  }

  .blog-content .elementor-tab-title.is-active,
  .blog-content .elementor-tab-title.elementor-active,
  .blog-content .eael-accordion-header.is-active,
  .blog-content .eael-accordion-header.eael-active,
  .blog-content .e-n-accordion-item[open] > .e-n-accordion-item-title {
    background-color: #eaf4ed !important;
    color: #164e2d !important;
    border-bottom: 1px solid #d1e7d8 !important;
  }

  /* Question title typography */
  .blog-content .eael-accordion-tab-title,
  .blog-content .elementor-accordion-title,
  .blog-content .e-n-accordion-item-title-header,
  .blog-content .e-n-accordion-item-title-text {
    font-family: inherit !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    line-height: 1.5 !important;
    color: inherit !important;
    flex: 1 !important;
    margin: 0 !important;
    display: block !important;
  }

  /* Elementor nested accordion icons */
  .blog-content .e-n-accordion-item-title-icon {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 28px !important;
    height: 28px !important;
    border-radius: 9999px !important;
    background: rgba(22, 78, 45, 0.08) !important;
    color: #164e2d !important;
    flex-shrink: 0 !important;
    margin-left: 0.75rem !important;
  }

  /* Hide / Show opened and closed icons appropriately */
  .blog-content .e-n-accordion-item:not([open]) .e-opened {
    display: none !important;
  }
  .blog-content .e-n-accordion-item:not([open]) .e-closed {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .blog-content .e-n-accordion-item[open] .e-opened {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .blog-content .e-n-accordion-item[open] .e-closed {
    display: none !important;
  }

  /* Chevron toggle icon with smooth rotation for standard SVGs */
  .blog-content .elementor-tab-title svg,
  .blog-content .eael-accordion-header svg,
  .blog-content .e-n-accordion-item-title svg {
    width: 14px !important;
    height: 14px !important;
    max-width: 14px !important;
    max-height: 14px !important;
    flex-shrink: 0 !important;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    color: #164e2d !important;
    fill: currentColor !important;
  }

  .blog-content .elementor-tab-title.is-active svg,
  .blog-content .elementor-tab-title.elementor-active svg,
  .blog-content .eael-accordion-header.is-active svg,
  .blog-content .eael-accordion-header.eael-active svg {
    transform: rotate(90deg) !important;
  }

  /* Accordion Content Panel */
  .blog-content .elementor-tab-content,
  .blog-content .eael-accordion-content,
  .blog-content .e-n-accordion-item > :not(summary) {
    padding: 1.25rem 1.5rem !important;
    background-color: #ffffff !important;
    font-size: 0.925rem !important;
    line-height: 1.75 !important;
    color: #384a3e !important;
  }

  .blog-content .elementor-tab-content,
  .blog-content .eael-accordion-content {
    display: none;
    animation: accordionFadeIn 0.25s ease-out;
  }

  .blog-content .e-n-accordion-item[open] > :not(summary) {
    animation: accordionFadeIn 0.25s ease-out;
  }

  .blog-content .elementor-tab-content.is-active,
  .blog-content .eael-accordion-content.is-active {
    display: block !important;
  }

  .blog-content .elementor-tab-content p,
  .blog-content .eael-accordion-content p,
  .blog-content .e-n-accordion-item > :not(summary) p {
    margin-bottom: 0.75rem !important;
    color: #384a3e !important;
  }

  .blog-content .elementor-tab-content p:last-child,
  .blog-content .eael-accordion-content p:last-child,
  .blog-content .e-n-accordion-item > :not(summary) p:last-child {
    margin-bottom: 0 !important;
  }

  @keyframes accordionFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<!-- Interactive Accordion Handler for Elementor & Essential Addons FAQs -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    function initBlogAccordions() {
      const container = document.querySelector('.blog-content');
      if (!container) return;

      // 1. Handle Elementor Nested Accordions (details / summary)
      const nestedAccordions = container.querySelectorAll('.e-n-accordion');
      nestedAccordions.forEach((acc) => {
        const detailsList = acc.querySelectorAll('details.e-n-accordion-item');
        detailsList.forEach((details) => {
          details.addEventListener('toggle', () => {
            if (details.open) {
              detailsList.forEach((other) => {
                if (other !== details && other.open) {
                  other.removeAttribute('open');
                }
              });
            }
          });
        });
      });

      // 2. Handle Classic Elementor, Essential Addons & Toggle Accordions
      const accordions = container.querySelectorAll('.elementor-accordion, .eael-adv-accordion, .elementor-toggle');

      accordions.forEach((acc) => {
        const items = acc.querySelectorAll('.elementor-accordion-item, .eael-accordion-list, .elementor-toggle-item');

        items.forEach((item, index) => {
          const header = item.querySelector('.elementor-tab-title, .eael-accordion-header');
          const content = item.querySelector('.elementor-tab-content, .eael-accordion-content');

          if (!header || !content) return;

          header.setAttribute('role', 'button');
          header.setAttribute('tabindex', '0');

          // Open first FAQ by default or keep initially marked active items open
          const isInitialActive = header.classList.contains('elementor-active') || header.classList.contains('eael-active') || index === 0;

          if (isInitialActive) {
            header.classList.add('is-active', 'elementor-active', 'eael-active');
            item.classList.add('is-active');
            content.classList.add('is-active');
            content.style.display = 'block';
            header.setAttribute('aria-expanded', 'true');
          } else {
            header.classList.remove('is-active', 'elementor-active', 'eael-active');
            item.classList.remove('is-active');
            content.classList.remove('is-active');
            content.style.display = 'none';
            header.setAttribute('aria-expanded', 'false');
          }

          function toggleItem(e) {
            if (e) e.preventDefault();
            const isOpen = content.style.display === 'block';

            // Close sibling items within the same accordion
            items.forEach((siblingItem) => {
              if (siblingItem !== item) {
                const sHeader = siblingItem.querySelector('.elementor-tab-title, .eael-accordion-header');
                const sContent = siblingItem.querySelector('.elementor-tab-content, .eael-accordion-content');
                if (sHeader && sContent) {
                  sHeader.classList.remove('is-active', 'elementor-active', 'eael-active');
                  siblingItem.classList.remove('is-active');
                  sContent.classList.remove('is-active');
                  sContent.style.display = 'none';
                  sHeader.setAttribute('aria-expanded', 'false');
                }
              }
            });

            // Toggle selected item
            if (isOpen) {
              header.classList.remove('is-active', 'elementor-active', 'eael-active');
              item.classList.remove('is-active');
              content.classList.remove('is-active');
              content.style.display = 'none';
              header.setAttribute('aria-expanded', 'false');
            } else {
              header.classList.add('is-active', 'elementor-active', 'eael-active');
              item.classList.add('is-active');
              content.classList.add('is-active');
              content.style.display = 'block';
              header.setAttribute('aria-expanded', 'true');
            }
          }

          header.addEventListener('click', toggleItem);
          header.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              toggleItem(e);
            }
          });
        });
      });
    }

    initBlogAccordions();

    // Buy Now CTA Handler (Adds to KshithijaCart & immediately proceeds to checkout)
    const buyNowBtns = document.querySelectorAll('[data-buy-now]');
    buyNowBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-product-id');
        const name = btn.getAttribute('data-product-name');
        const price = btn.getAttribute('data-product-price');
        const image = btn.getAttribute('data-product-image');

        if (window.KshithijaCart && id && name) {
          // Visual feedback
          const label = btn.querySelector('.btn-label') || btn;
          label.textContent = 'Proceeding...';
          btn.classList.add('opacity-85', 'pointer-events-none');

          window.KshithijaCart.addItem({
            id,
            name,
            price: price || '₹349',
            image: image || '',
            quantity: 1,
          });

          // Navigate directly to checkout
          setTimeout(() => {
            window.location.href = '/checkout';
          }, 120);
        } else if (id) {
          window.location.href = `/product/${id}`;
        }
      });
    });
  });
</script>
