---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import {
  getAllPosts,
  getFeaturedImage,
  getAuthorName,
  getPostCategories,
  formatDate,
  estimateReadTime,
  stripHtml,
} from '../../lib/wordpress';

const allPosts = await getAllPosts();

// Assign category tags to posts for client-side filtering
const posts = allPosts.map((p) => {
  const title = (p.title?.rendered || '').toLowerCase();
  const excerpt = (p.excerpt?.rendered || '').toLowerCase();
  let topic = 'skincare';
  let topicLabel = 'Skincare & Barrier';

  if (title.includes('hair') || title.includes('scalp') || excerpt.includes('hair') || excerpt.includes('scalp')) {
    topic = 'haircare';
    topicLabel = 'Hair & Scalp';
  } else if (
    title.includes('energy') ||
    title.includes('supplement') ||
    title.includes('health') ||
    title.includes('wellness') ||
    title.includes('plant-based')
  ) {
    topic = 'wellness';
    topicLabel = 'Wellness & Energy';
  } else if (title.includes('tan') || title.includes('sun') || title.includes('uv') || excerpt.includes('tanning')) {
    topic = 'suncare';
    topicLabel = 'Sun & Coastal Care';
  }

  return {
    ...p,
    topic,
    topicLabel,
  };
});

const heroPost = posts[0];
const trendingPosts = posts.slice(1, 3);
const catalogPosts = posts.slice(3);
---

<Layout title="Botanical Journal & Natural Skincare Wisdom - Kshithija Enterprises">
  
  <!-- Editorial Magazine Header -->
  <section class="relative w-full bg-white pt-12 sm:pt-16 pb-12 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf] overflow-hidden">
    <!-- Ambient Botanical Watermark Leaf -->
    <div class="absolute -right-16 -top-16 w-80 h-80 opacity-5 pointer-events-none select-none text-[#082213]">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
      </svg>
    </div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="inline-flex items-center justify-center gap-2 text-xs text-[#5a6e61]">
          <li>
            <a href="/" class="hover:text-[#0c3920] transition-colors">Home</a>
          </li>
          <li class="text-[#a4b5aa]">/</li>
          <li class="font-semibold text-[#082213] tracking-wide" aria-current="page">Journal</li>
        </ol>
      </nav>

    </div>
  </section>

  <!-- Main Content Showcase -->
  <section class="relative w-full bg-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf]">
    <div class="max-w-7xl mx-auto">
      
      <!-- Top Bento Section: Featured Hero Article + 2 Trending Reads (Visible on 'all' filter) -->
      <div id="featured-bento-section" class="mb-14 sm:mb-18">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#1c643b] animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-[#1c643b]">
              Editor's Essential Selection
            </span>
          </div>
          <span class="text-xs text-[#6e8074]">Updated Daily from Mangaluru</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          
          <!-- Left 7 Cols: Large Featured Hero Story -->
          {heroPost && (() => {
            const hImg = getFeaturedImage(heroPost);
            const hDate = formatDate(heroPost.date);
            const hRead = estimateReadTime(heroPost.content?.rendered || heroPost.excerpt?.rendered || '');
            const hAuthor = getAuthorName(heroPost);
            const hTitle = stripHtml(heroPost.title.rendered);
            const hExcerpt = stripHtml(heroPost.excerpt.rendered);

            return (
              <article class="lg:col-span-7 bg-white rounded-[28px] overflow-hidden border border-[#e8dfcf] shadow-md hover:shadow-2xl transition-all duration-500 flex flex-col justify-between group">
                <!-- Large Top Image with Zoom -->
                <a 
                  href={`/blog/${heroPost.slug}`} 
                  class="block relative w-full aspect-[16/10] overflow-hidden bg-[#faf7f2] cursor-pointer"
                >
                  <img
                    src={hImg.src}
                    alt={hImg.alt}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                    loading="eager"
                  />
                  <!-- Floating Badges -->
                  <div class="absolute top-4 left-4 flex items-center gap-2">
                    <span class="bg-[#082213] text-white text-[11px] font-bold tracking-wide uppercase px-3 py-1 rounded-full shadow-md">
                      ★ Featured Story
                    </span>
                    <span class="bg-white/95 backdrop-blur-xs text-[#1c643b] text-[11px] font-bold tracking-wide px-3 py-1 rounded-full shadow-xs border border-white/40">
                      {heroPost.topicLabel}
                    </span>
                  </div>
                  <span class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-xs text-white text-[11px] font-medium px-2.5 py-1 rounded-md">
                    ⏱ {hRead}
                  </span>
                </a>

                <!-- Content Area -->
                <div class="p-6 sm:p-8 lg:p-9 flex flex-col justify-between flex-1">
                  <div>
                    <div class="flex items-center gap-3 text-xs text-[#5a6e61] mb-2.5">
                      <span>📅 {hDate}</span>
                      <span>·</span>
                      <span>By {hAuthor}</span>
                    </div>

                    <a href={`/blog/${heroPost.slug}`} class="block">
                      <h2 class="text-xl sm:text-2xl lg:text-[28px] font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug tracking-tight mb-3">
                        {hTitle}
                      </h2>
                    </a>

                    <p class="text-xs sm:text-sm text-[#4d5e52] leading-relaxed line-clamp-3 mb-6 font-normal">
                      {hExcerpt}
                    </p>
                  </div>

                  <div class="pt-5 border-t border-[#f0eae0] flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-full bg-[#1c643b]/10 text-[#1c643b] flex items-center justify-center text-xs font-bold font-serif">
                        KE
                      </div>
                      <span class="text-xs text-[#384a3e] font-medium">Kshithija Research Team</span>
                    </div>
                    
                    <a
                      href={`/blog/${heroPost.slug}`}
                      class="inline-flex items-center gap-1.5 text-xs font-bold text-[#164e2d] hover:text-[#082213] transition-colors group-hover:translate-x-1 duration-200"
                    >
                      <span>Read Story</span>
                      <span class="text-sm">→</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })()}

          <!-- Right 5 Cols: 2 Stacked Trending Stories -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            {trendingPosts.map((trend, idx) => {
              const tImg = getFeaturedImage(trend);
              const tDate = formatDate(trend.date);
              const tRead = estimateReadTime(trend.content?.rendered || trend.excerpt?.rendered || '');
              const tTitle = stripHtml(trend.title.rendered);
              const tExcerpt = stripHtml(trend.excerpt.rendered);

              return (
                <article class="bg-white rounded-[24px] overflow-hidden border border-[#e8dfcf] p-5 sm:p-6 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between flex-1 group hover:-translate-y-1">
                  <div>
                    <div class="flex items-start gap-4 mb-3">
                      <!-- Thumbnail with Zoom -->
                      <a 
                        href={`/blog/${trend.slug}`}
                        class="block shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden bg-[#faf7f2] relative cursor-pointer"
                      >
                        <img
                          src={tImg.src}
                          alt={tImg.alt}
                          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </a>

                      <!-- Header info -->
                      <div class="flex-1 min-w-0">
                        <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#1c643b] mb-1">
                          #{idx + 1} Trending Guide
                        </span>
                        <div class="text-[11px] text-[#6d7e73] mb-1">
                          {tDate} · {tRead}
                        </div>
                        <a href={`/blog/${trend.slug}`} class="block">
                          <h3 class="text-sm sm:text-base font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug line-clamp-2">
                            {tTitle}
                          </h3>
                        </a>
                      </div>
                    </div>

                    <p class="text-xs text-[#526357] leading-relaxed line-clamp-2 mb-2 font-normal">
                      {tExcerpt}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-[#f0eae0] flex items-center justify-between">
                    <span class="text-[11px] text-[#708477]">Recommended Read</span>
                    <a
                      href={`/blog/${trend.slug}`}
                      class="text-xs font-bold text-[#164e2d] hover:text-[#082213] inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
                    >
                      <span>Read Guide</span>
                      <span>→</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>

        </div>
      </div>


      <!-- Main Filterable Cards Grid -->
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#1c643b] block mb-1">
              Curated Knowledge Base
            </span>
            <h2 id="grid-heading" class="text-2xl sm:text-3xl font-serif font-bold text-[#082213]">
              All Skincare & Formulation Guides
            </h2>
          </div>
          <div id="articles-count-badge" class="text-xs font-semibold text-[#5a6e61] bg-white border border-[#ded5c5] px-3.5 py-1.5 rounded-full shadow-2xs self-start sm:self-auto">
            Showing all {posts.length} articles
          </div>
        </div>

        <!-- 3-Column Responsive Cards Grid -->
        <div 
          id="blogs-grid-container"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch"
        >
          {posts.map((post) => {
            const img = getFeaturedImage(post);
            const date = formatDate(post.date);
            const read = estimateReadTime(post.content?.rendered || post.excerpt?.rendered || '');
            const title = stripHtml(post.title.rendered);
            const excerpt = stripHtml(post.excerpt.rendered);

            const shareUrl = encodeURIComponent(`https://kshithija.in/blog/${post.slug}`);
            const waShare = `https://wa.me/?text=${encodeURIComponent(`Check out this guide: ${title}`)}%20${shareUrl}`;

            return (
              <article 
                data-blog-card
                data-topic={post.topic}
                data-title={title.toLowerCase()}
                data-excerpt={excerpt.toLowerCase()}
                class="blog-card bg-white rounded-[26px] overflow-hidden border border-[#e8dfcf] shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5"
              >
                <div>
                  <!-- Card Image -->
                  <a 
                    href={`/blog/${post.slug}`}
                    class="block relative w-full aspect-[16/10] overflow-hidden bg-[#faf7f2] cursor-pointer"
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <!-- Floating Category Badge -->
                    <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-xs text-[#082213] text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-black/5 shadow-2xs">
                      {post.topicLabel}
                    </span>
                    <!-- Reading Time -->
                    <span class="absolute top-3 right-3 bg-black/60 backdrop-blur-xs text-white text-[10px] font-medium px-2 py-0.5 rounded-md">
                      ⏱ {read}
                    </span>
                  </a>

                  <!-- Card Body -->
                  <div class="p-5 sm:p-6">
                    <div class="text-[11px] text-[#6d7e73] mb-2 font-medium">
                      <span>{date}</span>
                    </div>

                    <a href={`/blog/${post.slug}`} class="block">
                      <h3 class="text-base sm:text-lg font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug line-clamp-2 min-h-[48px] mb-2.5">
                        {title}
                      </h3>
                    </a>

                    <p class="text-xs text-[#526357] leading-relaxed line-clamp-3 font-normal">
                      {excerpt}
                    </p>
                  </div>
                </div>

                <!-- Card Footer Action & Quick Share -->
                <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-2 border-t border-[#f0eae0] flex items-center justify-between">
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-[#164e2d] hover:text-[#082213] transition-colors group-hover:translate-x-0.5"
                  >
                    <span>Read Article</span>
                    <span class="text-sm">→</span>
                  </a>
                  
                  <a
                    href={waShare}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Share via WhatsApp"
                    class="w-7 h-7 rounded-full bg-[#f4ede0] hover:bg-[#e8dfcf] text-[#164e2d] flex items-center justify-center text-xs transition-colors"
                    aria-label={`Share ${title} on WhatsApp`}
                  >
                    💬
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty State for Search Filter -->
        <div id="no-results-state" class="hidden py-16 text-center">
          <span class="text-4xl block mb-2">🔍</span>
          <h3 class="text-lg font-serif font-bold text-[#082213]">No matching guides found</h3>
          <p class="text-xs text-[#6e8074] mt-1">Try searching for other ingredients like "Aloe", "Honey", "Dandruff", or "Moisturizer".</p>
          <button
            id="reset-filter-btn"
            type="button"
            class="mt-4 px-4 py-2 rounded-xl bg-[#0c3920] text-white text-xs font-semibold cursor-pointer"
          >
            Reset Filters
          </button>
        </div>

      </div>

    </div>
  </section>

</Layout>

<!-- Client Script for Instant Search & Topic Filtering -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('blog-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const filterPills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('[data-blog-card]');
    const countBadge = document.getElementById('articles-count-badge');
    const noResults = document.getElementById('no-results-state');
    const bentoSection = document.getElementById('featured-bento-section');
    const resetBtn = document.getElementById('reset-filter-btn');

    let currentFilter = 'all';
    let currentSearch = '';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const topic = card.getAttribute('data-topic') || '';
        const title = card.getAttribute('data-title') || '';
        const excerpt = card.getAttribute('data-excerpt') || '';

        const matchesTopic = currentFilter === 'all' || topic === currentFilter;
        const matchesSearch =
          !currentSearch ||
          title.includes(currentSearch) ||
          excerpt.includes(currentSearch);

        if (matchesTopic && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Show/Hide Bento header section if actively searching or filtering
      if (bentoSection) {
        if (currentFilter !== 'all' || currentSearch.length > 0) {
          bentoSection.classList.add('hidden');
        } else {
          bentoSection.classList.remove('hidden');
        }
      }

      // Update count badge
      if (countBadge) {
        countBadge.textContent = `Showing ${visibleCount} of ${cards.length} articles`;
      }

      // Show empty state if nothing found
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Filter pill click
    filterPills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const filterVal = target.getAttribute('data-filter') || 'all';
        currentFilter = filterVal;

        // Update active pill UI
        filterPills.forEach((p) => {
          p.classList.remove('bg-[#082213]', 'text-white', 'shadow-xs');
          p.classList.add('bg-white', 'text-[#33463a]', 'border', 'border-[#ded5c5]');
        });
        target.classList.remove('bg-white', 'text-[#33463a]', 'border', 'border-[#ded5c5]');
        target.classList.add('bg-[#082213]', 'text-white', 'shadow-xs');

        applyFilters();
      });
    });

    // Search input typing
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          if (currentSearch.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        applyFilters();
      });
    }

    // Clear search button
    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        clearBtn.classList.add('hidden');
        applyFilters();
      });
    }

    // Reset filters button
    if (resetBtn && searchInput) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        currentFilter = 'all';
        if (clearBtn) clearBtn.classList.add('hidden');

        filterPills.forEach((p, idx) => {
          if (idx === 0) {
            p.classList.remove('bg-white', 'text-[#33463a]', 'border', 'border-[#ded5c5]');
            p.classList.add('bg-[#082213]', 'text-white', 'shadow-xs');
          } else {
            p.classList.remove('bg-[#082213]', 'text-white', 'shadow-xs');
            p.classList.add('bg-white', 'text-[#33463a]', 'border', 'border-[#ded5c5]');
          }
        });

        applyFilters();
      });
    }
  });
</script>
