---
// src/pages/wellness/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Wellness/Hero.astro';
import Promise from '../components/Wellness/Promise.astro';
import OurRange from '../components/Products/OurRange.astro';
---

<Layout title="Wellness Products - Kshithija Enterprises">
  <!-- Wellness Specific Hero Section -->
  <Hero />

  <!-- Our Promise Banner (Replacing Philosophy) -->
  <Promise />

  <!-- Wellness Products Catalog (Strictly Wellness Products Only) -->
  <OurRange 
    activeCategory="wellness"
    strictCategory={true}
    showTabs={false}
    showGuarantees={false}
    sectionTitle="Our Range"
    heading="Wellness Products"
  />
</Layout>