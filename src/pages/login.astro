---
// src/pages/login.astro
// Luxury Ayurvedic Themed "My account / Login" Portal for Kshithija Enterprises
import Layout from '../layouts/Layout.astro';
---

<Layout title="My account - Kshithija Enterprises">
  
  <main class="relative min-h-[85vh] bg-[#fcfaf6] text-[#082213] py-12 sm:py-20 px-4 sm:px-6 lg:px-8 flex flex-col justify-center overflow-hidden">
    
    <!-- Subtle Botanical Ambient Background Glows -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-[#2ea843]/10 rounded-full blur-3xl pointer-events-none select-none"></div>
    <div class="absolute -bottom-32 right-10 w-96 h-96 bg-[#c99f5b]/10 rounded-full blur-3xl pointer-events-none select-none"></div>

    <div class="relative z-10 w-full max-w-lg mx-auto">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6 flex justify-center">
        <ol class="inline-flex items-center gap-2 text-xs text-[#5a6e61] bg-white/80 backdrop-blur-xs px-4 py-1.5 rounded-full border border-[#ded5c5] shadow-2xs">
          <li>
            <a href="/" class="hover:text-[#164e2d] transition-colors">Home</a>
          </li>
          <li class="text-[#a4b5aa]">/</li>
          <li class="font-semibold text-[#082213] tracking-wide" aria-current="page">My account</li>
        </ol>
      </nav>

      <!-- Brand Logo Header -->
      <div class="text-center mb-6">
        <a href="/" class="inline-flex items-center gap-3 group mb-2">
          <div class="w-12 h-12 rounded-full border-2 border-[#2ea843] flex items-center justify-center bg-[#082213] text-white relative shadow-sm group-hover:scale-105 transition-transform duration-300">
            <span class="text-xl">🌿</span>
            <span class="absolute -top-1 -right-1 text-[9px] font-bold text-[#a3cf54]">®</span>
          </div>
          <div class="flex flex-col text-left">
            <span class="text-2xl sm:text-3xl font-bold tracking-tight text-[#082213] leading-none font-serif">
              Kshithija
            </span>
            <span class="text-[10px] font-semibold tracking-widest uppercase text-[#55695b] leading-tight mt-1">
              Enterprises
            </span>
          </div>
        </a>
      </div>

      <!-- Main Login Card with Website Theme -->
      <div class="bg-white rounded-3xl border border-[#ded5c5] shadow-xl p-7 sm:p-9 relative overflow-hidden transition-all duration-300">
        
        <!-- Header Text -->
        <div class="mb-5 pb-4 border-b border-[#e8dfcf]">
          <h1 class="text-2xl sm:text-3xl font-serif font-bold text-[#082213] tracking-tight">
            My account
          </h1>
          <h2 class="text-base sm:text-lg font-medium text-[#55695b] mt-0.5">
            Login
          </h2>
        </div>

        <!-- Inline Error Alert -->
        <div
          id="login-error-alert"
          class="hidden mb-4 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-800 flex items-start gap-2.5 animate-in fade-in"
        >
          <span class="text-rose-600 text-sm shrink-0">⚠️</span>
          <span id="login-error-text" class="leading-relaxed">Invalid credentials.</span>
        </div>

        <!-- Inline Success Alert -->
        <div
          id="login-success-alert"
          class="hidden mb-4 p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-start gap-2.5 animate-in fade-in"
        >
          <span class="text-emerald-600 text-sm shrink-0">✓</span>
          <span id="login-success-text" class="leading-relaxed">Login successful! Redirecting to your account...</span>
        </div>

        <!-- Official WooCommerce & WordPress Login Form -->
        <form
          name="loginform"
          id="loginform"
          action="https://kshithija.in/my-account/"
          method="post"
          class="space-y-4 sm:space-y-5"
        >
          <!-- Username or Email Address Field -->
          <div>
            <label for="username" class="block text-xs sm:text-sm font-semibold text-[#082213] mb-1.5">
              Username or email address <span class="text-rose-600">*</span>
            </label>
            <input
              type="text"
              name="username"
              id="username"
              required
              autocomplete="username"
              placeholder="Enter your username or email"
              class="w-full px-4 py-3 rounded-xl bg-[#faf7f0]/60 border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#8c9e92] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#164e2d]/30 focus:border-[#164e2d] transition-all shadow-2xs"
            />
          </div>

          <!-- Password Field with Toggle Eye Icon -->
          <div>
            <label for="password" class="block text-xs sm:text-sm font-semibold text-[#082213] mb-1.5">
              Password <span class="text-rose-600">*</span>
            </label>
            <div class="relative flex items-center">
              <input
                type="password"
                name="password"
                id="password"
                required
                autocomplete="current-password"
                placeholder="Enter your password"
                class="w-full pl-4 pr-11 py-3 rounded-xl bg-[#faf7f0]/60 border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#8c9e92] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#164e2d]/30 focus:border-[#164e2d] transition-all shadow-2xs"
              />
              <button
                type="button"
                id="toggle-pwd-btn"
                class="absolute right-3.5 text-gray-400 hover:text-[#082213] cursor-pointer p-1 transition-colors select-none"
                aria-label="Toggle password visibility"
                title="Toggle password visibility"
              >
                <!-- Slashed Eye Icon (Default Hidden State) -->
                <svg id="eye-icon" class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Action Row: LOG IN Button + Remember Me Checkbox -->
          <div class="flex items-center gap-4 pt-2">
            <button
              type="submit"
              name="login"
              id="login-submit"
              value="Log in"
              class="px-6 py-3 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] active:scale-98 text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-md hover:shadow-lg cursor-pointer flex items-center justify-center gap-2 group shrink-0"
            >
              <span id="btn-text">LOG IN</span>
              <span id="btn-arrow" class="text-sm group-hover:translate-x-0.5 transition-transform">→</span>
            </button>

            <label class="flex items-center gap-2.5 cursor-pointer text-xs sm:text-sm text-[#3e5044] font-medium select-none group">
              <input
                type="checkbox"
                name="rememberme"
                id="rememberme"
                value="forever"
                class="w-4 h-4 rounded border-[#ded5c5] text-[#164e2d] focus:ring-[#164e2d] cursor-pointer accent-[#164e2d]"
              />
              <span class="group-hover:text-[#082213] transition-colors">Remember me</span>
            </label>
          </div>

          <!-- Lost your password? Link -->
          <div class="pt-2">
            <a
              href="/forgotpassword"
              class="text-xs sm:text-sm text-[#164e2d] hover:text-[#0c3920] hover:underline transition-colors font-semibold inline-block"
            >
              Lost your password?
            </a>
          </div>

        </form>

      </div>

    </div>
  </main>

</Layout>

<script>
  import { loginWithWordPress, isAuthenticated } from '../lib/auth';

  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const redirectTarget = urlParams.get('redirect') || '/orders';

    // If user is already authenticated, forward to orders
    if (isAuthenticated()) {
      window.location.href = redirectTarget;
      return;
    }

    const toggleBtn = document.getElementById('toggle-pwd-btn');
    const pwdInput = document.getElementById('password') as HTMLInputElement;
    const eyeIcon = document.getElementById('eye-icon');
    const form = document.getElementById('loginform') as HTMLFormElement;
    const userField = document.getElementById('username') as HTMLInputElement;
    const rememberCheckbox = document.getElementById('rememberme') as HTMLInputElement;
    const submitBtn = document.getElementById('login-submit') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const errorAlert = document.getElementById('login-error-alert');
    const errorText = document.getElementById('login-error-text');
    const successAlert = document.getElementById('login-success-alert');

    const openEyeSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
    const slashEyeSvg = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />`;

    // Password visibility toggle
    if (toggleBtn && pwdInput && eyeIcon) {
      toggleBtn.addEventListener('click', () => {
        const isPwd = pwdInput.type === 'password';
        pwdInput.type = isPwd ? 'text' : 'password';
        eyeIcon.innerHTML = isPwd ? openEyeSvg : slashEyeSvg;
      });
    }

    // Headless Asynchronous AJAX Authentication
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Reset alert states
        if (errorAlert) errorAlert.classList.add('hidden');
        if (successAlert) successAlert.classList.add('hidden');

        const username = userField ? userField.value.trim() : '';
        const password = pwdInput ? pwdInput.value : '';
        const remember = rememberCheckbox ? rememberCheckbox.checked : true;

        if (!username || !password) {
          if (errorText && errorAlert) {
            errorText.textContent = 'Please enter both username and password.';
            errorAlert.classList.remove('hidden');
          }
          return;
        }

        // Set UI loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'LOGGING IN...';

        try {
          const authData = await loginWithWordPress(username, password, remember);

          if (successAlert) successAlert.classList.remove('hidden');
          setTimeout(() => {
            const urlParams = new URLSearchParams(window.location.search);
            const redirectParam = urlParams.get('redirect');
            let redirectTarget = redirectParam;
            if (!redirectTarget) {
              const isAff = authData?.user?.isAffiliate || (Array.isArray(authData?.user?.roles) && (authData.user.roles.includes('affiliate') || authData.user.roles.includes('affilate')));
              redirectTarget = isAff ? '/affiliate-dashboard' : (redirectParam || '/orders');
            }
            window.location.href = redirectTarget;
          }, 600);
        } catch (err: any) {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'LOG IN';

          if (errorText && errorAlert) {
            errorText.textContent = err.message || 'Login failed. Please verify your credentials.';
            errorAlert.classList.remove('hidden');
          }
        }
      });
    }
  });
</script>
