---
// src/pages/addresses.astro
// Dedicated Delivery & Billing Addresses page for Kshithija Enterprises in Light Mode
// Replicates WooCommerce /my-account/edit-address/ and /edit-address/shipping/
import Layout from '../layouts/Layout.astro';
import AccountSidebar from '@components/common/AccountSidebar.astro';
import { COUNTRIES } from '../data/countries';
---

<Layout title="Delivery Addresses - Kshithija Enterprises">
  
  <main class="min-h-screen bg-[#f8fafc] text-[#082213] py-8 sm:py-12 px-4 sm:px-6 lg:px-8 relative">
    
    <div class="max-w-7xl mx-auto">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-[#64748b]">
        <ol class="inline-flex items-center gap-2">
          <li><a href="/" class="hover:text-[#0c3920] transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/orders" class="hover:text-[#0c3920] transition-colors">My account</a></li>
          <li>/</li>
          <li><a href="/addresses" id="breadcrumb-addresses" class="hover:text-[#0c3920] transition-colors">Delivery addresses</a></li>
          <li id="breadcrumb-sub-separator" class="hidden">/</li>
          <li id="breadcrumb-sub-current" class="font-semibold text-[#082213] hidden">Edit Shipping Address</li>
        </ol>
      </nav>

      <!-- Main Layout: Sidebar (exact Flowbite design) + Addresses Content -->
      <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-start">
        
        <!-- Persistent Sidebar with 'addresses' active (Do not touch) -->
        <AccountSidebar activeItem="addresses" />

        <!-- Right Content Section: Addresses Views -->
        <div class="flex-1 w-full min-w-0 space-y-6">
          
          <!-- Not Logged In State -->
          <div id="state-not-logged-in" class="hidden bg-white rounded-3xl border border-[#cbd5e1] py-16 text-center text-[#64748b] shadow-xs">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#f1f5f9] border border-[#e2e8f0] flex items-center justify-center text-2xl">
              🔒
            </div>
            <h3 class="text-base font-bold text-[#082213] mb-1">Sign in to view your addresses</h3>
            <p class="text-xs text-[#64748b] max-w-sm mx-auto mb-5 leading-relaxed">
              Log in with your Kshithija customer credentials to manage your live WooCommerce shipping and billing addresses.
            </p>
            <a
              href="/login?redirect=/addresses"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs font-semibold transition shadow-xs cursor-pointer"
            >
              <span>Sign In to Your Account</span>
              <span>→</span>
            </a>
          </div>

          <!-- Loading State -->
          <div id="state-loading" class="bg-white rounded-3xl border border-[#cbd5e1] py-16 text-center text-[#64748b] shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-[#0c3920] border-t-transparent mb-3"></div>
            <p class="text-xs font-semibold text-[#082213]">Loading customer addresses </p>
          </div>

          <!-- ========================================================= -->
          <!-- VIEW 1: ADDRESSES LIST (Cards View)                       -->
          <!-- ========================================================= -->
          <div id="view-addresses-list" class="space-y-6 hidden">
            
            <!-- Top Header Card -->
            <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#cbd5e1] shadow-xs">
              <h1 class="text-xl sm:text-2xl font-bold text-[#082213] tracking-tight">
                My addresses
              </h1>
              <p class="text-xs text-[#64748b] mt-1.5 leading-relaxed">
                The following addresses will be used on the checkout page by default.
              </p>
            </div>

            <!-- Addresses Grid (2 cards: Shipping & Billing) -->
            <div id="addresses-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              <!-- 1. Shipping Address Card -->
              <div id="card-shipping" class="bg-white rounded-3xl border border-[#cbd5e1] p-6 sm:p-7 shadow-xs relative flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                  <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#e2e8f0]">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#f0fdf4] text-[#16a34a] border border-[#bbf7d0]">
                      <span>📦</span>
                      <span>Shipping Address</span>
                    </span>
                  </div>

                  <h3 id="shipping-name" class="text-sm sm:text-base font-bold text-[#082213] mb-1.5">
                    <!-- Populated dynamically -->
                  </h3>
                  
                  <div id="shipping-details" class="text-xs sm:text-sm text-[#475569] leading-relaxed space-y-1">
                    <!-- Populated dynamically: actual address OR "You have not set up this type of address yet." -->
                  </div>
                </div>

                <div id="shipping-action-container" class="mt-6 pt-4 border-t border-[#e2e8f0] flex items-center justify-between">
                  <!-- Populated dynamically: "+ Add address" or "✏️ Edit address" -->
                </div>
              </div>

              <!-- 2. Billing Address Card -->
              <div id="card-billing" class="bg-white rounded-3xl border border-[#cbd5e1] p-6 sm:p-7 shadow-xs relative flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                  <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#e2e8f0]">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#f0f9ff] text-[#0284c7] border border-[#bae6fd]">
                      <span>💳</span>
                      <span>Billing Address</span>
                    </span>
                  </div>

                  <h3 id="billing-name" class="text-sm sm:text-base font-bold text-[#082213] mb-1.5">
                    <!-- Populated dynamically -->
                  </h3>
                  
                  <div id="billing-details" class="text-xs sm:text-sm text-[#475569] leading-relaxed space-y-1">
                    <!-- Populated dynamically: actual address OR "You have not set up this type of address yet." -->
                  </div>
                </div>

                <div id="billing-action-container" class="mt-6 pt-4 border-t border-[#e2e8f0] flex items-center justify-between">
                  <!-- Populated dynamically: "+ Add address" or "✏️ Edit address" -->
                </div>
              </div>

            </div>

          </div>

          <!-- ========================================================= -->
          <!-- VIEW 2: ADDRESS FORM (Matches WooCommerce /edit-address/) -->
          <!-- ========================================================= -->
          <div id="view-address-form" class="hidden">
            <div class="bg-white rounded-3xl border border-[#cbd5e1] p-6 sm:p-8 shadow-xs">
              
              <!-- Back Button -->
              <button
                type="button"
                id="btn-back-to-addresses"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#64748b] hover:text-[#082213] mb-4 cursor-pointer transition"
              >
                <span>←</span>
                <span>Back to addresses</span>
              </button>

              <!-- Form Header -->
              <div class="pb-5 border-b border-[#e2e8f0]">
                <h2 id="form-heading" class="text-xl sm:text-2xl font-bold text-[#082213] tracking-tight">
                  Shipping address
                </h2>
                <p id="form-subheading" class="text-xs text-[#64748b] mt-1 leading-relaxed">
                  Enter your address details below. This will be used as your default address on checkout.
                </p>
              </div>

              <!-- WooCommerce Standard Address Form -->
              <form id="address-editor-form" class="mt-6 space-y-4 text-xs sm:text-sm">
                <input type="hidden" id="form-address-type" value="shipping" />

                <!-- Row 1: First Name & Last Name -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="input-first-name" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      First name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="input-first-name"
                      required
                      placeholder="e.g. Adithya"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                  <div>
                    <label for="input-last-name" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Last name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="input-last-name"
                      required
                      placeholder="e.g. Puthraya"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                </div>

                <!-- Row 2: Company Name (Optional) -->
                <div>
                  <label for="input-company" class="block font-bold text-[#082213] mb-1.5 text-xs">
                    Company name <span class="text-[#94a3b8] font-normal">(optional)</span>
                  </label>
                  <input
                    type="text"
                    id="input-company"
                    placeholder="e.g. Kshithija Enterprises"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                  />
                </div>

                <!-- Row 3: Country / Region -->
                <div>
                  <label for="input-country" class="block font-bold text-[#082213] mb-1.5 text-xs">
                    Country / Region <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="input-country"
                    required
                    class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition cursor-pointer"
                  >
                    {COUNTRIES.map((c) => (
                      <option value={c.code} selected={c.code === 'IN'}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>

                <!-- Row 4: Street Address (Address 1 & 2) -->
                <div class="space-y-2">
                  <label for="input-address1" class="block font-bold text-[#082213] mb-1.5 text-xs">
                    Street address <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="input-address1"
                    required
                    placeholder="House number and street name"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                  />
                  <input
                    type="text"
                    id="input-address2"
                    placeholder="Apartment, suite, unit, building, floor, etc. (optional)"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                  />
                </div>

                <!-- Row 5: Town / City & State -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="input-city" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Town / City <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="input-city"
                      required
                      placeholder="e.g. Mangaluru"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                  <div>
                    <label for="input-state" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      State <span class="text-red-500">*</span>
                    </label>
                    <select
                      id="input-state"
                      required
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition cursor-pointer"
                    >
                      <option value="">Select a state...</option>
                      <option value="Karnataka" selected>Karnataka</option>
                      <option value="Andhra Pradesh">Andhra Pradesh</option>
                      <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                      <option value="Assam">Assam</option>
                      <option value="Bihar">Bihar</option>
                      <option value="Chhattisgarh">Chhattisgarh</option>
                      <option value="Goa">Goa</option>
                      <option value="Gujarat">Gujarat</option>
                      <option value="Haryana">Haryana</option>
                      <option value="Himachal Pradesh">Himachal Pradesh</option>
                      <option value="Jharkhand">Jharkhand</option>
                      <option value="Kerala">Kerala</option>
                      <option value="Madhya Pradesh">Madhya Pradesh</option>
                      <option value="Maharashtra">Maharashtra</option>
                      <option value="Manipur">Manipur</option>
                      <option value="Meghalaya">Meghalaya</option>
                      <option value="Mizoram">Mizoram</option>
                      <option value="Nagaland">Nagaland</option>
                      <option value="Odisha">Odisha</option>
                      <option value="Punjab">Punjab</option>
                      <option value="Rajasthan">Rajasthan</option>
                      <option value="Sikkim">Sikkim</option>
                      <option value="Tamil Nadu">Tamil Nadu</option>
                      <option value="Telangana">Telangana</option>
                      <option value="Tripura">Tripura</option>
                      <option value="Uttar Pradesh">Uttar Pradesh</option>
                      <option value="Uttarakhand">Uttarakhand</option>
                      <option value="West Bengal">West Bengal</option>
                      <option value="Delhi">Delhi</option>
                      <option value="Chandigarh">Chandigarh</option>
                      <option value="Puducherry">Puducherry</option>
                      <option value="Jammu and Kashmir">Jammu and Kashmir</option>
                      <option value="Ladakh">Ladakh</option>
                    </select>
                  </div>
                </div>

                <!-- Row 6: PIN Code & Phone Number -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="input-postcode" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      PIN Code <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="input-postcode"
                      required
                      placeholder="e.g. 575002"
                      pattern="[0-9]{6}"
                      title="Please enter a valid 6-digit Indian PIN code"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                  <div>
                    <label for="input-phone" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Phone Number <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="tel"
                      id="input-phone"
                      required
                      placeholder="e.g. 9481973468"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                </div>

                <!-- Row 7: Email Address (Required for billing, optional for shipping) -->
                <div id="row-email">
                  <label for="input-email" class="block font-bold text-[#082213] mb-1.5 text-xs">
                    Email address <span id="label-email-required" class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="input-email"
                    placeholder="e.g. name@example.com"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                  />
                </div>

                <!-- Form Submit and Cancel Actions -->
                <div class="pt-6 border-t border-[#e2e8f0] flex flex-wrap items-center justify-start gap-3">
                  <button
                    type="submit"
                    id="btn-save-address"
                    class="px-6 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs sm:text-sm font-bold transition-all shadow-xs cursor-pointer flex items-center gap-2"
                  >
                    <span>Save address</span>
                  </button>
                  <button
                    type="button"
                    id="btn-cancel-form"
                    class="px-5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm font-semibold text-[#64748b] hover:bg-[#f1f5f9] hover:text-[#082213] transition cursor-pointer"
                  >
                    Cancel
                  </button>
                </div>

              </form>

            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- Toast Notification -->
    <div
      id="toast"
      class="fixed bottom-6 right-6 z-50 bg-[#082213] text-white px-5 py-3 rounded-2xl shadow-2xl border border-emerald-500/30 flex items-center gap-3 text-xs font-semibold translate-y-24 opacity-0 transition-all duration-300 pointer-events-none"
    >
      <span class="text-emerald-400 text-base">✓</span>
      <span id="toast-text">Address saved successfully!</span>
    </div>

  </main>

</Layout>

<script>
  import { getCustomerProfile, updateCustomerAddress, getCustomerOrders, getStoredToken, getStoredUser, type CustomerAddress } from '../lib/auth';

  document.addEventListener('DOMContentLoaded', async () => {
    // Containers & Views
    const stateLoading = document.getElementById('state-loading');
    const stateNotLoggedIn = document.getElementById('state-not-logged-in');
    const viewList = document.getElementById('view-addresses-list');
    const viewForm = document.getElementById('view-address-form');

    // Breadcrumbs elements
    const breadcrumbAddresses = document.getElementById('breadcrumb-addresses');
    const breadcrumbSubSeparator = document.getElementById('breadcrumb-sub-separator');
    const breadcrumbSubCurrent = document.getElementById('breadcrumb-sub-current');

    // Form elements
    const formHeading = document.getElementById('form-heading');
    const formSubheading = document.getElementById('form-subheading');
    const formType = document.getElementById('form-address-type') as HTMLInputElement;
    const form = document.getElementById('address-editor-form') as HTMLFormElement;
    const saveBtn = document.getElementById('btn-save-address') as HTMLButtonElement;
    const cancelBtn = document.getElementById('btn-cancel-form');
    const backBtn = document.getElementById('btn-back-to-addresses');

    // Inputs
    const inputFirstName = document.getElementById('input-first-name') as HTMLInputElement;
    const inputLastName = document.getElementById('input-last-name') as HTMLInputElement;
    const inputCompany = document.getElementById('input-company') as HTMLInputElement;
    const inputCountry = document.getElementById('input-country') as HTMLSelectElement;
    const inputAddress1 = document.getElementById('input-address1') as HTMLInputElement;
    const inputAddress2 = document.getElementById('input-address2') as HTMLInputElement;
    const inputCity = document.getElementById('input-city') as HTMLInputElement;
    const inputState = document.getElementById('input-state') as HTMLSelectElement;
    const inputPostcode = document.getElementById('input-postcode') as HTMLInputElement;
    const inputPhone = document.getElementById('input-phone') as HTMLInputElement;
    const inputEmail = document.getElementById('input-email') as HTMLInputElement;
    const labelEmailRequired = document.getElementById('label-email-required');

    // Toast
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');

    let currentShipping: CustomerAddress = {};
    let currentBilling: CustomerAddress = {};

    function showToast(msg: string) {
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('translate-y-24', 'opacity-0');
        setTimeout(() => toast.classList.add('translate-y-24', 'opacity-0'), 3000);
      }
    }

    /**
     * Render an address card.
     * When address is NOT there:
     *   - Displays: "You have not set up this type of address yet."
     *   - Shows: "+ Add address" button
     * When address IS there:
     *   - Displays customer name and full address
     *   - Shows: "✏️ Edit address" button
     */
    function renderCard(type: 'shipping' | 'billing', addr: CustomerAddress, defaultName: string) {
      const nameEl = document.getElementById(`${type}-name`);
      const detailsEl = document.getElementById(`${type}-details`);
      const actionEl = document.getElementById(`${type}-action-container`);

      const hasAddr = Boolean(addr && (addr.address1 || addr.city || addr.postcode));

      if (!hasAddr) {
        if (nameEl) nameEl.classList.add('hidden');
        if (detailsEl) {
          detailsEl.innerHTML = `
            <p class="text-xs sm:text-sm text-[#64748b] italic py-2 leading-relaxed">
              You have not set up this type of address yet.
            </p>
          `;
        }
        if (actionEl) {
          actionEl.innerHTML = `
            <button
              type="button"
              class="btn-address-action inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs font-semibold shadow-xs transition cursor-pointer"
              data-type="${type}"
              data-mode="add"
            >
              <span>+</span>
              <span>Add address</span>
            </button>
          `;
        }
      } else {
        const firstName = addr.firstName || '';
        const lastName = addr.lastName || '';
        const fullName = (firstName || lastName) ? `${firstName} ${lastName}`.trim() : defaultName;

        if (nameEl) {
          nameEl.textContent = fullName;
          nameEl.classList.remove('hidden');
        }

        if (detailsEl) {
          detailsEl.innerHTML = `
            ${addr.company ? `<p class="font-medium text-[#082213]">${addr.company}</p>` : ''}
            ${addr.address1 ? `<p>${addr.address1}</p>` : ''}
            ${addr.address2 ? `<p>${addr.address2}</p>` : ''}
            ${(addr.city || addr.postcode) ? `<p>${addr.city || ''} ${addr.postcode ? '- ' + addr.postcode : ''}</p>` : ''}
            ${addr.state ? `<p>${addr.state}, ${addr.country || 'India'}</p>` : ''}
            ${addr.phone ? `<p class="pt-1.5 font-medium text-[#082213]">📞 ${addr.phone}</p>` : ''}
            ${addr.email ? `<p class="text-[#0284c7]">✉ ${addr.email}</p>` : ''}
          `;
        }

        if (actionEl) {
          actionEl.innerHTML = `
            <button
              type="button"
              class="btn-address-action text-xs font-semibold text-[#0284c7] hover:underline cursor-pointer flex items-center gap-1.5"
              data-type="${type}"
              data-mode="edit"
            >
              <span>✏️</span>
              <span>Edit address</span>
            </button>
          `;
        }
      }
    }

    /**
     * Display the address form matching WooCommerce /my-account/edit-address/shipping/
     */
    function openAddressForm(type: 'shipping' | 'billing') {
      const user = getStoredUser();
      const addr = type === 'billing' ? currentBilling : currentShipping;
      const isBilling = type === 'billing';
      const hasAddr = Boolean(addr && (addr.address1 || addr.city || addr.postcode));

      // 1. Set titles
      const typeLabel = isBilling ? 'Billing' : 'Shipping';
      const modeLabel = hasAddr ? 'Edit' : 'Add';
      if (formHeading) formHeading.textContent = `${typeLabel} address`;
      if (formSubheading) {
        formSubheading.textContent = isBilling
          ? 'Enter your billing address details below. Used for invoice generation and payments.'
          : 'Enter your delivery address details below. Used for shipping physical orders.';
      }

      // 2. Set hidden form type
      if (formType) formType.value = type;

      // 3. Pre-fill input values
      inputFirstName.value = addr.firstName || user?.firstName || '';
      inputLastName.value = addr.lastName || user?.lastName || '';
      inputCompany.value = addr.company || '';
      inputAddress1.value = addr.address1 || '';
      inputAddress2.value = addr.address2 || '';
      inputCity.value = addr.city || '';
      inputPostcode.value = addr.postcode || '';
      inputPhone.value = addr.phone || '';

      // Set Country
      const countryVal = addr.country || 'IN';
      if (inputCountry) {
        let match = false;
        for (let i = 0; i < inputCountry.options.length; i++) {
          if (
            inputCountry.options[i].value.toLowerCase() === countryVal.toLowerCase() ||
            inputCountry.options[i].text.toLowerCase().includes(countryVal.toLowerCase())
          ) {
            inputCountry.selectedIndex = i;
            match = true;
            break;
          }
        }
        if (!match) inputCountry.value = 'IN';
      }

      // Set State
      const stateVal = addr.state || 'Karnataka';
      if (inputState) {
        let match = false;
        for (let i = 0; i < inputState.options.length; i++) {
          if (inputState.options[i].value.toLowerCase() === stateVal.toLowerCase()) {
            inputState.selectedIndex = i;
            match = true;
            break;
          }
        }
        if (!match) inputState.value = 'Karnataka';
      }

      // Email field handling
      if (isBilling) {
        inputEmail.required = true;
        inputEmail.value = addr.email || user?.email || '';
        labelEmailRequired?.classList.remove('hidden');
      } else {
        inputEmail.required = false;
        inputEmail.value = addr.email || '';
        labelEmailRequired?.classList.add('hidden');
      }

      // 4. Update breadcrumbs
      if (breadcrumbSubSeparator) breadcrumbSubSeparator.classList.remove('hidden');
      if (breadcrumbSubCurrent) {
        breadcrumbSubCurrent.textContent = `${modeLabel} ${typeLabel} Address`;
        breadcrumbSubCurrent.classList.remove('hidden');
      }

      // 5. Switch view
      viewList?.classList.add('hidden');
      viewForm?.classList.remove('hidden');

      // Update URL query param without full page reload
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('edit', type);
        window.history.pushState({}, '', url.toString());
      } catch {}

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /**
     * Close the form and return to the addresses cards view
     */
    function closeAddressForm() {
      viewForm?.classList.add('hidden');
      viewList?.classList.remove('hidden');

      if (breadcrumbSubSeparator) breadcrumbSubSeparator.classList.add('hidden');
      if (breadcrumbSubCurrent) breadcrumbSubCurrent.classList.add('hidden');

      // Clean URL query param
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('edit');
        window.history.pushState({}, '', url.pathname);
      } catch {}

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Attach Back & Cancel buttons
    backBtn?.addEventListener('click', closeAddressForm);
    cancelBtn?.addEventListener('click', closeAddressForm);
    breadcrumbAddresses?.addEventListener('click', (e) => {
      if (!viewForm?.classList.contains('hidden')) {
        e.preventDefault();
        closeAddressForm();
      }
    });

    // Delegate click on Add / Edit address buttons in the cards
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.btn-address-action');
      if (target) {
        const type = (target.getAttribute('data-type') || 'shipping') as 'shipping' | 'billing';
        openAddressForm(type);
      }
    });

    /**
     * Load addresses from WordPress WooCommerce backend
     */
    async function loadAddresses() {
      const token = getStoredToken();
      const user = getStoredUser();

      if (!token) {
        stateLoading?.classList.add('hidden');
        viewList?.classList.add('hidden');
        viewForm?.classList.add('hidden');
        stateNotLoggedIn?.classList.remove('hidden');
        return;
      }

      stateNotLoggedIn?.classList.add('hidden');
      stateLoading?.classList.remove('hidden');
      viewList?.classList.add('hidden');
      viewForm?.classList.add('hidden');

      try {
        const [profile, orders] = await Promise.all([
          getCustomerProfile().catch(() => null),
          getCustomerOrders().catch(() => []),
        ]);

        const latestOrder = orders && orders.length > 0 ? orders[0] : null;
        const fallbackBilling = latestOrder?.billing || null;
        const fallbackShipping = latestOrder?.shipping || null;

        // Resolve shipping strictly from shipping sources
        currentShipping = profile?.shipping?.address1 
          ? profile.shipping 
          : (fallbackShipping?.address1 ? fallbackShipping : (profile?.shipping || {}));

        // Resolve billing strictly from billing sources
        currentBilling = profile?.billing?.address1 
          ? profile.billing 
          : (fallbackBilling?.address1 ? fallbackBilling : (profile?.billing || {}));

        const defaultName = user?.displayName || user?.firstName || 'Customer';
        renderCard('shipping', currentShipping, defaultName);
        renderCard('billing', currentBilling, defaultName);

        stateLoading?.classList.add('hidden');

        // Check if user came with ?edit=shipping or ?edit=billing
        const urlParams = new URLSearchParams(window.location.search);
        const editParam = urlParams.get('edit');
        if (editParam === 'shipping' || editParam === 'billing') {
          openAddressForm(editParam);
        } else {
          viewList?.classList.remove('hidden');
        }
      } catch (err) {
        console.error('Failed to load customer addresses:', err);
        stateLoading?.classList.add('hidden');
        viewList?.classList.remove('hidden');
      }
    }

    // Initial load
    await loadAddresses();

    /**
     * Form Submission -> Update customer address in WordPress
     */
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = `
          <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
          <span>Saving to WordPress...</span>
        `;
      }

      const type = (formType?.value || 'shipping') as 'shipping' | 'billing';
      const addressData: Record<string, string> = {
        first_name: inputFirstName.value.trim(),
        last_name: inputLastName.value.trim(),
        company: inputCompany.value.trim(),
        country: inputCountry.value || 'IN',
        address_1: inputAddress1.value.trim(),
        address_2: inputAddress2.value.trim(),
        city: inputCity.value.trim(),
        state: inputState.value.trim(),
        postcode: inputPostcode.value.trim(),
        phone: inputPhone.value.trim(),
        email: inputEmail.value.trim(),
      };

      try {
        await updateCustomerAddress(type, addressData);
        showToast(`${type === 'billing' ? 'Billing' : 'Shipping'} address saved successfully!`);

        // Update local object
        const updatedAddr: CustomerAddress = {
          firstName: addressData.first_name,
          lastName: addressData.last_name,
          company: addressData.company,
          country: addressData.country,
          address1: addressData.address_1,
          address2: addressData.address_2,
          city: addressData.city,
          state: addressData.state,
          postcode: addressData.postcode,
          phone: addressData.phone,
          email: addressData.email,
        };

        if (type === 'billing') currentBilling = updatedAddr;
        else currentShipping = updatedAddr;

        const user = getStoredUser();
        renderCard(type, updatedAddr, user?.displayName || 'Customer');

        // Close form and return to cards view
        closeAddressForm();
      } catch (err: any) {
        console.error('Save address error:', err);
        showToast(err.message || 'Failed to save address.');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `<span>Save address</span>`;
        }
      }
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const editParam = urlParams.get('edit');
      if (editParam === 'shipping' || editParam === 'billing') {
        openAddressForm(editParam);
      } else {
        closeAddressForm();
      }
    });
  });
</script>
