---
// src/pages/affiliate-registration.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Affiliate Registration - Become an Official Brand Partner | Kshithija Enterprises">
  
  <!-- Page Header & Hero Section -->
  <section class="relative w-full bg-[#fbf9f4] pt-12 sm:pt-16 pb-10 sm:pb-14 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf] overflow-hidden">
    <!-- Ambient Botanical Leaf Background Graphic -->
    <div class="absolute -right-20 -top-20 w-80 h-80 opacity-5 pointer-events-none select-none text-[#082213]">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
      </svg>
    </div>

    <div class="max-w-6xl mx-auto relative z-10 text-center">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="inline-flex items-center justify-center gap-2 text-xs text-[#5a6e61]">
          <li>
            <a href="/" class="hover:text-[#0c3920] transition-colors">Home</a>
          </li>
          <li class="text-[#a4b5aa]">/</li>
          <li class="font-semibold text-[#082213] tracking-wide" aria-current="page">Affiliate Registration</li>
        </ol>
      </nav>

   

    </div>
  </section>

  <!-- Main Content: Centered Affiliate Registration Form -->
  <section class="relative w-full bg-[#fcfaf6] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <div class="bg-white rounded-2xl p-6 sm:p-10 border border-[#ded5c5] shadow-sm">
            
            <!-- Form Header (Matching Screenshot) -->
            <div class="mb-8 pb-6 border-b border-[#f4ede0] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#082213] tracking-tight">
                  Become an Affiliate
                </h2>
                <p class="text-xs sm:text-sm text-[#5a6e61] mt-1 font-normal">
                  Register for free and get your own personal discount coupon.
                </p>
              </div>

              <!-- Quick Link to Affiliate Login -->
              <a
                href="/affiliate-login"
                id="aff-top-login-link"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#f4ede0] hover:bg-[#ebd8bc] text-[#082213] text-xs font-semibold border border-[#ded5c5] transition-all self-start sm:self-auto shrink-0"
              >
                <span id="aff-top-login-text">Already registered? Log In</span>
                <span>→</span>
              </a>
            </div>

            <!-- Banner for Existing Active Affiliates (Hidden by default) -->
            <div id="aff-already-partner-banner" class="hidden mb-6 p-4 rounded-2xl bg-[#eaf4ed] border border-[#c2dfcb] text-xs sm:text-sm text-[#18532f] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="flex items-center gap-2.5">
                <span class="text-xl">🌿</span>
                <span>You are already an active Kshithija Affiliate Partner!</span>
              </div>
              <a
                href="/affiliate-dashboard"
                class="px-4 py-1.5 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] text-white text-xs font-bold transition shadow-xs self-start sm:self-auto shrink-0"
              >
                Go to Dashboard →
              </a>
            </div>

            <!-- Registration Form -->
            <form
              id="affiliate-register-form"
              class="space-y-5"
            >
              <!-- First Name & Last Name (2 Cols on tablet+) -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="first_name" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                    First Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="first_name"
                    name="first_name"
                    required
                    placeholder="e.g. Ramesh"
                    class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all"
                  />
                </div>

                <div>
                  <label for="last_name" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                    Last Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="last_name"
                    name="last_name"
                    required
                    placeholder="e.g. Bhat"
                    class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all"
                  />
                </div>
              </div>

              <!-- Email Field -->
              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="e.g. yourname@domain.com"
                  class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all"
                />
              </div>

              <!-- Username Field -->
              <div>
                <label for="username" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                  Username <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <input
                    type="text"
                    id="username"
                    name="username"
                    required
                    placeholder="e.g. ramesh_wellness"
                    class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all font-mono"
                  />
                 
                </div>
              </div>

              <!-- Password & Confirm Password (2 Cols) -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                    Password <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    minlength="8"
                    required
                    placeholder="Min 8 characters"
                    class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all"
                  />
                </div>

                <div>
                  <label for="password_confirm" class="block text-xs font-semibold uppercase tracking-wider text-[#082213] mb-1.5">
                    Confirm Password <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="password"
                    id="password_confirm"
                    name="password_confirm"
                    minlength="8"
                    required
                    placeholder="Re-type password"
                    class="w-full px-4 py-3 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:border-transparent transition-all"
                  />
                </div>
              </div>

 

              <!-- Error Alert (Hidden by default) -->
              <div id="form-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-xs sm:text-sm text-red-700 flex items-center gap-2.5">
                <span class="text-base">⚠️</span>
                <span id="form-error-msg">Registration error</span>
              </div>

              <!-- Success Alert (Hidden by default) -->
              <div id="form-feedback" class="hidden p-4 rounded-xl bg-[#eaf4ed] border border-[#c2dfcb] text-xs sm:text-sm text-[#18532f] flex items-center gap-3">
                <span class="text-xl">🎉</span>
                <div>
                  <strong>Registration Successful!</strong> Welcome to the Kshithija affiliate partner family. Redirecting to your dashboard...
                </div>
              </div>

              <!-- Submit Button (Styled with Gold / Tan Luxury Accent) -->
              <div class="pt-2">
                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#c99f5b] hover:bg-[#b88c45] active:bg-[#a67c37] text-[#082213] font-bold text-xs sm:text-sm uppercase tracking-widest shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 group disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="btn-text">Register as Affiliate</span>
                  <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </button>
              </div>

            </form>

          </div>
        </div>
      </section>

</Layout>

<!-- Interactive Client AJAX Registration Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('affiliate-register-form');
    const firstName = document.getElementById('first_name');
    const lastName = document.getElementById('last_name');
    const email = document.getElementById('email');
    const username = document.getElementById('username');
    const pwd = document.getElementById('password');
    const pwdConfirm = document.getElementById('password_confirm');
    const feedback = document.getElementById('form-feedback');
    const errorBox = document.getElementById('form-error');
    const errorMsg = document.getElementById('form-error-msg');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');

    const topLoginLink = document.getElementById('aff-top-login-link');
    const topLoginText = document.getElementById('aff-top-login-text');
    const alreadyPartnerBanner = document.getElementById('aff-already-partner-banner');

    if (!form || !pwd || !pwdConfirm) return;

    // Check if user is already logged in
    const token = localStorage.getItem('kshithija_auth_token');
    let user = null;
    try {
      const rawUser = localStorage.getItem('kshithija_auth_user');
      if (rawUser) user = JSON.parse(rawUser);
    } catch {}

    const isLoggedIn = Boolean(token);
    const isAffiliate = Boolean(
      user && (
        user.isAffiliate === true ||
        user.isAffiliate === '1' ||
        user.isAffiliate === 1 ||
        (Array.isArray(user.roles) && user.roles.includes('affiliate'))
      )
    );

    if (isLoggedIn) {
      if (isAffiliate && alreadyPartnerBanner) {
        alreadyPartnerBanner.classList.remove('hidden');
      }

      if (topLoginText && topLoginLink) {
        topLoginText.textContent = 'Go to Affiliate Dashboard';
        topLoginLink.setAttribute('href', '/affiliate-dashboard');
      }

      if (btnText) {
        btnText.textContent = 'Join now the affiliate program';
      }

      // Pre-fill user data
      if (user) {
        if (firstName && !firstName.value) firstName.value = user.firstName || '';
        if (lastName && !lastName.value) lastName.value = user.lastName || '';
        if (email && !email.value) email.value = user.email || '';
        if (username && !username.value) username.value = user.username || '';
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.classList.add('hidden');
      if (feedback) feedback.classList.add('hidden');

      // Password Validation
      if (pwd.value !== pwdConfirm.value) {
        showError('Passwords do not match! Please check and confirm your password.');
        pwdConfirm.focus();
        return;
      }

      if (pwd.value.length < 8) {
        showError('Password must be at least 8 characters long.');
        pwd.focus();
        return;
      }

      btnText.textContent = isLoggedIn ? 'Joining Program...' : 'Registering Account...';
      submitBtn.disabled = true;

      try {
        const headers = {
          'Content-Type': 'application/json',
          'X-Headless-Secret': '19827fe00484d444da19911adf8110ec30dc2d4e51cfe55f47a22c02d8d18d71',
        };

        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }

        const res = await fetch('https://kshithija.in/wp-json/headless/v1/auth/register-affiliate', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            firstName: firstName ? firstName.value.trim() : '',
            lastName: lastName ? lastName.value.trim() : '',
            email: email ? email.value.trim() : '',
            username: username ? username.value.trim() : '',
            password: pwd.value,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.message || 'Registration failed. Please check your information.');
        }

        // Persist authenticated session
        if (data.token) {
          localStorage.setItem('kshithija_auth_token', data.token);
        }
        if (data.user) {
          localStorage.setItem('kshithija_auth_user', JSON.stringify(data.user));
        }

        if (feedback) feedback.classList.remove('hidden');
        btnText.textContent = 'Joined Successfully! ✓';

        setTimeout(() => {
          window.location.href = '/affiliate-dashboard';
        }, 1200);

      } catch (err) {
        showError(err.message || 'Registration failed. Please try again.');
        btnText.textContent = isLoggedIn ? 'Join now the affiliate program' : 'Register as Affiliate';
        submitBtn.disabled = false;
      }
    });

    function showError(msg) {
      if (errorBox && errorMsg) {
        errorMsg.textContent = msg;
        errorBox.classList.remove('hidden');
      } else {
        alert(msg);
      }
    }
  });
</script>

