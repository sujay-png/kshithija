---
import Layout from '../layouts/Layout.astro';
import Testimonials from '@components/home/Testimonials.astro';
---

<Layout>
  <!-- Page Header Banner -->
  <div class="w-full bg-[#071911] text-white py-12 sm:py-16 px-6 text-center">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs font-semibold uppercase tracking-widest text-[#2ea843] block mb-2">
        Verified Reviews & Experiences
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-medium tracking-tight mb-3">
        What Our Community Says
      </h1>
      <p class="text-sm sm:text-base text-gray-300 max-w-xl mx-auto leading-relaxed">
        Discover real feedback from customers in Mangaluru and across India who rely on Kshithija Enterprises for chemical-free, natural wellness.
      </p>
    </div>
  </div>

  <!-- Testimonials Grid -->
  <Testimonials />
</Layout>

