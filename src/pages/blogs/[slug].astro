---
// src/pages/blogs/[slug].astro
// Backward compatibility redirect from /blogs/[slug] to /blog/[slug]
import { getAllPosts } from '../../lib/wordpress';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const targetUrl = `/blog/${slug}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={`https://kshithija.in/blog/${slug}`} />
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
    <title>Redirecting to {targetUrl}...</title>
  </head>
  <body>
    <p>Redirecting to <a href={targetUrl}>{targetUrl}</a>...</p>
  </body>
</html>
