---
// src/pages/checkout/index.astro
// Luxury Botanical Checkout Page for Kshithija Enterprises
import Layout from '../../layouts/Layout.astro';
import { COUNTRIES } from '../../data/countries';

const wpBaseUrl = (import.meta.env.PUBLIC_WP_BASE_URL || 'https://kshithija.in').replace(/\/+$/, '');
const headlessSecret = import.meta.env.PUBLIC_HEADLESS_VERIFY_SECRET || '19827fe00484d444da19911adf8110ec30dc2d4e51cfe55f47a22c02d8d18d71';
---

<Layout title="Secure Checkout - Kshithija Enterprises">
  <!-- Official Razorpay Checkout SDK for Headless Processing -->
  <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <div
    id="checkout-page-root"
    data-wp-base={wpBaseUrl}
    data-headless-secret={headlessSecret}
    class="min-h-screen bg-[#faf7f2] text-[#082213] py-8 sm:py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-7xl mx-auto">

      <!-- Breadcrumbs & Header -->
      <header class="mb-8 sm:mb-10">
        <nav aria-label="Breadcrumb" class="mb-3 text-xs text-[#55695b]">
          <ol class="flex items-center gap-2 flex-wrap">
            <li>
              <a href="/" class="hover:text-[#0c3920] transition-colors">Home</a>
            </li>
            <li class="text-[#98a89e]">/</li>
            <li>
              <a href="/products" class="hover:text-[#0c3920] transition-colors">Products</a>
            </li>
            <li class="text-[#98a89e]">/</li>
            <li class="text-[#082213] font-semibold">Checkout</li>
          </ol>
        </nav>

      
      </header>

      <!-- Empty Cart Screen (Hidden when cart has items) -->
      <section
        id="checkout-empty-state"
        class="hidden py-16 sm:py-24 text-center max-w-md mx-auto bg-white rounded-3xl border border-[#ded5c5] p-8 shadow-sm"
      >
        <div class="w-20 h-20 rounded-full bg-[#f4ede0] text-4xl flex items-center justify-center mx-auto mb-4">
          🛍️
        </div>
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#082213] mb-2">
          Your Basket is Empty
        </h2>
        <p class="text-sm text-[#55695b] mb-6 leading-relaxed">
          Looks like you haven't added any botanical formulations or wellness supplements yet.
        </p>
        <a
          href="/products"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] text-white text-sm font-semibold uppercase tracking-wider transition-all shadow-md hover:shadow-lg"
        >
          <span>Explore Natural Products</span>
          <span>&rarr;</span>
        </a>
      </section>

      <!-- Main Checkout Layout (2 Columns) -->
      <div id="checkout-main-content" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">

        <!-- LEFT COLUMN: Checkout Form (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <form id="checkout-form" class="space-y-6" onsubmit="return false;">

            <!-- STEP 1: Contact Information -->
            <section class="bg-white rounded-3xl p-6 sm:p-7 border border-[#e8dfcf] shadow-2xs">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-[#f4ede0]">
                <div class="w-8 h-8 rounded-full bg-[#082213] text-white flex items-center justify-center font-bold text-xs">
                  1
                </div>
                <div>
                  <h2 class="text-base sm:text-lg font-serif font-bold text-[#082213]">
                    Contact Information
                  </h2>
                  <p class="text-xs text-[#627568]">We will send order confirmation and dispatch updates here.</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                  <label for="cust-email" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="cust-email"
                    name="email"
                    required
                    placeholder="your.email@example.com"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-phone" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Mobile Number
                  </label>
                  <div class="flex items-center rounded-xl border border-[#ded5c5] bg-[#faf8f4] overflow-hidden focus-within:ring-2 focus-within:ring-[#164e2d] focus-within:bg-white transition-all">
                    <span class="px-3.5 py-2.5 text-xs font-semibold text-[#55695b] border-r border-[#ded5c5] bg-[#f4ede0]/50 select-none">
                      🇮🇳 +91
                    </span>
                    <input
                      type="tel"
                      id="cust-phone"
                      name="phone"
                     
                      placeholder="98765 43210"
                      pattern="[0-9]{10}"
                      class="flex-1 px-4 py-2.5 text-sm text-[#082213] bg-transparent focus:outline-none"
                    />
                  </div>
                 
                </div>
              </div>
            </section>

            <!-- STEP 2: Shipping & Delivery Address -->
            <section class="bg-white rounded-3xl p-6 sm:p-7 border border-[#e8dfcf] shadow-2xs">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-[#f4ede0]">
                <div class="w-8 h-8 rounded-full bg-[#082213] text-white flex items-center justify-center font-bold text-xs">
                  2
                </div>
                <div>
                  <h2 class="text-base sm:text-lg font-serif font-bold text-[#082213]">
                    Delivery Address
                  </h2>
                  <p class="text-xs text-[#627568]">Where should we deliver your order?</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="cust-fname" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    First Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="cust-fname"
                    name="firstName"
                    required
                    placeholder="First Name"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div>
                  <label for="cust-lname" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Last Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="cust-lname"
                    name="lastName"
                    required
                    placeholder="Last Name"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-address" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Street Address (Flat / House / Building No.) <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="cust-address"
                    name="address"
                    required
                    placeholder="House / Flat No., Apartment Name, Street Name"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-landmark" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Landmark / Area (Optional)
                  </label>
                  <input
                    type="text"
                    id="cust-landmark"
                    name="landmark"
                    placeholder="Near temple, metro station, or main road"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-country" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Country / Region <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="cust-country"
                    name="country"
                    required
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all cursor-pointer"
                  >
                    {COUNTRIES.map((c) => (
                      <option value={c.name} selected={c.code === 'IN'}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="cust-city" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    City / Town <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="cust-city"
                    name="city"
                    required
                    placeholder="e.g. Mangaluru, Bengaluru"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div>
                  <label for="cust-pincode" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    PIN Code <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="cust-pincode"
                    name="pincode"
                    required
                    placeholder="6 Digits (e.g. 575001)"
                    pattern="[0-9]{6}"
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-state" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    State <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="cust-state"
                    name="state"
                    required
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all"
                  >
                    <option value="Karnataka" selected>Karnataka</option>
                    <option value="Kerala">Kerala</option>
                    <option value="Tamil Nadu">Tamil Nadu</option>
                    <option value="Andhra Pradesh">Andhra Pradesh</option>
                    <option value="Telangana">Telangana</option>
                    <option value="Maharashtra">Maharashtra</option>
                    <option value="Goa">Goa</option>
                    <option value="Delhi">Delhi NCR</option>
                    <option value="Gujarat">Gujarat</option>
                    <option value="Rajasthan">Rajasthan</option>
                    <option value="Other">Other State in India</option>
                  </select>
                </div>

                <div class="sm:col-span-2">
                  <label for="cust-notes" class="block text-xs font-semibold text-[#082213] mb-1.5">
                    Order Notes (Optional)
                  </label>
                  <textarea
                    id="cust-notes"
                    name="notes"
                    rows="2"
                    placeholder="Notes about your order, e.g. special directions for delivery."
                    class="w-full px-4 py-2.5 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-[#082213] text-sm focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:bg-white transition-all resize-none"
                  ></textarea>
                </div>
              </div>
            </section>

            <!-- STEP 3: Payment Method Options -->
            <section class="bg-white rounded-3xl p-6 sm:p-7 border border-[#e8dfcf] shadow-2xs">
              <div class="flex items-center gap-3 mb-5 pb-3 border-b border-[#f4ede0]">
                <div id="payment-step-badge" class="w-8 h-8 rounded-full bg-[#082213] text-white flex items-center justify-center font-bold text-xs">
                  3
                </div>
                <div>
                  <h2 id="payment-section-title" class="text-base sm:text-lg font-serif font-bold text-[#082213]">
                    Payment & Order Mode
                  </h2>
                </div>
              </div>

              <!-- Payment Radio Options (Visible when order amount >= ₹1) -->
              <div id="payment-methods-container" class="space-y-3">

                <!-- OPTION A: Razorpay (UPI, GPay, PhonePe, Cards, Netbanking) -->
                <label class="payment-option relative flex items-start gap-3.5 p-4 rounded-2xl border-2 border-[#164e2d] bg-[#fcfaf7] hover:border-[#164e2d] cursor-pointer transition-all">
                  <input
                    type="radio"
                    name="paymentMethod"
                    value="razorpay"
                    checked
                    class="mt-1 text-[#164e2d] focus:ring-[#164e2d]"
                  />
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                      <span class="text-sm font-bold text-[#082213] flex items-center gap-1.5">
                        <span>Pay Online via Razorpay</span>
                        <span class="text-[10px] font-semibold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">Fast & Secure</span>
                      </span>
                    </div>
                    <p class="text-xs text-[#627568] mt-1">
                      UPI (Google Pay, PhonePe, Paytm, BHIM), Credit/Debit Cards & Net Banking.
                    </p>
                  </div>
                </label>

                <!-- OPTION B: Cash on Delivery -->
                <label class="payment-option relative flex items-start gap-3.5 p-4 rounded-2xl border border-[#ded5c5] bg-white hover:border-[#164e2d] cursor-pointer transition-all">
                  <input
                    type="radio"
                    name="paymentMethod"
                    value="cod"
                    class="mt-1 text-[#164e2d] focus:ring-[#164e2d]"
                  />
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                      <span class="text-sm font-bold text-[#082213]">
                        Cash on Delivery (COD)
                      </span>
                      <span class="text-sm">💵</span>
                    </div>
                    <p class="text-xs text-[#627568] mt-1">
                      Pay with cash or UPI QR at your doorstep upon delivery.
                    </p>
                  </div>
                </label>

                <!-- OPTION C: WhatsApp Direct Order -->
                <label class="payment-option relative flex items-start gap-3.5 p-4 rounded-2xl border border-[#ded5c5] bg-white hover:border-[#164e2d] cursor-pointer transition-all">
                  <input
                    type="radio"
                    name="paymentMethod"
                    value="whatsapp"
                    class="mt-1 text-[#164e2d] focus:ring-[#164e2d]"
                  />
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                      <span class="text-sm font-bold text-[#082213]">
                        Order via WhatsApp
                      </span>
                      <span class="text-sm text-[#25D366]">💬</span>
                    </div>
                    <p class="text-xs text-[#627568] mt-1">
                      Chat directly with our Mangaluru store team to confirm dispatch and customize orders.
                    </p>
                  </div>
                </label>

              </div>

              <!-- 100% Discount / Free Order Notice (Visible when order amount < ₹1, as in screenshot) -->
              <div id="free-order-notice" class="hidden">
                <div class="p-4 sm:p-5 rounded-lg border border-[#cbd5e1] bg-[#f8fafc] text-xs sm:text-sm text-[#1e293b] leading-relaxed shadow-2xs font-normal">
                  No payment required. A 100% discount has been applied to your order.
                </div>
              </div>

              <!-- Primary Submit CTA -->
              <div class="pt-6 mt-6 border-t border-[#f4ede0]">
                <button
                  type="button"
                  id="place-order-btn"
                  class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-[#164e2d] via-[#103e23] to-[#082213] hover:from-[#1b5e37] hover:to-[#0c3920] active:scale-[0.99] text-white font-bold text-base shadow-xl hover:shadow-2xl transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span id="btn-spinner" class="hidden animate-spin">⏳</span>
                  <span id="btn-text">Complete Order &bull; ₹0</span>
                  <span class="text-base">&rarr;</span>
                </button>

              </div>

            </section>

          </form>

        </div>

        <!-- RIGHT COLUMN: Sticky Order Summary Card (5 Cols) -->
        <div class="lg:col-span-5">
          <aside class="sticky top-24 space-y-5">
            
            <div class="bg-white rounded-l p-6 sm:p-7 border border-[#e8dfcf] shadow-sm">
              
              <div class="flex items-center justify-between pb-4 border-b border-[#f4ede0] mb-4">
                <h2 class="text-lg font-serif font-bold text-[#082213]">
                  Your Order
                </h2>
                <span id="summary-item-count" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[#f4ede0] text-[#082213]">
                  0 items
                </span>
              </div>

              <!-- Product items dynamic container -->
              <div id="checkout-items-list" class="space-y-3.5 max-h-[380px] overflow-y-auto pr-1">
                <!-- Dynamically populated via client script -->
              </div>

              <!-- Promo Code Input -->
              <div class="pt-4 mt-4 border-t border-[#f4ede0]">
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="coupon-input"
                    placeholder="Enter Coupon Code"
                    class="flex-1 px-3.5 py-2 rounded-xl border border-[#ded5c5] bg-[#faf8f4] text-xs uppercase font-medium focus:outline-none focus:ring-1 focus:ring-[#164e2d]"
                  />
                  <button
                    type="button"
                    id="apply-coupon-btn"
                    class="px-4 py-2 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] text-white text-xs font-semibold tracking-wider transition-colors cursor-pointer disabled:opacity-50"
                  >
                    Apply
                  </button>
                </div>
                <div id="coupon-message" class="hidden text-xs mt-1.5 flex items-center justify-between">
                  <span id="coupon-message-text"></span>
                  <button type="button" id="remove-coupon-btn" class="hidden text-[11px] text-red-600 hover:underline cursor-pointer font-medium ml-2">Remove</button>
                </div>
              </div>

              <!-- Price Breakdown -->
              <div class="pt-4 mt-4 border-t border-[#f4ede0] space-y-2.5 text-xs text-[#55695b]">
                <div class="flex justify-between">
                  <span>Subtotal</span>
                  <span id="summary-subtotal" class="font-bold text-[#082213]">₹0</span>
                </div>

                <div class="flex justify-between items-center">
                  <span>Shipping</span>
                  <span class="inline-flex items-center gap-1 font-bold text-[#1c643b] bg-[#eaf4ed] px-2 py-0.5 rounded-md">
                    <span>✓ FREE</span>
                  </span>
                </div>

                <div id="discount-row" class="hidden flex justify-between text-emerald-700 font-semibold">
                  <span>Discount</span>
                  <span id="summary-discount">-₹0</span>
                </div>

                <div class="pt-3 border-t border-[#ded5c5] flex justify-between items-baseline text-base font-bold text-[#082213]">
                  <span class="font-serif">Total</span>
                  <span id="summary-grand-total" class="font-serif text-2xl text-[#082213]">₹0</span>
                </div>
              </div>

            </div>

         

          </aside>
        </div>

      </div>

      <!-- SUCCESS MODAL (Hidden by default, shown upon order completion) -->
      <div
        id="order-success-modal"
        class="fixed inset-0 bg-black/60 backdrop-blur-xs z-[999999] hidden flex items-center justify-center p-4"
      >
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 text-center border border-[#ded5c5] shadow-2xl animate-in fade-in zoom-in-95 duration-200">
          <div class="w-16 h-16 rounded-full bg-[#eaf4ed] text-emerald-700 text-3xl flex items-center justify-center mx-auto mb-4">
            ✓
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#1c643b] block mb-1">Order Received</span>
          <h2 class="text-2xl font-serif font-bold text-[#082213] mb-2">
            Thank You for Your Order!
          </h2>
          <p class="text-xs sm:text-sm text-[#55695b] mb-4 leading-relaxed">
            Your order has been safely placed with Kshithija Enterprises. Our Mangaluru team is preparing your fresh botanical dispatch.
          </p>

          <div class="bg-[#faf8f4] rounded-2xl p-4 border border-[#ded5c5] mb-6 text-left text-xs space-y-1.5">
            <div class="flex justify-between">
              <span class="text-[#627568]">Order Reference:</span>
              <strong id="success-order-id" class="font-mono text-[#082213]">KSH-84920</strong>
            </div>
            <div class="flex justify-between">
              <span class="text-[#627568]">Order Amount:</span>
              <strong id="success-order-total" class="font-serif font-bold text-[#082213]">₹0</strong>
            </div>
            <div class="flex justify-between">
              <span class="text-[#627568]">Payment Mode:</span>
              <strong id="success-order-payment" class="text-[#082213]">Direct WhatsApp</strong>
            </div>
          </div>

          <div class="space-y-2.5">
           
            <a
              href="/products"
              class="block w-full py-2.5 text-center text-xs font-semibold text-[#1c643b] hover:underline"
            >
              Continue Browsing Products &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<!-- Client Script to bind live cart, calculate totals, handle coupon & complete order -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const STORAGE_KEY = 'kshithija_cart_v1';
    const rootEl = document.getElementById('checkout-page-root');
    const WP_BASE = (rootEl ? rootEl.getAttribute('data-wp-base') : 'https://kshithija.in') || 'https://kshithija.in';
    const HEADLESS_SECRET = (rootEl ? rootEl.getAttribute('data-headless-secret') : '') || '19827fe00484d444da19911adf8110ec30dc2d4e51cfe55f47a22c02d8d18d71';
    const CHECKOUT_API = WP_BASE.replace(/\/+$/, '') + '/wp-json/headless/v1/checkout';

    function getAuthHeaders(extra = {}) {
      const headers = {
        'Content-Type': 'application/json',
        'X-Headless-Secret': HEADLESS_SECRET,
        ...extra,
      };
      try {
        const token = localStorage.getItem('kshithija_auth_token');
        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }
      } catch (e) {}
      return headers;
    }

    let discountAmount = 0;
    let appliedCouponCode = null;
    let currentSubtotal = 0;
    let isVerifyingPrices = false;

    function getCart() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
      } catch (e) {}
    }

    function parsePrice(priceStr) {
      if (!priceStr) return 0;
      const clean = priceStr.toString().replace(/[^0-9.]/g, '');
      const num = parseFloat(clean);
      return isNaN(num) ? 0 : num;
    }

    // Dynamic Price Verification against WooCommerce (Single Source of Truth)
    async function verifyCartPrices() {
      if (isVerifyingPrices) return;
      const cart = getCart();
      if (!cart || cart.length === 0) return;

      isVerifyingPrices = true;
      try {
        const payloadItems = cart.map((i) => ({
          id: i.id,
          quantity: i.quantity,
          slug: i.slug || (typeof i.id === 'string' ? i.id : ''),
        }));

        const res = await fetch(`${CHECKOUT_API}/verify-cart`, {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({ items: payloadItems }),
        });

        if (res.ok) {
          const data = await res.json();
          if (data.success && Array.isArray(data.items) && data.items.length > 0) {
            let changed = false;
            cart.forEach((item) => {
              const matched = data.items.find((vi) => String(vi.id) === String(item.id) || vi.slug === item.slug || vi.slug === item.id);
              if (matched && matched.price && matched.price !== item.priceNum) {
                item.priceNum = matched.price;
                item.price = matched.price_formatted || `₹${matched.price}`;
                changed = true;
              }
            });
            if (changed) {
              saveCart(cart);
              renderCheckout(false);
            }
          }
        }
      } catch (err) {
        console.warn('WooCommerce cart verification offline/fallback:', err);
      } finally {
        isVerifyingPrices = false;
      }
    }

    function renderCheckout(triggerPriceVerify = true) {
      const cart = getCart();
      const mainContent = document.getElementById('checkout-main-content');
      const emptyState = document.getElementById('checkout-empty-state');
      const itemsList = document.getElementById('checkout-items-list');
      const itemCount = document.getElementById('summary-item-count');
      const subtotalEl = document.getElementById('summary-subtotal');
      const grandTotalEl = document.getElementById('summary-grand-total');
      const btnText = document.getElementById('btn-text');

      if (!mainContent || !emptyState) return;

      if (!cart || cart.length === 0) {
        mainContent.classList.add('hidden');
        emptyState.classList.remove('hidden');
        return;
      }

      mainContent.classList.remove('hidden');
      emptyState.classList.add('hidden');

      let subtotal = 0;
      let totalQty = 0;

      // Render product rows
      if (itemsList) {
        itemsList.innerHTML = cart
          .map((item) => {
            const unitPrice = item.priceNum || parsePrice(item.price);
            const lineTotal = unitPrice * item.quantity;
            subtotal += lineTotal;
            totalQty += item.quantity;

            return `
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-[#faf8f4] border border-[#e8dfcf]">
              <img
                src="${item.image || '/products/placeholder.webp'}"
                alt="${item.name}"
                class="w-14 h-14 rounded-xl object-cover bg-white shrink-0 border border-[#ded5c5]"
              />
              <div class="flex-1 min-w-0">
                <h4 class="text-xs font-semibold text-[#082213] truncate">${item.name}</h4>
                <p class="text-xs font-bold text-[#1c643b] mt-0.5">${item.price}</p>
                <div class="flex items-center gap-2 mt-1.5">
                  <div class="inline-flex items-center border border-[#ded5c5] rounded-md bg-white">
                    <button type="button" class="checkout-qty-btn px-2 py-0.5 text-xs font-bold text-[#082213] hover:bg-[#eee8db]" data-action="minus" data-id="${item.id}">-</button>
                    <span class="px-2 text-xs font-semibold text-[#082213]">${item.quantity}</span>
                    <button type="button" class="checkout-qty-btn px-2 py-0.5 text-xs font-bold text-[#082213] hover:bg-[#eee8db]" data-action="plus" data-id="${item.id}">+</button>
                  </div>
                  <button type="button" class="checkout-remove-btn text-[11px] text-red-600 hover:underline cursor-pointer ml-auto" data-id="${item.id}">
                    Remove
                  </button>
                </div>
              </div>
              <div class="text-xs font-bold text-[#082213] shrink-0 font-serif">
                ₹${lineTotal.toLocaleString('en-IN')}
              </div>
            </div>
          `;
          })
          .join('');
      }

      currentSubtotal = subtotal;
      
      // Strict 100% discount check: only true if discount covers 100% of subtotal
      const isHundredPercent = subtotal > 0 && (
        discountAmount >= subtotal || 
        (appliedCouponCode && (appliedCouponCode.toUpperCase().endsWith('100') || appliedCouponCode.toUpperCase() === '100%') && (subtotal - discountAmount) < 0.01)
      );

      if (isHundredPercent && subtotal > 0) {
        discountAmount = subtotal;
      }

      const finalTotal = isHundredPercent ? 0 : Math.max(0, Math.round((subtotal - discountAmount) * 100) / 100);

      const paymentMethodsContainer = document.getElementById('payment-methods-container');
      const freeOrderNotice = document.getElementById('free-order-notice');
      const paymentSectionTitle = document.getElementById('payment-section-title');
      const paymentStepBadge = document.getElementById('payment-step-badge');

      if (isHundredPercent && finalTotal <= 0) {
        // ONLY if discount is 100%: Hide payment options and show free order notice
        paymentMethodsContainer?.classList.add('hidden');
        paymentStepBadge?.classList.add('hidden');
        freeOrderNotice?.classList.remove('hidden');
        if (paymentSectionTitle) paymentSectionTitle.textContent = 'Payment';
        if (btnText) btnText.textContent = 'Place Free Order';
      } else {
        // Otherwise (discount < 100% or remaining total > 0): Show payment methods, MUST pay via Razorpay/COD
        paymentMethodsContainer?.classList.remove('hidden');
        paymentStepBadge?.classList.remove('hidden');
        freeOrderNotice?.classList.add('hidden');
        if (paymentSectionTitle) paymentSectionTitle.textContent = 'Payment & Order Mode';
        if (btnText) btnText.textContent = `Complete Order • ₹${finalTotal.toLocaleString('en-IN')}`;
      }

      if (itemCount) itemCount.textContent = `${totalQty} item${totalQty === 1 ? '' : 's'}`;
      if (subtotalEl) subtotalEl.textContent = `₹${subtotal.toLocaleString('en-IN')}`;
      if (grandTotalEl) grandTotalEl.textContent = `₹${finalTotal.toLocaleString('en-IN')}`;

      if (triggerPriceVerify) {
        verifyCartPrices();
      }
    }

    // Live quantity Stepper & Remove Item delegation
    const itemsContainer = document.getElementById('checkout-items-list');
    if (itemsContainer) {
      itemsContainer.addEventListener('click', (e) => {
        const target = e.target;
        const cart = getCart();

        if (target.classList.contains('checkout-qty-btn')) {
          const id = target.getAttribute('data-id');
          const action = target.getAttribute('data-action');
          const item = cart.find((i) => String(i.id) === String(id));
          if (item) {
            item.quantity += action === 'plus' ? 1 : -1;
            if (item.quantity <= 0) {
              const updated = cart.filter((i) => String(i.id) !== String(id));
              saveCart(updated);
            } else {
              saveCart(cart);
            }
            if (appliedCouponCode) {
              revalidateCoupon();
            } else {
              renderCheckout();
            }
          }
        } else if (target.classList.contains('checkout-remove-btn')) {
          const id = target.getAttribute('data-id');
          const updated = cart.filter((i) => String(i.id) !== String(id));
          saveCart(updated);
          if (appliedCouponCode) {
            revalidateCoupon();
          } else {
            renderCheckout();
          }
        }
      });
    }

    // Dynamic Coupon Code Handling with WooCommerce as Single Source of Truth
    const couponInput = document.getElementById('coupon-input');
    const applyCouponBtn = document.getElementById('apply-coupon-btn');
    const couponMsg = document.getElementById('coupon-message');
    const couponMsgText = document.getElementById('coupon-message-text');
    const removeCouponBtn = document.getElementById('remove-coupon-btn');
    const discountRow = document.getElementById('discount-row');
    const discountEl = document.getElementById('summary-discount');

    async function applyCoupon(codeToApply) {
      const code = (codeToApply || couponInput?.value || '').trim().toUpperCase();
      if (!code) return;

      if (applyCouponBtn) {
        applyCouponBtn.disabled = true;
        applyCouponBtn.textContent = 'Checking...';
      }

      const cart = getCart();
      const subtotal = cart.reduce((acc, i) => acc + (i.priceNum || parsePrice(i.price)) * i.quantity, 0);

      try {
        const payloadItems = cart.map((i) => ({
          id: i.id,
          slug: i.slug || (typeof i.id === 'string' ? i.id : ''),
          quantity: i.quantity,
        }));

        const res = await fetch(`${CHECKOUT_API}/apply-coupon`, {
          method: 'POST',
          headers: getAuthHeaders(),
          body: JSON.stringify({ code, items: payloadItems, subtotal }),
        });

        const data = await res.json();

        if (data.success) {
          appliedCouponCode = data.code || code;
          const couponAmountNum = Number(data.coupon_amount || 0);
          const isPercent100 = data.discount_type === 'percent' && couponAmountNum >= 100;
          const isFixedCoverAll = (Number(data.discount_amount || 0) >= subtotal) || (data.new_total !== undefined && Number(data.new_total) === 0);
          const is100Percent = subtotal > 0 && (isPercent100 || isFixedCoverAll);

          if (is100Percent) {
            discountAmount = subtotal;
          } else {
            discountAmount = Number(data.discount_amount || 0);
          }

          if (couponInput) couponInput.value = appliedCouponCode;
          sessionStorage.setItem('kshithija_applied_coupon', appliedCouponCode);

          if (couponMsgText) {
            if (is100Percent) {
              couponMsgText.textContent = `✓ Coupon "${appliedCouponCode}" applied! (100% Off - ₹${subtotal.toLocaleString('en-IN')} saved) (Free Order)`;
            } else {
              couponMsgText.textContent = `✓ ${data.message} (${data.description || 'Discount Applied'})`;
            }
          }
          if (couponMsg) {
            couponMsg.className = 'text-xs mt-1.5 flex items-center justify-between text-emerald-700 font-semibold';
            couponMsg.classList.remove('hidden');
          }
          if (removeCouponBtn) removeCouponBtn.classList.remove('hidden');
          if (discountRow) discountRow.classList.remove('hidden');
          if (discountEl) discountEl.textContent = `-${is100Percent ? '₹' + subtotal.toLocaleString('en-IN') : (data.discount_formatted || '₹' + discountAmount)}`;
        } else {
          discountAmount = 0;
          appliedCouponCode = null;
          sessionStorage.removeItem('kshithija_applied_coupon');
          if (couponMsgText) couponMsgText.textContent = data.message || 'Invalid coupon code.';
          if (couponMsg) {
            couponMsg.className = 'text-xs mt-1.5 flex items-center justify-between text-red-600 font-medium';
            couponMsg.classList.remove('hidden');
          }
          if (removeCouponBtn) removeCouponBtn.classList.add('hidden');
          if (discountRow) discountRow.classList.add('hidden');
        }
      } catch (err) {
        discountAmount = 0;
        appliedCouponCode = null;
        sessionStorage.removeItem('kshithija_applied_coupon');
        if (couponMsgText) couponMsgText.textContent = 'Unable to apply coupon. Please verify your connection.';
        if (couponMsg) {
          couponMsg.className = 'text-xs mt-1.5 flex items-center justify-between text-red-600 font-medium';
          couponMsg.classList.remove('hidden');
        }
      } finally {
        if (applyCouponBtn) {
          applyCouponBtn.disabled = false;
          applyCouponBtn.textContent = 'Apply';
        }
        renderCheckout(false);
      }
    }

    function revalidateCoupon() {
      if (appliedCouponCode) {
        applyCoupon(appliedCouponCode);
      }
    }

    if (applyCouponBtn && couponInput) {
      applyCouponBtn.addEventListener('click', () => applyCoupon());
      couponInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyCoupon();
        }
      });
    }

    if (removeCouponBtn) {
      removeCouponBtn.addEventListener('click', () => {
        discountAmount = 0;
        appliedCouponCode = null;
        sessionStorage.removeItem('kshithija_applied_coupon');
        if (couponInput) couponInput.value = '';
        if (couponMsg) couponMsg.classList.add('hidden');
        if (removeCouponBtn) removeCouponBtn.classList.add('hidden');
        if (discountRow) discountRow.classList.add('hidden');
        renderCheckout(false);
      });
    }

    // Handle Complete Order Button Click
    const placeOrderBtn = document.getElementById('place-order-btn');
    if (placeOrderBtn) {
      placeOrderBtn.addEventListener('click', async (e) => {
        e.preventDefault();

        // Validate required fields
        const email = document.getElementById('cust-email')?.value.trim();
        const phone = document.getElementById('cust-phone')?.value.trim();
        const country = document.getElementById('cust-country')?.value?.trim() || 'India';
        const fname = document.getElementById('cust-fname')?.value.trim();
        const lname = document.getElementById('cust-lname')?.value.trim();
        const address = document.getElementById('cust-address')?.value.trim();
        const landmark = document.getElementById('cust-landmark')?.value.trim();
        const city = document.getElementById('cust-city')?.value.trim();
        const pincode = document.getElementById('cust-pincode')?.value.trim();
        const state = document.getElementById('cust-state')?.value || 'Karnataka';
        const notes = document.getElementById('cust-notes')?.value.trim() || 'None';
        const paymentMethodEl = document.querySelector('input[name="paymentMethod"]:checked');
        const calculatedFinalTotal = Math.max(0, Math.round((currentSubtotal - discountAmount) * 100) / 100);
        const isFullDiscountOrder = currentSubtotal > 0 && discountAmount >= currentSubtotal && calculatedFinalTotal <= 0;
        const paymentMethod = isFullDiscountOrder ? 'free' : (paymentMethodEl ? paymentMethodEl.value : 'razorpay');

        if (!email || !phone || !fname || !lname || !address || !city || !pincode || !country) {
          alert('Please fill in all required shipping and contact fields marked with *');
          return;
        }

        const cart = getCart();
        if (cart.length === 0) {
          alert('Your cart is empty. Please add items before checking out.');
          return;
        }

        // Button Loading State
        const btnSpinner = document.getElementById('btn-spinner');
        const btnText = document.getElementById('btn-text');
        placeOrderBtn.disabled = true;
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Securing your order...';

        const resetOrderBtn = () => {
          placeOrderBtn.disabled = false;
          if (btnSpinner) btnSpinner.classList.add('hidden');
          renderCheckout(false);
        };

        const fullStreetAddress = landmark ? `${address}, Near ${landmark}` : address;

        // Unique key per checkout attempt
        const idempotencyKey = 'ksh_idem_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);

        try {
          // Resolve customer ID if signed in
          let customerId = 0;
          try {
            const userRaw = localStorage.getItem('kshithija_auth_user');
            if (userRaw) {
              const u = JSON.parse(userRaw);
              if (u && u.id) customerId = Number(u.id);
            }
          } catch (e) {}

          // 1. Create Real Order in WordPress WooCommerce (WP as single source of truth, Idempotent)
          const orderPayload = {
            idempotency_key: idempotencyKey,
            customer_id: customerId,
            billing: {
              first_name: fname,
              last_name: lname,
              email: email,
              phone: phone,
              address_1: fullStreetAddress,
              city: city,
              state: state,
              postcode: pincode,
              country: country,
            },
            shipping: {
              first_name: fname,
              last_name: lname,
              address_1: fullStreetAddress,
              city: city,
              state: state,
              postcode: pincode,
              country: country,
            },
            items: cart.map((i) => ({
              id: i.id,
              slug: i.slug || (typeof i.id === 'string' ? i.id : ''),
              quantity: i.quantity,
            })),
            coupon_code: appliedCouponCode || '',
            payment_method: paymentMethod,
            customer_notes: notes !== 'None' ? notes : '',
          };

          const orderRes = await fetch(`${CHECKOUT_API}/create-order`, {
            method: 'POST',
            headers: getAuthHeaders({ 'X-Idempotency-Key': idempotencyKey }),
            body: JSON.stringify(orderPayload),
          });

          let orderData = null;
          try {
            orderData = await orderRes.json();
          } catch (jsonErr) {
            console.error('Non-JSON order response:', jsonErr);
          }

          if (!orderRes.ok || !orderData || !orderData.success || !orderData.order_id) {
            const errorMsg = (orderData && (orderData.message || orderData.code)) || 
              `Unable to place order (Server responded with status ${orderRes.status}). Please check your connection and WordPress Snippets.`;
            alert(errorMsg);
            resetOrderBtn();
            return;
          }

          const orderIdNum = orderData.order_id;
          const orderRef = 'KSH-' + orderIdNum;
          const finalTotal = isFullDiscountOrder ? 0 : (Number(orderData.total) || Math.max(0, currentSubtotal - discountAmount));

          // 2. Handle Selected Payment Method
          // ONLY if discount is 100% and total is 0 does it bypass Razorpay! Otherwise it must NOT bypass!
          if (paymentMethod === 'free' && finalTotal <= 0) {
            if (btnText) btnText.textContent = 'Completing free order...';
            try {
              await fetch(`${CHECKOUT_API}/verify-payment`, {
                method: 'POST',
                headers: getAuthHeaders(),
                body: JSON.stringify({
                  order_id: orderIdNum,
                  bypassed: true,
                }),
              });
            } catch (bErr) {
              console.warn('Payment bypass sync:', bErr);
            }

            showSuccessModal(orderRef, 0, 'Order Placed (100% Discounted)');
            localStorage.removeItem(STORAGE_KEY);
            resetOrderBtn();
            return;
          }

          if (paymentMethod === 'razorpay') {
            if (btnText) btnText.textContent = 'Initializing secure payment...';

            const rzpRes = await fetch(`${CHECKOUT_API}/create-razorpay-order`, {
              method: 'POST',
              headers: getAuthHeaders(),
              body: JSON.stringify({
                order_id: orderIdNum,
                amount: Math.round(finalTotal * 100),
              }),
            });

            const rzpOrder = await rzpRes.json();

            if (!rzpRes.ok || !rzpOrder.success || !rzpOrder.razorpay_key_id) {
              alert(rzpOrder.message || 'Payment initialization failed. Please check gateway configuration or choose Cash on Delivery.');
              resetOrderBtn();
              return;
            }

            if (!window.Razorpay) {
              alert('Payment gateway SDK is loading. Please check your network and refresh.');
              resetOrderBtn();
              return;
            }

            const rzpOptions = {
              key: rzpOrder.razorpay_key_id,
              amount: rzpOrder.amount || Math.round(finalTotal * 100),
              currency: rzpOrder.currency || 'INR',
              name: 'Kshithija Enterprises',
              description: `Order #${orderRef}`,
              image: '/images/logo.png',
              order_id: rzpOrder.razorpay_order_id,
              prefill: {
                name: `${fname} ${lname}`,
                email: email,
                contact: phone,
              },
              theme: {
                color: '#164e2d',
              },
              config: {
                display: {
                  blocks: {
                    upi_qr: {
                      name: 'UPI / QR Code (GPay, PhonePe, Paytm, BHIM)',
                      instruments: [
                        {
                          method: 'upi',
                          flows: ['qr', 'collect', 'intent'],
                        },
                      ],
                    },
                    other: {
                      name: 'Cards, Netbanking & Wallets',
                      instruments: [
                        { method: 'card' },
                        { method: 'netbanking' },
                        { method: 'wallet' },
                      ],
                    },
                  },
                  sequence: ['block.upi_qr', 'block.other'],
                  preferences: {
                    show_default_blocks: true,
                  },
                },
              },
              modal: {
                ondismiss: function () {
                  resetOrderBtn();
                  alert(`Payment was closed. Your order #${orderRef} has been recorded.`);
                },
              },
              handler: async function (response) {
                if (btnText) btnText.textContent = 'Verifying payment...';
                try {
                  await fetch(`${CHECKOUT_API}/verify-payment`, {
                    method: 'POST',
                    headers: getAuthHeaders(),
                    body: JSON.stringify({
                      order_id: orderIdNum,
                      razorpay_order_id: response.razorpay_order_id,
                      razorpay_payment_id: response.razorpay_payment_id,
                      razorpay_signature: response.razorpay_signature,
                    }),
                  });
                } catch (vErr) {
                  console.warn('Payment verification network log:', vErr);
                }

                // Show success modal, reset idempotency key, & clear cart
                window.__ksh_checkout_idem_key = null;
                showSuccessModal(orderRef, finalTotal, 'Razorpay (Paid Online)');
                localStorage.removeItem(STORAGE_KEY);
                resetOrderBtn();
              },
            };

            const rzp = new window.Razorpay(rzpOptions);
            rzp.on('payment.failed', function (resp) {
              console.error('Razorpay payment failed:', resp.error);
              alert(resp.error?.description || 'Payment was declined or failed. Please try again.');
              resetOrderBtn();
            });
            rzp.open();
            return;
          } else if (paymentMethod === 'cod') {
            window.__ksh_checkout_idem_key = null;
            showSuccessModal(orderRef, finalTotal, 'Cash on Delivery');
            localStorage.removeItem(STORAGE_KEY);
            resetOrderBtn();
          } else {
            // WhatsApp Order
            const itemsList = cart.map((i, idx) => {
              const itemPrice = (i.priceNum || parsePrice(i.price)) * i.quantity;
              return `${idx + 1}. ${i.name} x ${i.quantity} (₹${itemPrice})`;
            }).join('%0A');

            const waText = 
              `*New Order: ${orderRef}*%0A` +
              `------------------------------%0A` +
              `*Customer:* ${encodeURIComponent(fname + ' ' + lname)}%0A` +
              `*Phone:* +91 ${encodeURIComponent(phone)}%0A` +
              `*Email:* ${encodeURIComponent(email)}%0A%0A` +
              `*Delivery Address:*%0A${encodeURIComponent(fullStreetAddress)}, ${encodeURIComponent(city)}, ${encodeURIComponent(state)}, ${encodeURIComponent(country)} - ${encodeURIComponent(pincode)}%0A` +
              `*Special Notes:* ${encodeURIComponent(notes)}%0A%0A` +
              `*Ordered Items:*%0A${itemsList}%0A%0A` +
              `*Payment Mode:* WHATSAPP ORDER%0A` +
              `*Total Payable:* ₹${finalTotal.toLocaleString('en-IN')}%0A` +
              `------------------------------%0A` +
              `Please confirm order dispatch from Mangaluru store.`;

            const waLink = `https://wa.me/919482126493?text=${waText}`;
            window.open(waLink, '_blank');
            window.__ksh_checkout_idem_key = null;
            showSuccessModal(orderRef, finalTotal, 'WhatsApp Order');
            localStorage.removeItem(STORAGE_KEY);
            resetOrderBtn();
          }

        } catch (submitErr) {
          console.error('Order submission error:', submitErr);
          alert(submitErr?.message || 'An error occurred while placing your order. Please try again.');
          resetOrderBtn();
        }
      });
    }

    function showSuccessModal(orderRef, total, paymentLabel) {
      const successModal = document.getElementById('order-success-modal');
      const successId = document.getElementById('success-order-id');
      const successTotal = document.getElementById('success-order-total');
      const successPay = document.getElementById('success-order-payment');
      const successWaBtn = document.getElementById('success-whatsapp-btn');

      if (successId) successId.textContent = orderRef;
      if (successTotal) successTotal.textContent = `₹${total.toLocaleString('en-IN')}`;
      if (successPay) successPay.textContent = paymentLabel;
      if (successWaBtn) {
        successWaBtn.href = `https://wa.me/919482126493?text=Hi%20Kshithija%2C%20I%20have%20placed%20order%20${orderRef}%20for%20%E2%82%B9${total}.%20Please%20confirm%20dispatch.`;
      }

      if (successModal) successModal.classList.remove('hidden');
    }

    // Autofill logged-in customer info if available
    try {
      const storedUserRaw = localStorage.getItem('kshithija_auth_user');
      if (storedUserRaw) {
        const user = JSON.parse(storedUserRaw);
        const emailEl = document.getElementById('cust-email');
        const fnameEl = document.getElementById('cust-fname');
        const lnameEl = document.getElementById('cust-lname');
        if (emailEl && !emailEl.value && user.email) emailEl.value = user.email;
        if (fnameEl && !fnameEl.value && user.firstName) fnameEl.value = user.firstName;
        if (lnameEl && !lnameEl.value && user.lastName) lnameEl.value = user.lastName;
      }
    } catch (e) {}

    // Initial render
    renderCheckout();

    // Auto-apply saved coupon from Cart page if present
    const savedCoupon = sessionStorage.getItem('kshithija_applied_coupon');
    if (savedCoupon) {
      if (couponInput) couponInput.value = savedCoupon;
      applyCoupon(savedCoupon);
    }
  });
</script>

