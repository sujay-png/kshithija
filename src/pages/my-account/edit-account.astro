---
// src/pages/my-account/edit-account.astro
// Dedicated Account Details Page for Kshithija Enterprises in Light Mode
// Replicates WooCommerce /my-account/edit-account/
import Layout from '../../layouts/Layout.astro';
import AccountSidebar from '../../components/AccountSidebar.astro';
---

<Layout title="Account Details - Kshithija Enterprises">
  
  <main class="min-h-screen bg-[#f8fafc] text-[#082213] py-8 sm:py-12 px-4 sm:px-6 lg:px-8 relative">
    
    <div class="max-w-7xl mx-auto">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-[#64748b]">
        <ol class="inline-flex items-center gap-2">
          <li><a href="/" class="hover:text-[#0c3920] transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/orders" class="hover:text-[#0c3920] transition-colors">My account</a></li>
          <li>/</li>
          <li class="font-semibold text-[#082213]" aria-current="page">Account details</li>
        </ol>
      </nav>

      <!-- Main Layout: Sidebar (exact Flowbite design) + Account Details Form -->
      <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-start">
        
        <!-- Persistent Sidebar with 'favorites' (Account Details) active -->
        <AccountSidebar activeItem="favorites" />

        <!-- Right Content Section: Account Details Form -->
        <div class="flex-1 w-full min-w-0 space-y-6">
          
          <!-- Not Logged In State -->
          <div id="state-not-logged-in" class="hidden bg-white rounded-3xl border border-[#cbd5e1] py-16 text-center text-[#64748b] shadow-xs">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#f1f5f9] border border-[#e2e8f0] flex items-center justify-center text-2xl">
              🔒
            </div>
            <h3 class="text-base font-bold text-[#082213] mb-1">Sign in to edit your account details</h3>
            <p class="text-xs text-[#64748b] max-w-sm mx-auto mb-5 leading-relaxed">
              Log in with your Kshithija customer credentials to manage your personal profile information and change your password.
            </p>
            <a
              href="/login?redirect=/my-account/edit-account"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs font-semibold transition shadow-xs cursor-pointer"
            >
              <span>Sign In to Your Account</span>
              <span>→</span>
            </a>
          </div>

          <!-- Loading State -->
          <div id="state-loading" class="bg-white rounded-3xl border border-[#cbd5e1] py-16 text-center text-[#64748b] shadow-xs">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-2 border-[#0c3920] border-t-transparent mb-3"></div>
            <p class="text-xs font-semibold text-[#082213]">Loading account details</p>
          </div>

          <!-- Account Details Container (Matches WooCommerce /my-account/edit-account/) -->
          <div id="account-details-container" class="hidden space-y-6">
            
            <!-- Top Header Card -->
            <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#cbd5e1] shadow-xs">
              <h1 class="text-xl sm:text-2xl font-bold text-[#082213] tracking-tight">
                Account details
              </h1>
              <p class="text-xs text-[#64748b] mt-1.5 leading-relaxed">
                Manage your personal profile information, display name, and password.
              </p>
            </div>

            <!-- Dynamic Alert / Notice Box (For Errors or Success) -->
            <div id="form-alert" class="hidden rounded-2xl p-4 text-xs font-medium border flex items-start gap-3 transition-all">
              <span id="alert-icon" class="text-base shrink-0">ℹ️</span>
              <div class="flex-1 min-w-0" id="alert-message">Notice message</div>
              <button type="button" id="btn-close-alert" class="text-gray-400 hover:text-gray-700 p-0.5 cursor-pointer">✕</button>
            </div>

            <!-- Edit Account Form Card -->
            <div class="bg-white rounded-3xl border border-[#cbd5e1] p-6 sm:p-8 shadow-xs">
              
              <form id="form-edit-account" class="space-y-6 text-xs sm:text-sm" novalidate>
                
                <!-- SECTION 1: Personal Profile Fields -->
                <div class="space-y-4">
                  <h2 class="text-sm font-bold text-[#082213] uppercase tracking-wider text-[11px] pb-2 border-b border-[#e2e8f0]">
                    Personal Information
                  </h2>

                  <!-- First Name & Last Name -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <label for="account_first_name" class="block font-bold text-[#082213] mb-1.5 text-xs">
                        First name <span class="text-red-500">*</span>
                      </label>
                      <input
                        type="text"
                        id="account_first_name"
                        name="account_first_name"
                        autocomplete="given-name"
                        required
                        placeholder="e.g. Adithya"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                      />
                    </div>

                    <div>
                      <label for="account_last_name" class="block font-bold text-[#082213] mb-1.5 text-xs">
                        Last name <span class="text-red-500">*</span>
                      </label>
                      <input
                        type="text"
                        id="account_last_name"
                        name="account_last_name"
                        autocomplete="family-name"
                        required
                        placeholder="e.g. Puthraya"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                      />
                    </div>
                  </div>

                  <!-- Display Name -->
                  <div>
                    <label for="account_display_name" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Display name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="account_display_name"
                      name="account_display_name"
                      required
                      placeholder="e.g. Adithya Puthraya"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                    <p class="text-[11px] text-[#64748b] italic mt-1.5 leading-relaxed">
                      This will be how your name will be displayed in the account section and in reviews
                    </p>
                  </div>

                  <!-- Email Address -->
                  <div>
                    <label for="account_email" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Email address <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="email"
                      id="account_email"
                      name="account_email"
                      autocomplete="email"
                      required
                      placeholder="e.g. name@example.com"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                    />
                  </div>
                </div>

                <!-- SECTION 2: Password Change Fieldset -->
                <fieldset class="pt-6 border-t border-[#e2e8f0] space-y-4">
                  <div>
                    <legend class="text-base sm:text-lg font-bold text-[#082213] tracking-tight">
                      Password change
                    </legend>
                    <p class="text-xs text-[#64748b] mt-0.5">
                      Leave all password fields blank if you do not wish to change your current password.
                    </p>
                  </div>

                  <!-- Current Password -->
                  <div>
                    <label for="password_current" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Current password <span class="text-[#94a3b8] font-normal">(leave blank to leave unchanged)</span>
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="password_current"
                        name="password_current"
                        autocomplete="current-password"
                        placeholder="Enter current password"
                        class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                      />
                      <button
                        type="button"
                        class="btn-toggle-pwd absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-xs cursor-pointer select-none"
                        data-target="password_current"
                        aria-label="Toggle password visibility"
                      >
                        👁️
                      </button>
                    </div>
                  </div>

                  <!-- New Password -->
                  <div>
                    <label for="password_1" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      New password <span class="text-[#94a3b8] font-normal">(leave blank to leave unchanged)</span>
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="password_1"
                        name="password_1"
                        autocomplete="new-password"
                        minlength="6"
                        placeholder="At least 6 characters"
                        class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                      />
                      <button
                        type="button"
                        class="btn-toggle-pwd absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-xs cursor-pointer select-none"
                        data-target="password_1"
                        aria-label="Toggle password visibility"
                      >
                        👁️
                      </button>
                    </div>
                  </div>

                  <!-- Confirm New Password -->
                  <div>
                    <label for="password_2" class="block font-bold text-[#082213] mb-1.5 text-xs">
                      Confirm new password
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="password_2"
                        name="password_2"
                        autocomplete="new-password"
                        placeholder="Confirm new password"
                        class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm text-[#082213] bg-white focus:outline-none focus:ring-2 focus:ring-[#0c3920]/20 focus:border-[#0c3920] transition"
                      />
                      <button
                        type="button"
                        class="btn-toggle-pwd absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1 text-xs cursor-pointer select-none"
                        data-target="password_2"
                        aria-label="Toggle password visibility"
                      >
                        👁️
                      </button>
                    </div>
                  </div>
                </fieldset>

                <!-- SECTION 3: Action Buttons -->
                <div class="pt-6 border-t border-[#e2e8f0] flex flex-wrap items-center justify-start gap-3">
                  <button
                    type="submit"
                    id="btn-save-account"
                    class="px-6 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] active:scale-95 text-white text-xs sm:text-sm font-bold transition-all shadow-xs cursor-pointer flex items-center gap-2"
                  >
                    <span>Save changes</span>
                  </button>
                  <button
                    type="button"
                    id="btn-reset-form"
                    class="px-5 py-2.5 rounded-xl border border-[#cbd5e1] text-xs sm:text-sm font-semibold text-[#64748b] hover:bg-[#f1f5f9] hover:text-[#082213] transition cursor-pointer"
                  >
                    Reset
                  </button>
                </div>

              </form>

            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- Toast Notification -->
    <div
      id="toast"
      class="fixed bottom-6 right-6 z-50 bg-[#082213] text-white px-5 py-3 rounded-2xl shadow-2xl border border-emerald-500/30 flex items-center gap-3 text-xs font-semibold translate-y-24 opacity-0 transition-all duration-300 pointer-events-none"
    >
      <span class="text-emerald-400 text-base">✓</span>
      <span id="toast-text">Account details saved successfully!</span>
    </div>

  </main>

</Layout>

<script>
  import { getCustomerProfile, updateCustomerProfile, getStoredToken, getStoredUser } from '../../lib/auth';

  document.addEventListener('DOMContentLoaded', async () => {
    const stateLoading = document.getElementById('state-loading');
    const stateNotLoggedIn = document.getElementById('state-not-logged-in');
    const container = document.getElementById('account-details-container');
    const form = document.getElementById('form-edit-account') as HTMLFormElement;
    const saveBtn = document.getElementById('btn-save-account') as HTMLButtonElement;
    const resetBtn = document.getElementById('btn-reset-form');

    // Inputs
    const inputFirstName = document.getElementById('account_first_name') as HTMLInputElement;
    const inputLastName = document.getElementById('account_last_name') as HTMLInputElement;
    const inputDisplayName = document.getElementById('account_display_name') as HTMLInputElement;
    const inputEmail = document.getElementById('account_email') as HTMLInputElement;
    const inputCurrPass = document.getElementById('password_current') as HTMLInputElement;
    const inputNewPass = document.getElementById('password_1') as HTMLInputElement;
    const inputConfirmPass = document.getElementById('password_2') as HTMLInputElement;

    // Alert
    const alertBox = document.getElementById('form-alert');
    const alertMsg = document.getElementById('alert-message');
    const alertIcon = document.getElementById('alert-icon');
    const alertCloseBtn = document.getElementById('btn-close-alert');

    // Toast
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');

    let loadedProfile: any = null;

    function showAlert(type: 'success' | 'error', message: string) {
      if (!alertBox || !alertMsg || !alertIcon) return;
      alertMsg.textContent = message;
      if (type === 'success') {
        alertBox.className = 'rounded-2xl p-4 text-xs font-medium border flex items-start gap-3 bg-[#f0fdf4] text-[#166534] border-[#bbf7d0]';
        alertIcon.textContent = '✓';
      } else {
        alertBox.className = 'rounded-2xl p-4 text-xs font-medium border flex items-start gap-3 bg-[#fef2f2] text-[#991b1b] border-[#fecaca]';
        alertIcon.textContent = '⚠️';
      }
      alertBox.classList.remove('hidden');
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideAlert() {
      alertBox?.classList.add('hidden');
    }

    alertCloseBtn?.addEventListener('click', hideAlert);

    function showToast(msg: string) {
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('translate-y-24', 'opacity-0');
        setTimeout(() => toast.classList.add('translate-y-24', 'opacity-0'), 3000);
      }
    }

    // Toggle password visibility
    document.querySelectorAll('.btn-toggle-pwd').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetInput = document.getElementById(targetId) as HTMLInputElement;
        if (!targetInput) return;

        if (targetInput.type === 'password') {
          targetInput.type = 'text';
          btn.textContent = '🙈';
        } else {
          targetInput.type = 'password';
          btn.textContent = '👁️';
        }
      });
    });

    /**
     * Populate form fields from profile data
     */
    function populateForm(profile: any, user: any) {
      inputFirstName.value = profile?.firstName || user?.firstName || '';
      inputLastName.value = profile?.lastName || user?.lastName || '';
      inputDisplayName.value = profile?.displayName || user?.displayName || user?.firstName || '';
      inputEmail.value = profile?.email || user?.email || '';

      inputCurrPass.value = '';
      inputNewPass.value = '';
      inputConfirmPass.value = '';
    }

    // Reset button handler
    resetBtn?.addEventListener('click', () => {
      hideAlert();
      const user = getStoredUser();
      populateForm(loadedProfile, user);
      showToast('Form reset to saved profile values.');
    });

    /**
     * Initial Load: Fetch profile from WordPress
     */
    async function loadAccountDetails() {
      const token = getStoredToken();
      const user = getStoredUser();

      if (!token) {
        stateLoading?.classList.add('hidden');
        container?.classList.add('hidden');
        stateNotLoggedIn?.classList.remove('hidden');
        return;
      }

      stateNotLoggedIn?.classList.add('hidden');
      stateLoading?.classList.remove('hidden');
      container?.classList.add('hidden');

      try {
        const profile = await getCustomerProfile();
        loadedProfile = profile;
        populateForm(profile, user);

        stateLoading?.classList.add('hidden');
        container?.classList.remove('hidden');
      } catch (err) {
        console.error('Failed to load profile:', err);
        // Fallback to local stored user
        populateForm(null, user);
        stateLoading?.classList.add('hidden');
        container?.classList.remove('hidden');
      }
    }

    await loadAccountDetails();

    /**
     * Form Submission: Update Account Details in WordPress
     */
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const firstName = inputFirstName.value.trim();
      const lastName = inputLastName.value.trim();
      const displayName = inputDisplayName.value.trim();
      const email = inputEmail.value.trim();
      const currentPassword = inputCurrPass.value;
      const newPassword = inputNewPass.value;
      const confirmPassword = inputConfirmPass.value;

      // 1. Validation
      if (!firstName || !lastName || !displayName || !email) {
        showAlert('error', 'Please fill in all required fields (First name, Last name, Display name, Email).');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showAlert('error', 'Please enter a valid email address.');
        return;
      }

      // Password change validations
      if (newPassword || confirmPassword || currentPassword) {
        if (!currentPassword) {
          showAlert('error', 'Please enter your current password to set a new password.');
          inputCurrPass.focus();
          return;
        }

        if (newPassword.length < 6) {
          showAlert('error', 'Your new password must be at least 6 characters long.');
          inputNewPass.focus();
          return;
        }

        if (newPassword !== confirmPassword) {
          showAlert('error', 'New passwords do not match. Please verify both new password fields.');
          inputConfirmPass.focus();
          return;
        }
      }

      // 2. Submit to WordPress
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = `
          <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
          <span>Saving to WordPress...</span>
        `;
      }

      try {
        const payload: any = {
          firstName,
          lastName,
          displayName,
          email,
        };

        if (newPassword) {
          payload.currentPassword = currentPassword;
          payload.newPassword = newPassword;
        }

        const res = await updateCustomerProfile(payload);

        // Update local stored user
        const storedUser = getStoredUser() || {};
        const updatedUser = {
          ...storedUser,
          firstName,
          lastName,
          displayName,
          email,
        };
        localStorage.setItem('kshithija_auth_user', JSON.stringify(updatedUser));

        // Update cached profile
        if (loadedProfile) {
          loadedProfile.firstName = firstName;
          loadedProfile.lastName = lastName;
          loadedProfile.displayName = displayName;
          loadedProfile.email = email;
        }

        // Clear password fields
        inputCurrPass.value = '';
        inputNewPass.value = '';
        inputConfirmPass.value = '';

        // Notify app
        window.dispatchEvent(
          new CustomEvent('auth:state-change', {
            detail: { loggedIn: true, user: updatedUser },
          })
        );

        // Update sidebar elements if present on page
        const sidebarName = document.getElementById('sidebar-name');
        const sidebarEmail = document.getElementById('sidebar-email');
        if (sidebarName) sidebarName.textContent = displayName;
        if (sidebarEmail) sidebarEmail.textContent = email;

        showAlert('success', res.message || 'Account details changed successfully.');
        showToast('Account details changed successfully.');
      } catch (err: any) {
        console.error('Failed to update account:', err);
        showAlert('error', err.message || 'Failed to update account details. Please check your credentials.');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `<span>Save changes</span>`;
        }
      }
    });

  });
</script>

