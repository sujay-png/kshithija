---
// src/components/Products/Hero.astro
import { productsHeroData } from '../../data/products';

const purityStandards = [
  'No Parabens',
  'No Synthetic Preservatives',
  'Lab Tested',
  'No Petroleum Jelly',
  'All Skin Types',
];
---

<section 
  id="products-hero-carousel" 
  class="relative w-full h-[520px] sm:h-[560px] lg:h-[600px] overflow-hidden bg-[#eee8dc]"
>
  <!-- Background Carousel Slides -->
  <div class="absolute inset-0 w-full h-full">
    {productsHeroData.slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={slide.alt}
          class="w-full h-full object-cover object-center"
          onerror={`if(this.src !== '${slide.fallbackImage}') { this.src = '${slide.fallbackImage}'; }`}
        />
      </div>
    ))}
  </div>

  <!-- Warm Cream & Gradient Overlay: Ensures crystal-clear text readability on left while revealing the botanical imagery on the right -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#eee8dc] via-[#eee8dc]/90 via-55% to-[#eee8dc]/20 sm:to-transparent pointer-events-none z-15"></div>
  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#eee8dc]/70 to-transparent pointer-events-none z-15"></div>

  <!-- Content Layer: Positioned Above Background Carousel -->
  <div class="relative z-20 max-w-7xl mx-auto h-full flex items-center px-4 sm:px-8 lg:px-16">
    <div class="w-full max-w-xl text-left">
      
      <!-- Eyebrow text -->
      <span class="text-xs sm:text-[13px] text-[#485c50] tracking-wide font-normal mb-3 block">
        {productsHeroData.eyebrow}
      </span>

      <!-- Main Headline (Matching image typography) -->
      <h1 class="text-3xl sm:text-4xl lg:text-[48px] font-serif text-[#082213] tracking-tight leading-[1.14] mb-3.5">
        {productsHeroData.titleLine1}
        <br />
        <span class="font-normal italic text-[#0f341f]">
          {productsHeroData.titleLine2}
        </span>
      </h1>

      <!-- Description -->
      <p class="text-xs sm:text-sm text-[#4d5e52] leading-relaxed max-w-md mb-6  sm:text-[18px]">
        {productsHeroData.description}
      </p>

      <!-- Action Row: Button + Social Proof -->
      <div class="flex items-center gap-5 sm:gap-6 flex-wrap">
        <!-- Explore Button -->
        <a 
          href={productsHeroData.buttonHref}
          class="inline-flex items-center gap-2 bg-[#0c3920] hover:bg-[#144d2d] text-white text-xs sm:text-sm font-medium px-5 py-2.5 rounded-full shadow-sm transition-all duration-200 group"
        >
          <span>{productsHeroData.buttonText}</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>

        <!-- Star Rating Proof -->
        <div class="flex items-center gap-2 text-xs">
          <span class="text-amber-500 text-sm">★</span>
          <span class="font-bold text-[#082213] text-sm">
            {productsHeroData.ratingScore}
          </span>
          <span class="text-[#526457] text-[11px] leading-tight">
            {productsHeroData.ratingLabelLine1}<br />
            {productsHeroData.ratingLabelLine2}
          </span>
        </div>
      </div>

    </div>
  </div>

  <!-- Carousel Controls (Next/Prev Arrows & Indicators) -->
  <div class="absolute bottom-6 right-6 sm:right-12 z-25 flex items-center gap-3">
    <!-- Indicators (Dots) -->
    <div class="flex items-center gap-1.5 mr-2" id="hero-carousel-dots">
      {productsHeroData.slides.map((_, i) => (
        <button
          type="button"
          data-dot-index={i}
          aria-label={`Go to slide ${i + 1}`}
          class={`hero-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
            i === 0 ? 'w-7 bg-[#0c3920]' : 'w-2 bg-[#768478]/50 hover:bg-[#0c3920]/80'
          }`}
        ></button>
      ))}
    </div>

    <!-- Arrow Controls -->
    <button
      type="button"
      id="hero-carousel-prev"
      aria-label="Previous slide"
      class="w-8 h-8 rounded-full bg-white/70 hover:bg-white text-[#082213] backdrop-blur-xs border border-[#ded5c5] flex items-center justify-center shadow-xs transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button
      type="button"
      id="hero-carousel-next"
      aria-label="Next slide"
      class="w-8 h-8 rounded-full bg-white/70 hover:bg-white text-[#082213] backdrop-blur-xs border border-[#ded5c5] flex items-center justify-center shadow-xs transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>
</section>
  <!-- Purity Standards & Mangaluru Craftsmanship Banner (Matching reference image) -->
  <section class="w-full bg-[#fbf9f4] border-b border-[#e2d8c3] py-5 sm:py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Top Row: 5 Botanical Purity Badges with Leaf-in-Droplet Icons -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 lg:gap-6 items-center justify-items-start sm:justify-items-center">
        {purityStandards.map((item) => (
          <div class="flex items-center gap-2.5 text-[#0c2a1a] group cursor-default">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#eaf4ed] text-[#1c643b] flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-[#1c643b] group-hover:text-white transition-colors duration-200">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                <path d="M12 9c-1.8 1.8-1.8 4.2 0 6 1.8-1.8 1.8-4.2 0-6z" fill="currentColor" fill-opacity="0.2" />
                <path d="M12 9v6" />
              </svg>
            </div>
            <span class="text-xs sm:text-[13px] font-semibold text-[#0c2a1a] tracking-tight whitespace-nowrap">
              {item}
            </span>
          </div>
        ))}
      </div>

      <!-- Subtle Divider Line -->
      <div class="w-full border-t border-[#ded5c2] my-4 sm:my-5"></div>

      <!-- Bottom Row: Mangaluru Botanical Craftsmanship Paragraph -->
      <p class="text-xs sm:text-[18px] text-[#425246] leading-relaxed text-left sm:text-justify max-w-6xl mx-auto font-normal">
        Kshithija Enterprises, based in Mangaluru, manufactures 100% natural beauty products crafted from plant-derived ingredients and backed by science. Free from parabens, silicones, mineral oils, and artificial fragrances, our formulations are lab-tested and dermatologist approved. From moisturizing creams to hair growth solutions, each product is designed to nourish skin and hair the natural way. Rooted in India’s botanical heritage and refined through modern research, our beauty range delivers visible, gentle results. Explore our <a href="#catalog" class="text-[#0c3920] font-semibold underline underline-offset-2 hover:text-[#1c643b] transition-colors">natural beauty products</a> crafted with care in Mangalore.
      </p>

    </div>
  </section>
<!-- Smooth Carousel Client-Side Controller -->
<script is:inline>
  (function () {
    const section = document.getElementById('products-hero-carousel');
    if (!section) return;

    const slides = Array.from(section.querySelectorAll('.hero-slide'));
    const dots = Array.from(section.querySelectorAll('.hero-dot'));
    const prevBtn = document.getElementById('hero-carousel-prev');
    const nextBtn = document.getElementById('hero-carousel-next');

    if (!slides.length) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = slides.length - 1;
      } else if (index >= slides.length) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      // Update slide opacities
      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      // Update dots
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove('w-2', 'bg-[#768478]/50');
          dot.classList.add('w-7', 'bg-[#0c3920]');
        } else {
          dot.classList.remove('w-7', 'bg-[#0c3920]');
          dot.classList.add('w-2', 'bg-[#768478]/50');
        }
      });
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4500);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        stopTimer();
        goToSlide(currentIndex - 1);
        startTimer();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        stopTimer();
        goToSlide(currentIndex + 1);
        startTimer();
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopTimer();
        goToSlide(i);
        startTimer();
      });
    });

    section.addEventListener('mouseenter', stopTimer);
    section.addEventListener('mouseleave', startTimer);

    // Initial start
    startTimer();
  })();
</script>




        </span>
    </button>
</div>
