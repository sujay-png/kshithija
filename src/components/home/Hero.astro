---
// src/components/Hero.astro
---

<section class="relative w-full min-h-[500px] sm:min-h-[540px] lg:min-h-[580px] bg-[#041a0d] overflow-hidden flex items-center">
  <!-- Background Image with Overlay -->
  <div 
    class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-all duration-700"
    style="background-image: url('/banner.jpg');"
  >
    <!-- Left Dark Gradient to ensure high-contrast text and smooth aesthetic -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#031409] via-[#04190c]/90 via-40% to-transparent"></div>
    
    <!-- Subtle Bottom Vignette -->
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/50 to-transparent"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 lg:px-16 w-full py-10 lg:py-16">
    <div class="max-w-xl text-left">
      
      <!-- Overlapping Herbal Leaves Icon -->
      <div class="mb-3 inline-block">
        <svg class="w-10 h-10 sm:w-12 sm:h-12 filter drop-shadow-md" viewBox="0 0 64 64" fill="none">
          <!-- Back light leaf -->
          <path d="M14 40C14 20 28 8 46 10C46 28 32 42 14 40Z" fill="#84cc16" />
          <!-- Front dark leaf -->
          <path d="M20 48C20 28 36 16 54 20C52 40 36 50 20 48Z" fill="#15803d" />
          <path d="M20 48C30 38 42 30 54 20" stroke="#86efac" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Main Heading in Elegant Script Font -->
      <h1 
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] text-white font-normal leading-[1.2] drop-shadow-lg tracking-wide"
        style="font-family: 'Great Vibes', 'Alex Brush', cursive;"
      >
        Mangaluru, Plant-Derived, Lab-Tested Skincare
      </h1>

      <!-- Glowing Divider Line -->
      <div class="h-[1.5px] w-full max-w-md bg-gradient-to-r from-[#22c55e] via-white/40 to-transparent my-3.5 sm:my-4"></div>

      <!-- Tagline -->
      <p class="text-xs sm:text-sm uppercase tracking-[0.2em] sm:tracking-[0.25em] text-gray-200 font-medium leading-relaxed">
        &ldquo; Formulated in Mangaluru. Free from parabens, silicones, and synthetic shortcuts. &rdquo;
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-3 mt-6">
        <!-- Explore Button -->
        <a 
          href="/products" 
          class="inline-flex items-center gap-2.5 bg-[#0a7a3b] hover:bg-[#086330] text-white text-xs font-semibold tracking-wider uppercase px-5 sm:px-6 py-3 rounded-xl shadow-lg transition-all duration-200 group active:scale-95"
        >
          <span>Explore Products</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <!-- Order Now Button -->
        <a 
          href="/products" 
          class="inline-flex items-center gap-2.5 bg-transparent hover:bg-white/10 text-white border border-white/80 hover:border-white text-xs font-semibold tracking-wider uppercase px-5 sm:px-6 py-3 rounded-xl backdrop-blur-xs transition-all duration-200 group active:scale-95"
        >
          <span>Order Now</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>


    </div>
  </div>


</section>

