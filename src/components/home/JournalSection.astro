---
// src/components/JournalSection.astro
import {
  getAllPosts,
  getFeaturedImage,
  formatDate,
  stripHtml,
} from '@lib/wordpress';

// Fetch all live posts from WordPress (with fallback to local blogs.json)
const allPosts = await getAllPosts();

// 4 posts for the 2x2 grid on the left
const gridPosts = allPosts.slice(0, 4);

// 2 wide banner cards for the right column (matching coastal / botanical guide themes from screenshot)
const widePost1 =
  allPosts.find((p) => p.slug === 'prevent-face-tanning-mangalore' || p.slug === 'all-day-smart-cream-benefits') ||
  allPosts[4] ||
  allPosts[0];

const widePost2 =
  allPosts.find((p) => p.slug === 'benefits-of-plant-based-personal-care-products' || p.slug.includes('botanical')) ||
  allPosts[5] ||
  allPosts[1];

const widePosts = [widePost1, widePost2].filter(Boolean);
---

<section class="relative w-full bg-[#fbf9f4] py-14 sm:py-20 px-4 sm:px-8 lg:px-16 border-t border-[#e8dfcf] overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <!-- Editorial Section Header (Exact Match to Screenshot) -->
    <div class="mb-8 sm:mb-12">
      <!-- Eyebrow -->
      <span class="text-xs font-serif tracking-[0.25em] text-[#1c643b] uppercase font-semibold block mb-2">
        From The Journal
      </span>

      <!-- Main Headline -->
      <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-serif font-medium text-[#082213] tracking-tight leading-[1.2]">
        Natural skin care products, understood
      </h2>

      <!-- Subtitle -->
      <p class="font-serif italic text-xs sm:text-sm text-[#5a6e61] tracking-[0.18em] uppercase mt-1">
        From the inside out.
      </p>
    </div>

    <!-- Editorial Journal Layout: 4 Grid Cards on Left, 2 Wide Cards on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- Left Column: 2x2 Grid (7 cols) -->
      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
          {gridPosts.map((post) => {
            const img = getFeaturedImage(post);
            const title = stripHtml(post.title?.rendered || 'Kshithija Natural Care');
            const dateStr = formatDate(post.date);

            return (
              <a
                href={`/blog/${post.slug}`}
                class="group bg-white rounded-2xl border border-[#ded5c5] overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col"
              >
                <!-- Card Image Container -->
                <div class="relative aspect-[4/3] w-full overflow-hidden bg-[#eee8db]">
                  <img
                    src={img.src}
                    alt={title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <!-- BLOG Badge Top Right -->
                  <span class="absolute top-3 right-3 px-2 py-0.5 rounded-xs bg-[#c26d36] text-white text-[10px] font-bold tracking-widest uppercase shadow-xs">
                    Blog
                  </span>
                </div>

                <!-- Card Content -->
                <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between bg-white">
                  <h3 class="text-sm sm:text-base font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors line-clamp-2 leading-snug mb-3">
                    {title}
                  </h3>

                  <div class="text-[11px] text-[#708076] font-medium flex items-center gap-1.5 pt-2 border-t border-[#f4ede0]">
                    <span>{dateStr}</span>
                    <span>•</span>
                    <span>No Comments</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <!-- All Articles Button (Left-aligned under 2x2 grid, matching screenshot) -->
        <div class="mt-8 sm:mt-10">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-none border border-[#082213] text-[#082213] hover:bg-[#082213] hover:text-white transition-all text-xs font-serif font-semibold tracking-wider uppercase group shadow-2xs"
          >
            <span>All Articles</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: 2 Stacked Wide Cards (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-5 sm:gap-6">
        {widePosts.map((post) => {
          const img = getFeaturedImage(post);
          const title = stripHtml(post.title?.rendered || 'Kshithija Natural Care');
          const dateStr = formatDate(post.date);

          return (
            <a
              href={`/blog/${post.slug}`}
              class="group bg-white rounded-2xl border border-[#ded5c5] overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col"
            >
              <!-- Wide Banner Container -->
              <div class="relative aspect-[16/8] sm:aspect-[2/1] w-full overflow-hidden bg-[#eee8db]">
                <img
                  src={img.src}
                  alt={title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <!-- BLOG Badge Top Right -->
                <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-xs bg-[#c26d36] text-white text-[10px] font-bold tracking-widest uppercase shadow-xs">
                  Blog
                </span>
              </div>

              <!-- Content -->
              <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between bg-white">
                <h3 class="text-base sm:text-lg font-serif font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors leading-snug mb-2">
                  {title}
                </h3>

                <div class="text-[11px] text-[#708076] font-medium flex items-center gap-1.5 pt-2 border-t border-[#f4ede0]">
                  <span>{dateStr}</span>
                  <span>•</span>
                  <span>No Comments</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </div>

  </div>
</section>
