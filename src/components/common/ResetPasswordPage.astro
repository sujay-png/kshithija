---
// src/components/ResetPasswordPage.astro
// Unified, modern redesign of the WooCommerce / My Account lost-password page
---

<div class="min-h-[85vh] bg-[#fcfaf6] text-[#082213] py-8 sm:py-14 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto space-y-6">
    
    <!-- Top Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="text-xs text-[#64748b]">
      <ol class="inline-flex items-center gap-2">
        <li><a href="/" class="hover:text-[#0c3920] transition-colors">Home</a></li>
        <li>/</li>
        <li><a href="/login" class="hover:text-[#0c3920] transition-colors">My account</a></li>
        <li>/</li>
        <li class="font-semibold text-[#082213]" id="breadcrumb-current" aria-current="page">Lost password</li>
      </ol>
    </nav>

    <!-- Page Title & Header -->
    <div class="border-b border-[#ded5c5] pb-4">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#082213] tracking-tight">
            My account
          </h1>
          <p class="text-xs sm:text-sm text-[#55695b] mt-1 font-medium" id="header-subtitle">
            Lost your password? Manage your account access securely.
          </p>
        </div>
        
      </div>
    </div>

    <!-- Red Alert Notice Banner (Matches WooCommerce Alert from Screenshot) -->
    <div id="account-conflict-alert" class="hidden p-4 sm:p-5 bg-[#fef2f2] border-l-4 border-red-600 rounded-2xl text-red-900 shadow-xs">
      <div class="flex items-start gap-3">
        <div class="w-7 h-7 rounded-full bg-red-600 text-white flex items-center justify-center shrink-0 font-bold text-sm">
          !
        </div>
        <div class="flex-1 min-w-0">
          <p id="conflict-alert-message" class="text-xs sm:text-sm font-semibold leading-relaxed">
            This password reset key is for a different user account. Please log out and try again.
          </p>
          <div class="mt-3 flex items-center gap-3">
            <button
              type="button"
              id="logout-and-retry-btn"
              class="px-3.5 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition shadow-xs cursor-pointer inline-flex items-center gap-1.5"
            >
              <span>Log out & try again</span>
              <span>&rarr;</span>
            </button>
            <span class="text-[11px] text-red-700 font-normal">
              Currently logged in as: <strong id="logged-in-username">User</strong>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Generic Error Banner -->
    <div id="generic-error-alert" class="hidden p-4 bg-red-50 border border-red-200 text-red-800 text-xs sm:text-sm rounded-2xl">
      <div class="flex items-start gap-2.5">
        <span class="text-base font-bold text-red-600 leading-none mt-0.5">✕</span>
        <span id="generic-error-text" class="flex-1 font-medium">An error occurred. Please try again.</span>
      </div>
    </div>

    <!-- Card Container -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-[#ded5c5] shadow-xs relative overflow-hidden">
      
      <!-- Top subtle green accent line -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#164e2d] via-[#2ea843] to-[#a3cf54]"></div>

      <!-- ======================================================== -->
      <!-- VIEW 1: REQUEST RESET LINK (Lost Password)               -->
      <!-- ======================================================== -->
      <div id="request-view" class="space-y-6">
        
        <p class="text-xs sm:text-sm text-[#4b5563] leading-relaxed">
          Lost your password? Please enter your username or email address. You will receive a link to create a new password via email.
        </p>

        <form id="request-form" class="space-y-5">
          <div>
            <label for="user_login" class="block text-xs font-bold uppercase tracking-wider text-[#082213] mb-2">
              Username or email <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="text"
                name="user_login"
                id="user_login"
                required
                autocomplete="username"
                placeholder="Enter your username or email address"
                class="w-full px-4 py-3.5 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:border-transparent transition-all shadow-2xs"
              />
              <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-base">
                👤
              </span>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="request-btn"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] active:scale-98 text-white font-bold text-xs sm:text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 group"
            >
              <span id="request-btn-text">RESET PASSWORD</span>
              <svg id="request-btn-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="request-btn-arrow" class="text-sm group-hover:translate-x-1 transition-transform">&rarr;</span>
            </button>
          </div>
        </form>

        <div class="pt-6 border-t border-[#ded5c5]/60 flex items-center justify-between text-xs">
          <a href="/login" class="font-semibold text-[#164e2d] hover:text-[#0c3920] hover:underline inline-flex items-center gap-1.5 transition-colors">
            <span>&larr;</span>
            <span>Back to Login</span>
          </a>
          <a href="/" class="text-[#718778] hover:text-[#082213] transition-colors">
            Return to Store
          </a>
        </div>
      </div>

      <!-- ======================================================== -->
      <!-- VIEW 1 SUCCESS: EMAIL DISPATCHED                         -->
      <!-- ======================================================== -->
      <div id="request-success-view" class="hidden text-center py-6 space-y-5">
        <div class="w-16 h-16 bg-[#eaf4ed] text-[#164e2d] rounded-2xl flex items-center justify-center mx-auto shadow-inner">
          <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>

        <div>
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#082213] mb-2">Check Your Email</h2>
          <p class="text-xs sm:text-sm text-[#5a6e61] max-w-sm mx-auto leading-relaxed">
            A password reset link has been dispatched to your email address. Please click the link to choose your new password.
          </p>
        </div>

    

        <div class="space-y-2.5 pt-2">
          <button
            type="button"
            id="resend-btn"
            class="w-full py-3 px-4 rounded-xl border border-[#164e2d] text-[#164e2d] hover:bg-[#164e2d]/5 font-semibold text-xs transition-colors cursor-pointer"
          >
            Try another username or email
          </button>
          <a
            href="/login"
            class="block w-full py-3 px-4 rounded-xl bg-[#164e2d] text-white hover:bg-[#0c3920] font-semibold text-xs transition-colors text-center shadow-xs"
          >
            Back to Login
          </a>
        </div>
      </div>

      <!-- ======================================================== -->
      <!-- VIEW 2: SET NEW PASSWORD (When key is in URL)            -->
      <!-- ======================================================== -->
      <div id="reset-view" class="hidden space-y-6">
        
        <p class="text-xs sm:text-sm text-[#4b5563] leading-relaxed">
          Enter a new password below.
        </p>

        <div class="p-3.5 bg-[#f5f9f6] border border-[#d2e4d7] rounded-2xl flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#eaf4ed] text-[#164e2d] flex items-center justify-center text-sm font-bold shrink-0">
            🔑
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-[10px] uppercase tracking-wider font-bold text-[#55695b]">Resetting Password For</p>
            <p id="reset-user-display" class="text-xs sm:text-sm font-bold text-[#082213] truncate">sanjana</p>
          </div>
        </div>

        <form id="reset-form" class="space-y-4">
          <!-- New Password -->
          <div>
            <label for="new_password" class="block text-xs font-bold uppercase tracking-wider text-[#082213] mb-1.5">
              New password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="password"
                id="new_password"
                name="new_password"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="Enter at least 6 characters"
                class="w-full px-4 py-3.5 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:border-transparent transition-all pr-11"
              />
              <button
                type="button"
                class="toggle-pwd absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#082213] focus:outline-none p-1 transition-colors"
                data-target="new_password"
                aria-label="Toggle password visibility"
              >
                <svg class="w-4 h-4 eye-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="w-4 h-4 eye-closed hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
            
            <div class="mt-2 flex items-center gap-1.5">
              <div id="strength-bar-1" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"></div>
              <div id="strength-bar-2" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"></div>
              <div id="strength-bar-3" class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"></div>
              <span id="strength-label" class="text-[10px] font-semibold text-gray-400 pl-1">Too short</span>
            </div>
          </div>

          <!-- Re-enter New Password -->
          <div>
            <label for="confirm_password" class="block text-xs font-bold uppercase tracking-wider text-[#082213] mb-1.5">
              Re-enter new password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="password"
                id="confirm_password"
                name="confirm_password"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="Confirm your new password"
                class="w-full px-4 py-3.5 rounded-xl bg-[#faf8f4] border border-[#ded5c5] text-xs sm:text-sm text-[#082213] placeholder-[#9caea2] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#164e2d] focus:border-transparent transition-all pr-11"
              />
              <button
                type="button"
                class="toggle-pwd absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#082213] focus:outline-none p-1 transition-colors"
                data-target="confirm_password"
                aria-label="Toggle password visibility"
              >
                <svg class="w-4 h-4 eye-open" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="w-4 h-4 eye-closed hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
            <p id="password-match-hint" class="hidden text-[11px] text-red-600 mt-1">
              Passwords do not match.
            </p>
          </div>

          <!-- Submit Button -->
          <div class="pt-3">
            <button
              type="submit"
              id="reset-btn"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] active:scale-98 text-white font-bold text-xs sm:text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 group"
            >
              <span id="reset-btn-text">SAVE PASSWORD</span>
              <svg id="reset-btn-spinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="reset-btn-arrow" class="text-sm group-hover:translate-x-1 transition-transform">&rarr;</span>
            </button>
          </div>
        </form>

        <div class="pt-6 border-t border-[#ded5c5]/60 text-center">
          <a href="/login" class="text-xs font-semibold text-[#164e2d] hover:underline">
            &larr; Cancel and return to Login
          </a>
        </div>
      </div>

      <!-- ======================================================== -->
      <!-- VIEW 2 SUCCESS: RESET COMPLETED                          -->
      <!-- ======================================================== -->
      <div id="reset-success-view" class="hidden text-center py-6 space-y-5">
        <div class="w-16 h-16 bg-[#eaf4ed] text-[#164e2d] rounded-2xl flex items-center justify-center mx-auto shadow-inner">
          <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>

        <div>
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#082213] mb-2">Password Successfully Changed!</h2>
          <p class="text-xs sm:text-sm text-[#5a6e61] max-w-sm mx-auto leading-relaxed">
            Your password has been securely updated. You can now log into your Kshithija account using your new credentials.
          </p>
        </div>

        <div class="pt-3">
          <a
            href="/login"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#164e2d] hover:bg-[#0c3920] active:scale-98 text-white font-bold text-xs sm:text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
          >
            <span>Log In to Your Account</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Hidden Submitter Form (Targeting invisible iframe for zero-CORS compatibility) -->
    <form
      id="fallback-lostpassword-form"
      method="POST"
      action="https://kshithija.in/wp-login.php?action=lostpassword"
      target="lostpassword_target_frame"
      class="hidden"
    >
      <input type="hidden" name="user_login" id="fallback_user_login" value="" />
      <input type="hidden" name="frontend_url" id="fallback_frontend_url" value="" />
      <input type="hidden" name="redirect_to" value="https://kshithija.in/wp-login.php?checkemail=confirm" />
    </form>

    <form
      id="fallback-resetpass-form"
      method="POST"
      action="https://kshithija.in/my-account/lost-password/"
      target="lostpassword_target_frame"
      class="hidden"
    >
      <input type="hidden" name="password_1" id="fallback_pass1" value="" />
      <input type="hidden" name="password_2" id="fallback_pass2" value="" />
      <input type="hidden" name="reset_key" id="fallback_key" value="" />
      <input type="hidden" name="reset_login" id="fallback_login" value="" />
      <input type="hidden" name="wc_reset_password" value="true" />
    </form>

    <iframe
      id="lostpassword_target_frame"
      name="lostpassword_target_frame"
      class="hidden"
      style="display:none;width:0;height:0;border:0;"
      tabindex="-1"
    ></iframe>

  </div>
</div>

<script>
  import { requestPasswordReset, resetPasswordWithKey, getStoredUser, logout } from "@lib/auth";

  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const key = params.get("key");
    const login = params.get("login") || params.get("id") || "";
    const notice = params.get("notice");
    const errorParam = params.get("error");

    const breadcrumbCurrent = document.getElementById("breadcrumb-current");
    const headerSubtitle = document.getElementById("header-subtitle");

    const requestView = document.getElementById("request-view");
    const requestSuccessView = document.getElementById("request-success-view");
    const resetView = document.getElementById("reset-view");
    const resetSuccessView = document.getElementById("reset-success-view");
    const resetUserDisplay = document.getElementById("reset-user-display");

    const conflictAlert = document.getElementById("account-conflict-alert");
    const conflictMsg = document.getElementById("conflict-alert-message");
    const loggedInUserSpan = document.getElementById("logged-in-username");
    const logoutBtn = document.getElementById("logout-and-retry-btn");

    const genericErrorAlert = document.getElementById("generic-error-alert");
    const genericErrorText = document.getElementById("generic-error-text");

    // Check if current user is logged in
    const currentUser = getStoredUser();

    // Check for user account conflict (e.g. logged in as one user, but resetting another)
    if (currentUser) {
      if (loggedInUserSpan) loggedInUserSpan.textContent = currentUser.username || currentUser.email || "Active User";

      if (login && currentUser.username && currentUser.username.toLowerCase() !== login.toLowerCase()) {
        if (conflictAlert) conflictAlert.classList.remove("hidden");
        if (conflictMsg) {
          conflictMsg.textContent = "This password reset key is for a different user account (" + login + "). Please log out and try again.";
        }
      } else if (notice === "different_user" || errorParam === "different_user") {
        if (conflictAlert) conflictAlert.classList.remove("hidden");
      }
    } else if (notice === "different_user" || errorParam === "different_user") {
      if (conflictAlert) conflictAlert.classList.remove("hidden");
    }

    // Handle 1-click logout and retry
    logoutBtn?.addEventListener("click", () => {
      logout(false as any);
      // Reload current page without conflicting session
      window.location.reload();
    });

    // Toggle password eye visibility
    document.querySelectorAll(".toggle-pwd").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (!input) return;
        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";

        const eyeOpen = btn.querySelector(".eye-open");
        const eyeClosed = btn.querySelector(".eye-closed");
        if (isPassword) {
          eyeOpen?.classList.add("hidden");
          eyeClosed?.classList.remove("hidden");
        } else {
          eyeOpen?.classList.remove("hidden");
          eyeClosed?.classList.add("hidden");
        }
      });
    });

    // Password strength indicator
    const newPwdInput = document.getElementById("new_password") as HTMLInputElement | null;
    const bar1 = document.getElementById("strength-bar-1");
    const bar2 = document.getElementById("strength-bar-2");
    const bar3 = document.getElementById("strength-bar-3");
    const strengthLabel = document.getElementById("strength-label");

    newPwdInput?.addEventListener("input", () => {
      const val = newPwdInput.value;
      let score = 0;
      if (val.length >= 6) score++;
      if (val.length >= 8 && /[0-9]/.test(val)) score++;
      if (val.length >= 10 && /[A-Z]/.test(val) && /[^A-Za-z0-9]/.test(val)) score++;

      if (bar1 && bar2 && bar3 && strengthLabel) {
        bar1.className = "h-1 flex-1 rounded-full transition-colors " + (score >= 1 ? "bg-red-400" : "bg-gray-200");
        bar2.className = "h-1 flex-1 rounded-full transition-colors " + (score >= 2 ? "bg-amber-400" : "bg-gray-200");
        bar3.className = "h-1 flex-1 rounded-full transition-colors " + (score >= 3 ? "bg-emerald-500" : "bg-gray-200");

        if (score === 0) strengthLabel.textContent = "Too short";
        else if (score === 1) strengthLabel.textContent = "Weak";
        else if (score === 2) strengthLabel.textContent = "Medium";
        else strengthLabel.textContent = "Strong";
      }
    });

    // DETECT URL STATE: Set Password View if key is in URL
    if (key) {
      if (breadcrumbCurrent) breadcrumbCurrent.textContent = "Reset password";
      if (headerSubtitle) headerSubtitle.textContent = "Enter a new password below for your account.";
      if (resetUserDisplay) resetUserDisplay.textContent = login || "Your Account";

      requestView?.classList.add("hidden");
      requestSuccessView?.classList.add("hidden");
      resetView?.classList.remove("hidden");
    }

    // =========================================================
    // 1. Handle Request Reset Email Form
    // =========================================================
    const requestForm = document.getElementById("request-form") as HTMLFormElement | null;
    const requestBtn = document.getElementById("request-btn") as HTMLButtonElement | null;
    const requestBtnText = document.getElementById("request-btn-text");
    const requestBtnSpinner = document.getElementById("request-btn-spinner");
    const requestBtnArrow = document.getElementById("request-btn-arrow");

    requestForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      genericErrorAlert?.classList.add("hidden");

      const input = document.getElementById("user_login") as HTMLInputElement | null;
      const userLogin = input?.value?.trim() || "";

      if (!userLogin) {
        if (genericErrorText) genericErrorText.textContent = "Please enter your username or email address.";
        genericErrorAlert?.classList.remove("hidden");
        return;
      }

      if (requestBtn) requestBtn.disabled = true;
      requestBtnSpinner?.classList.remove("hidden");
      requestBtnArrow?.classList.add("hidden");
      if (requestBtnText) requestBtnText.textContent = "Sending Email...";

      try {
        const res = await requestPasswordReset(userLogin);
        if (res.fallback) {
          const fallbackForm = document.getElementById("fallback-lostpassword-form") as HTMLFormElement | null;
          const fallbackInput = document.getElementById("fallback_user_login") as HTMLInputElement | null;
          const fallbackFrontendUrl = document.getElementById("fallback_frontend_url") as HTMLInputElement | null;
          if (fallbackFrontendUrl) {
            fallbackFrontendUrl.value = window.location.origin;
          }
          if (fallbackForm && fallbackInput) {
            fallbackInput.value = userLogin;
            fallbackForm.submit();
          }
        }

        await new Promise((r) => setTimeout(r, 700));

        requestView?.classList.add("hidden");
        requestSuccessView?.classList.remove("hidden");
      } catch (err: any) {
        if (genericErrorText) {
          genericErrorText.textContent = err.message || "Failed to send reset email. Please verify your details.";
        }
        genericErrorAlert?.classList.remove("hidden");
      } finally {
        if (requestBtn) requestBtn.disabled = false;
        requestBtnSpinner?.classList.add("hidden");
        requestBtnArrow?.classList.remove("hidden");
        if (requestBtnText) requestBtnText.textContent = "RESET PASSWORD";
      }
    });

    // Resend / try another email
    const resendBtn = document.getElementById("resend-btn");
    resendBtn?.addEventListener("click", () => {
      requestSuccessView?.classList.add("hidden");
      requestView?.classList.remove("hidden");
      genericErrorAlert?.classList.add("hidden");
    });

    // =========================================================
    // 2. Handle Set New Password Form
    // =========================================================
    const resetForm = document.getElementById("reset-form") as HTMLFormElement | null;
    const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement | null;
    const resetBtnText = document.getElementById("reset-btn-text");
    const resetBtnSpinner = document.getElementById("reset-btn-spinner");
    const resetBtnArrow = document.getElementById("reset-btn-arrow");
    const matchHint = document.getElementById("password-match-hint");

    resetForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      genericErrorAlert?.classList.add("hidden");
      matchHint?.classList.add("hidden");

      const confirmPwdInput = document.getElementById("confirm_password") as HTMLInputElement | null;
      const newPassword = newPwdInput?.value || "";
      const confirmPassword = confirmPwdInput?.value || "";

      if (newPassword.length < 6) {
        if (genericErrorText) genericErrorText.textContent = "Password must be at least 6 characters long.";
        genericErrorAlert?.classList.remove("hidden");
        return;
      }

      if (newPassword !== confirmPassword) {
        if (matchHint) matchHint.classList.remove("hidden");
        if (genericErrorText) genericErrorText.textContent = "Passwords do not match. Please re-enter.";
        genericErrorAlert?.classList.remove("hidden");
        return;
      }

      if (resetBtn) resetBtn.disabled = true;
      resetBtnSpinner?.classList.remove("hidden");
      resetBtnArrow?.classList.add("hidden");
      if (resetBtnText) resetBtnText.textContent = "Saving Password...";

      try {
        let success = false;
        try {
          const res = await resetPasswordWithKey({
            key: key || "",
            login: login || "",
            password: newPassword,
          });
          if (res.success) success = true;
        } catch (apiErr) {
          const fbForm = document.getElementById("fallback-resetpass-form") as HTMLFormElement | null;
          const fbP1 = document.getElementById("fallback_pass1") as HTMLInputElement | null;
          const fbP2 = document.getElementById("fallback_pass2") as HTMLInputElement | null;
          const fbKey = document.getElementById("fallback_key") as HTMLInputElement | null;
          const fbLogin = document.getElementById("fallback_login") as HTMLInputElement | null;
          if (fbForm && fbP1 && fbP2 && fbKey && fbLogin) {
            fbP1.value = newPassword;
            fbP2.value = confirmPassword;
            fbKey.value = key || "";
            fbLogin.value = login || "";
            fbForm.submit();
            success = true;
          }
        }

        await new Promise((r) => setTimeout(r, 800));

        if (success) {
          resetView?.classList.add("hidden");
          resetSuccessView?.classList.remove("hidden");
        }
      } catch (err: any) {
        if (genericErrorText) {
          genericErrorText.textContent = err.message || "Failed to reset password. The link may have expired.";
        }
        genericErrorAlert?.classList.remove("hidden");
      } finally {
        if (resetBtn) resetBtn.disabled = false;
        resetBtnSpinner?.classList.add("hidden");
        resetBtnArrow?.classList.remove("hidden");
        if (resetBtnText) resetBtnText.textContent = "SAVE PASSWORD";
      }
    });
  });
</script>
