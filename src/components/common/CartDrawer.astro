---
// src/components/CartDrawer.astro
// Interactive Slide-Out Shopping Cart Drawer for Kshithija Enterprises
---

<!-- Cart Drawer Backdrop Overlay -->
<div
  id="cart-drawer-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-[999998] opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
</div>

<!-- Cart Drawer Slide-out Panel -->
<aside
  id="cart-drawer-panel"
  class="fixed top-0 right-0 bottom-0 w-full max-w-[430px] bg-[#fffdf8] shadow-2xl z-[999999] transform translate-x-full transition-transform duration-300 ease-out flex flex-col border-l border-[#ded5c5]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
>
  <!-- Drawer Header -->
  <div
    class="p-5 sm:p-6 bg-[#fbf9f4] border-b border-[#e8dfcf] flex items-center justify-between"
  >
    <div class="flex items-center gap-2.5">
      <div
        class="w-9 h-9 rounded-full bg-[#183e2a] text-white flex items-center justify-center text-sm shadow-xs"
      >
        <svg
          class="w-4 h-4 fill-none stroke-current stroke-2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
      </div>
      <div>
        <h2
          id="cart-drawer-title"
          class="text-base sm:text-lg font-serif font-bold text-[#082213]"
        >
          Your Shopping Cart
        </h2>
        <p class="text-[11px] text-[#627568]">
          <span id="cart-drawer-count">0</span> items in basket
        </p>
      </div>
    </div>

    <!-- Close Button -->
    <button
      type="button"
      id="close-cart-btn"
      class="w-8 h-8 rounded-full bg-white hover:bg-[#eee8db] border border-[#ded5c5] text-[#082213] flex items-center justify-center text-lg font-bold transition-colors cursor-pointer"
      aria-label="Close Shopping Cart"
    >
      &times;
    </button>
  </div>

  <!-- Free Shipping Notification Bar -->
  <div
    class="bg-[#eaf4ed] px-5 py-2.5 border-b border-[#d2e6d8] flex items-center gap-2 text-xs text-[#1c643b]"
  >
  
  </div>

  <!-- Cart Items List (Scrollable Area) -->
  <div
    id="cart-items-container"
    class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-4"
  >
    <!-- Populated dynamically via client script -->
  </div>

  <!-- Empty Cart State -->
  <div
    id="cart-empty-state"
    class="hidden flex-1 flex flex-col items-center justify-center p-6 text-center"
  >
    <div
      class="w-16 h-16 rounded-full bg-[#f4ede0] text-3xl flex items-center justify-center mb-3"
    >
      🛍️
    </div>
    <h3 class="text-base font-serif font-bold text-[#082213] mb-1">
      Your cart is empty
    </h3>
    <p class="text-xs text-[#627568] max-w-xs mb-5">
      Discover our natural herbal skincare, anti-dandruff creams, and vitality
      supplements.
    </p>
    <a
      href="/products"
      id="cart-continue-browsing"
      class="px-5 py-2.5 rounded-xl bg-[#0c3920] hover:bg-[#164e2d] text-white text-xs font-semibold uppercase tracking-wider transition-all"
    >
      Explore Products
    </a>
  </div>

  <!-- Drawer Footer (Subtotal & WhatsApp Checkout) -->
  <div
    id="cart-footer"
    class="p-5 sm:p-6 bg-white border-t border-[#e8dfcf] space-y-4"
  >
    <!-- Subtotal Row -->
    <div class="flex items-center justify-between text-sm">
      <span class="text-[#55695b] font-medium">Subtotal</span>
      <span
        id="cart-subtotal-price"
        class="text-xl font-bold font-serif text-[#082213]">₹0</span
      >
    </div>

    <p class="text-[11px] text-[#7a8c80]">
      Taxes and delivery calculated at checkout. WhatsApp ordering available.
    </p>

    <!-- Checkout Action Buttons -->
    <div class="space-y-2">
      <!-- Checkout Button with Live Amount -> Navigates to /checkout -->
      <a
        href="/checkout"
        class="relative w-full inline-flex items-center justify-center p-0.5 overflow-hidden text-sm font-semibold text-gray-900 rounded-xl group bg-gradient-to-br from-green-500 via-emerald-600 to-teal-700 hover:text-white shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer"
      >
        <span
          class="relative w-full px-5 py-3 transition-all ease-in duration-150 bg-white group-hover:bg-transparent rounded-[10px] flex items-center justify-center gap-2 font-bold tracking-wide"
        >
          <span>Checkout</span>
          <span class="opacity-40">•</span>
          <span id="cart-checkout-amount">₹0</span>
        </span>
      </a>

   

      <!-- View Full Cart Page Link -->
      <a
        href="/cart"
        class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-xl bg-[#f4ede0] hover:bg-[#eae0cf] text-[#0a1c12] border border-[#ded5c5] text-xs font-semibold transition-all text-center cursor-pointer"
      >
        <span>View Cart</span>
        <span>&rarr;</span>
      </a>

      <!-- Continue Shopping Button -->
      <button
        type="button"
        id="cart-continue-btn"
        class="w-full py-2.5 text-center text-xs font-semibold text-[#1c643b] hover:text-[#082213] hover:underline transition-colors cursor-pointer"
      >
        Continue Shopping &rarr;
      </button>
    </div>
  </div>
</aside>

<!-- Client Script to manage Cart state, events, and UI rendering -->
<script is:inline>
  (function () {
    const STORAGE_KEY = "kshithija_cart_v1";

    function getCart() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
      } catch (e) {}
      renderCartUI();
    }

    function parsePrice(priceStr) {
      if (!priceStr) return 0;
      const clean = String(priceStr).replace(/[^0-9.]/g, "");
      return parseFloat(clean) || 0;
    }

    window.KshithijaCart = {
      getItems() {
        return getCart();
      },
      addItem(item) {
        const cart = getCart();
        const existing = cart.find((i) => i.id === item.id);
        const qty = item.quantity || 1;

        if (existing) {
          existing.quantity = (existing.quantity || 1) + qty;
        } else {
          cart.push({
            id: item.id,
            name: item.name,
            price: item.price,
            priceNum: parsePrice(item.price),
            image: item.image,
            quantity: qty,
          });
        }
        saveCart(cart);
        window.KshithijaCart.open();
      },
      updateQty(id, delta) {
        let cart = getCart();
        const item = cart.find((i) => i.id === id);
        if (item) {
          item.quantity += delta;
          if (item.quantity <= 0) {
            cart = cart.filter((i) => i.id !== id);
          }
        }
        saveCart(cart);
      },
      removeItem(id) {
        let cart = getCart();
        cart = cart.filter((i) => i.id !== id);
        saveCart(cart);
      },
      clear() {
        saveCart([]);
      },
      open() {
        const backdrop = document.getElementById("cart-drawer-backdrop");
        const panel = document.getElementById("cart-drawer-panel");
        if (backdrop && panel) {
          backdrop.classList.remove("opacity-0", "pointer-events-none");
          backdrop.classList.add("opacity-100");
          panel.classList.remove("translate-x-full");
          panel.classList.add("translate-x-0");
          document.body.style.overflow = "hidden";
        }
      },
      close() {
        const backdrop = document.getElementById("cart-drawer-backdrop");
        const panel = document.getElementById("cart-drawer-panel");
        if (backdrop && panel) {
          backdrop.classList.remove("opacity-100");
          backdrop.classList.add("opacity-0", "pointer-events-none");
          panel.classList.remove("translate-x-0");
          panel.classList.add("translate-x-full");
          document.body.style.overflow = "";
        }
      },
    };

    function renderCartUI() {
      const cart = getCart();
      const totalQty = cart.reduce(
        (sum, item) => sum + (item.quantity || 1),
        0,
      );
      const subtotal = cart.reduce(
        (sum, item) =>
          sum +
          (item.priceNum || parsePrice(item.price)) * (item.quantity || 1),
        0,
      );

      // Update counters in all floating buttons and headers
      const floatingCounter = document.getElementById("floating-cart-counter");
      if (floatingCounter) {
        floatingCounter.textContent = totalQty;
        floatingCounter.classList.toggle("animate-bounce", totalQty > 0);
        setTimeout(
          () => floatingCounter.classList.remove("animate-bounce"),
          1000,
        );
      }

      const headerBadges = document.querySelectorAll(".cart-counter-badge");
      headerBadges.forEach((badge) => {
        badge.textContent = totalQty;
        badge.style.display = totalQty > 0 ? "flex" : "none";
      });

      const drawerCount = document.getElementById("cart-drawer-count");
      if (drawerCount) drawerCount.textContent = totalQty;

      const subtotalEl = document.getElementById("cart-subtotal-price");
      if (subtotalEl)
        subtotalEl.textContent = "₹" + subtotal.toLocaleString("en-IN");

      const checkoutAmountEl = document.getElementById("cart-checkout-amount");
      if (checkoutAmountEl)
        checkoutAmountEl.textContent = "₹" + subtotal.toLocaleString("en-IN");

      const container = document.getElementById("cart-items-container");
      const emptyState = document.getElementById("cart-empty-state");
      const footer = document.getElementById("cart-footer");
      const waCheckout = document.getElementById("cart-whatsapp-checkout");

      if (!container) return;

      if (cart.length === 0) {
        container.innerHTML = "";
        container.classList.add("hidden");
        if (emptyState) emptyState.classList.remove("hidden");
        if (footer) footer.classList.add("hidden");
      } else {
        container.classList.remove("hidden");
        if (emptyState) emptyState.classList.add("hidden");
        if (footer) footer.classList.remove("hidden");

        // Render Item cards
        container.innerHTML = cart
          .map((item) => {
            const itemTotal =
              (item.priceNum || parsePrice(item.price)) * item.quantity;
            return `
            <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-white border border-[#ded5c5] shadow-xs">
              <img src="${item.image}" alt="${item.name}" class="w-16 h-16 rounded-xl object-cover bg-[#f4ede0] shrink-0 border border-[#e8dfcf]" />
              
              <div class="flex-1 min-w-0">
                <h4 class="text-xs sm:text-sm font-semibold text-[#082213] truncate">${item.name}</h4>
                <p class="text-xs font-bold text-[#1c643b] mt-0.5">${item.price}</p>
                
                <div class="flex items-center gap-2 mt-2">
                  <div class="inline-flex items-center border border-[#ded5c5] rounded-lg bg-[#faf8f4]">
                    <button type="button" class="cart-qty-btn px-2 py-0.5 text-xs font-bold text-[#082213] hover:bg-[#eee8db] transition-colors" data-action="minus" data-id="${item.id}">-</button>
                    <span class="px-2 text-xs font-semibold text-[#082213]">${item.quantity}</span>
                    <button type="button" class="cart-qty-btn px-2 py-0.5 text-xs font-bold text-[#082213] hover:bg-[#eee8db] transition-colors" data-action="plus" data-id="${item.id}">+</button>
                  </div>

                  <button type="button" class="cart-remove-btn text-[11px] text-red-600 hover:underline cursor-pointer ml-auto" data-id="${item.id}">
                    Remove
                  </button>
                </div>
              </div>
            </div>
          `;
          })
          .join("");

        // Prepare WhatsApp Checkout Link
        if (waCheckout) {
          const itemsText = cart
            .map(
              (i, idx) =>
                `${idx + 1}. ${i.name} (Qty: ${i.quantity}) - ₹${(i.priceNum || parsePrice(i.price)) * i.quantity}`,
            )
            .join("%0A");
          const message = `Hello Kshithija Enterprises, I would like to place an order:%0A%0A${itemsText}%0A%0ATotal Amount: ₹${subtotal.toLocaleString("en-IN")}%0A%0APlease confirm availability and shipping details.`;
          waCheckout.href = `https://wa.me/919482126493?text=${message}`;
        }
      }
    }

    // Initialize Event Listeners
    document.addEventListener("DOMContentLoaded", () => {
      renderCartUI();

      // Open Cart buttons
      const openCartBtn = document.getElementById("open-cart-btn");
      if (openCartBtn) {
        openCartBtn.addEventListener("click", (e) => {
          e.preventDefault();
          window.KshithijaCart.open();
        });
      }

      // Close Cart buttons
      const closeCartBtn = document.getElementById("close-cart-btn");
      const backdrop = document.getElementById("cart-drawer-backdrop");
      const continueBtn = document.getElementById("cart-continue-btn");
      const continueBrowsing = document.getElementById(
        "cart-continue-browsing",
      );

      if (closeCartBtn)
        closeCartBtn.addEventListener("click", window.KshithijaCart.close);
      if (backdrop)
        backdrop.addEventListener("click", window.KshithijaCart.close);
      if (continueBtn)
        continueBtn.addEventListener("click", window.KshithijaCart.close);
      if (continueBrowsing)
        continueBrowsing.addEventListener("click", window.KshithijaCart.close);

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") window.KshithijaCart.close();
      });

      // Quantity and Remove delegation in cart container
      const container = document.getElementById("cart-items-container");
      if (container) {
        container.addEventListener("click", (e) => {
          const target = e.target;
          if (target.classList.contains("cart-qty-btn")) {
            const id = target.getAttribute("data-id");
            const action = target.getAttribute("data-action");
            if (id) {
              window.KshithijaCart.updateQty(id, action === "plus" ? 1 : -1);
            }
          } else if (target.classList.contains("cart-remove-btn")) {
            const id = target.getAttribute("data-id");
            if (id) {
              window.KshithijaCart.removeItem(id);
            }
          }
        });
      }

      // Global delegation for any [data-add-to-cart] buttons
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-add-to-cart]");
        if (btn) {
          e.preventDefault();
          const id = btn.getAttribute("data-product-id");
          const name = btn.getAttribute("data-product-name");
          const price = btn.getAttribute("data-product-price");
          const image = btn.getAttribute("data-product-image");

          // Check if quantity selector input is present on detail page
          const qtyInput = document.getElementById("detail-qty");
          const qty = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

          if (id && name) {
            window.KshithijaCart.addItem({
              id,
              name,
              price: price || "₹349",
              image: image || "",
              quantity: qty,
            });

            // Button visual feedback
            const labelEl = btn.querySelector(".btn-label") || btn;
            const originalHtml = labelEl.innerHTML;
            labelEl.innerHTML =
              '<span class="text-emerald-300">✓ Added!</span>';
            setTimeout(() => {
              labelEl.innerHTML = originalHtml;
            }, 1400);
          }
        }
      });
    });
  })();
</script>
