---
// src/components/Wellness/Hero.astro
interface Props {
  eyebrow?: string;
  titleLine1?: string;
  titleHighlight?: string;
  titleLine2?: string;
  description?: string;
  shopNowText?: string;
  shopNowHref?: string;
  contactText?: string;
  contactHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow = 'Kshithija Enterprises · Ayurvedic Health',
  titleLine1 = 'Lab Tested, 100%',
  titleHighlight = 'Natural',
  titleLine2 = 'Wellness Solutions',
  description = 'Handcrafted Ayurvedic vitality supplements and pure raw Western Ghats honey formulated without refined sugars, synthetic chemicals, or preservatives. Designed to restore daily vitality, immunity, and natural holistic balance.',
  shopNowText = 'Shop Now',
  shopNowHref = '#catalog',
  contactText = 'Contact Us',
  contactHref = '/career',
  imageSrc = '/products/raw-honey.png',
  imageAlt = 'Kshithija Pure Natural Honey and Ayurvedic Vitality Formulation',
} = Astro.props;

const purityStandards = [
  'Lab Tested',
  '100% Natural',
  'All Skin Types',
 
];
---

<!-- Wellness Hero Section (Same luxury aesthetic as Beauty page) -->
<section class="relative w-full bg-gradient-to-b from-[#f9f6ee] via-[#f4ede0] to-[#eee5d3] overflow-hidden border-b border-[#e5dec9]">
  
  <!-- Subtle decorative ambient glows -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#2ea843]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-0 w-80 h-80 bg-[#a3cf54]/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 text-left">
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e8f2ea] text-[#1c643b] text-xs font-semibold tracking-wider uppercase mb-3.5 border border-[#cbe4d1]/60">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2ea843] animate-pulse"></span>
          <span>{eyebrow}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-[50px] font-serif text-[#082213] tracking-tight leading-[1.14] mb-4">
          {titleLine1}
          <br />
          <span class="italic font-normal text-[#1e6b3e]">{titleHighlight}</span> {titleLine2}
        </h1>

        <!-- Description Paragraph -->
        <p class="text-xs sm:text-[18px] text-[#4d5e52] leading-relaxed max-w-xl mb-7 sm:mb-8 font-normal">
          {description}
        </p>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3.5 sm:gap-5 flex-wrap">
          <a
            href={shopNowHref}
            class="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3 rounded-full bg-[#082213] hover:bg-[#124225] active:scale-95 text-white text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 shadow-md hover:shadow-xl group"
          >
            <span>{shopNowText}</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <a
            href={contactHref}
            class="inline-flex items-center justify-center px-5 sm:px-6 py-3 rounded-full border border-[#082213]/30 hover:border-[#082213] text-[#082213] hover:bg-[#082213]/5 text-xs sm:text-sm font-semibold tracking-wide transition-all duration-200"
          >
            {contactText}
          </a>
        </div>
      </div>

      <!-- Right Image Column -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md lg:max-w-none group">
          <!-- Main Card Image -->
          <div class="relative rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 bg-white/60 border border-[#e8dfcf]/80 backdrop-blur-xs flex items-center justify-center p-6 sm:p-8">
            <img
              src={imageSrc}
              alt={imageAlt}
              class="w-auto h-auto max-h-[300px] sm:max-h-[360px] object-contain group-hover:scale-105 transition-transform duration-700 drop-shadow-md"
              onerror="if(this.src !== '/products/chaithanya-2000.png') { this.src = '/products/chaithanya-2000.png'; }"
            />
          </div>

          <!-- Subtle Botanical Floating Pill -->
          <div class="absolute -bottom-3 -left-3 sm:-left-4 bg-white/95 backdrop-blur-md border border-[#e2d8c3] rounded-2xl px-4 py-2.5 shadow-md flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-[#eaf4ed] text-[#1c643b] flex items-center justify-center text-sm font-bold shadow-2xs">
              🍯
            </div>
            <div class="text-left">
              <span class="text-[11px] font-bold text-[#082213] block leading-tight">100% Raw Forest Harvest</span>
              <span class="text-[10px] text-[#55695b] leading-tight">Zero Sugar Added · Lab Verified</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Purity Standards & Story Ribbon -->
  <div class="w-full bg-[#fbf9f4] border-t border-[#e2d8c3] py-5 sm:py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- 5 Botanical Purity Badges with Leaf-in-Droplet Icons -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 lg:gap-6 items-center justify-items-start sm:justify-items-center">
        {purityStandards.map((item) => (
          <div class="flex items-center gap-2.5 text-[#0c2a1a] group cursor-default">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#eaf4ed] text-[#1c643b] flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-[#1c643b] group-hover:text-white transition-colors duration-200">
              <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                <path d="M12 9c-1.8 1.8-1.8 4.2 0 6 1.8-1.8 1.8-4.2 0-6z" fill="currentColor" fill-opacity="0.2" />
                <path d="M12 9v6" />
              </svg>
            </div>
            <span class="text-xs sm:text-[13px] font-semibold text-[#0c2a1a] tracking-tight whitespace-nowrap">
              {item}
            </span>
          </div>
        ))}
      </div>

    

    
    </div>
  </div>
</section>