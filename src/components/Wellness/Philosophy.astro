---
// src/components/Wellness/Philosophy.astro
interface Props {
  bgImage?: string;
  cardImage?: string;
  turmericImage?: string;
}

const {
  bgImage = 'https://kshithija.in/wp-content/uploads/2026/07/turmeric-extract-768x403.webp',
  cardImage = '/philosophy-shirodhara.jpg',
  turmericImage = '/philosophy-turmeric.jpg',
} = Astro.props;

const exclusions = [
  'No refined sugars',
  'No artificial preservatives',
  'No synthetic binders',
  'No chemical additives',
];
---

<section class="relative w-full overflow-hidden py-14 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#181816] scroll-mt-20" id="philosophy">
  
  <!-- Atmospheric Botanical Background Image with Dark Vignette -->
  <div class="absolute inset-0 w-full h-full">
    <img 
      src={bgImage} 
      alt="Ayurvedic Wellness Therapy Background"
      class="w-full h-full object-cover object-center opacity-40 brightness-75 scale-105"
      onerror="if(this.src !== '/philosophy-turmeric.jpg') { this.src = '/philosophy-turmeric.jpg'; }"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/60 to-black/85 pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto">
    
    <!-- Central Overlapping Card (Exact visual match to Screenshot 1) -->
    <div class="bg-white rounded-none sm:rounded-2xl overflow-hidden shadow-2xl border border-white/20 transition-all duration-300">
      <div class="grid grid-cols-1 md:grid-cols-12 items-stretch">
        
        <!-- Left Side: Ayurvedic Healing Image -->
        <div class="md:col-span-5 relative min-h-[260px] md:min-h-full bg-[#1b1b19] overflow-hidden group">
          <img 
            src={cardImage} 
            alt="Ayurvedic Holistic Wellness"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            onerror="if(this.src !== '/philosophy-turmeric.jpg') { this.src = '/philosophy-turmeric.jpg'; }"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          
          <!-- Subtle tag on image -->
          <div class="absolute bottom-3 left-3 bg-[#082213]/85 backdrop-blur-xs text-white text-[10px] font-semibold tracking-wider uppercase px-2.5 py-1 rounded-sm border border-white/10">
            Ancient Healing · Living Vitality
          </div>
        </div>

        <!-- Right Side: White Content Box -->
        <div class="md:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between text-left bg-white">
          <div>
            <!-- Eyebrow -->
            <span class="text-[11px] font-bold uppercase tracking-widest text-[#1c643b] block mb-1.5">
              Our Philosophy
            </span>

            <!-- Main Heading -->
            <h2 class="text-2xl sm:text-3xl font-serif font-medium text-[#082213] tracking-tight leading-[1.2] mb-3.5">
              Formulated with care, <br class="hidden sm:inline" />
              <span class="italic font-normal text-[#1e6b3e]">backed by science</span>
            </h2>

            <!-- Paragraph 1 & 2 -->
            <div class="space-y-2.5 text-xs sm:text-[13px] text-[#4d5e52] leading-relaxed font-normal">
              <p>
                <strong class="font-semibold text-[#082213]">Kshithija Enterprises</strong>, based in Mangalore, crafts time-tested Ayurvedic wellness solutions engineered to support natural metabolic balance, energy endurance, and immune defense. Every formulation begins with a botanical intention and is clinically validated in certified laboratories for safety and potency.
              </p>
              <p>
                Our wellness formulations are 100% free from refined white sugar, synthetic fillers, artificial coloring, and chemical preservatives. We harness adaptogenic herbs such as Ashwagandha, Shatavari, and Amalaki alongside unheated raw forest honey to deliver authentic Ayurvedic wellness you can trust.
              </p>
            </div>

            <!-- 4 Clean Bullet Points -->
            <div class="mt-4 pt-3.5 border-t border-[#f0eae0] grid grid-cols-2 gap-2 text-xs font-semibold text-[#082213]">
              {exclusions.map((item) => (
                <div class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#1c643b]"></span>
                  <span>{item}</span>
                </div>
              ))}
            </div>

            <!-- Expandable Extended Content -->
            <div id="wellness-philosophy-extended" class="hidden mt-4 pt-4 border-t border-[#f0eae0] space-y-3 text-xs sm:text-[13px] text-[#4d5e52] leading-relaxed transition-all">
              <p>
                Whether seeking balanced daily stamina through Chaithanya 2000 Plus or pure nutrient-dense antioxidants through raw Western Ghats honey, each formulation is designed to restore vitality without harmful spikes or crashes.
              </p>
              
              <!-- Turmeric & Botanical Highlight Image -->
              <div class="my-3 rounded-xl overflow-hidden border border-[#e8dfcf] shadow-xs">
                <img 
                  src={turmericImage} 
                  alt="Pure Stone-Ground Ayurvedic Herbs"
                  class="w-full h-36 sm:h-44 object-cover object-center"
                />
              </div>

              <p>
                As a doctor-recommended natural wellness brand, Kshithija Enterprises remains committed to zero adulteration, ethical wild-harvesting, and complete transparency.
              </p>
              <p class="text-[11px] sm:text-xs text-[#2e4034] bg-[#fbf9f4] p-3 rounded-lg border border-[#e8dfcf]">
                Explore our full range at <span class="font-bold text-[#082213]">kshithija.in</span>, or connect with us directly. For inquiries, reach us at <a href="tel:9482126493" class="underline text-[#1c643b] font-semibold">9482126493</a> or <a href="mailto:kshithijamlr@gmail.com" class="underline text-[#1c643b]">kshithijamlr@gmail.com</a>. Visit our Mangaluru store today.
              </p>
            </div>

          </div>

          <!-- READ MORE Button -->
          <div class="pt-5 mt-4">
            <button
              type="button"
              id="wellness-philosophy-btn"
              class="inline-flex items-center justify-center px-6 py-2.5 bg-[#222222] hover:bg-[#082213] active:scale-95 text-white text-xs font-bold tracking-widest uppercase transition-all duration-200 shadow-xs hover:shadow-md cursor-pointer rounded-xs"
            >
              READ MORE
            </button>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<!-- Client-Side Toggle for READ MORE -->
<script>
  function setupWellnessPhilosophyToggle() {
    const btn = document.getElementById('wellness-philosophy-btn');
    const content = document.getElementById('wellness-philosophy-extended');
    if (!btn || !content) return;

    btn.addEventListener('click', () => {
      const isHidden = content.classList.contains('hidden');
      if (isHidden) {
        content.classList.remove('hidden');
        btn.textContent = 'SHOW LESS';
      } else {
        content.classList.add('hidden');
        btn.textContent = 'READ MORE';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWellnessPhilosophyToggle);
  } else {
    setupWellnessPhilosophyToggle();
  }
  document.addEventListener('astro:page-load', setupWellnessPhilosophyToggle);
</script>