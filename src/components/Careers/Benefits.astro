---
// src/components/Careers/Benefits.astro
---

<section class="relative w-full bg-[#f4ede0] py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 border-b border-[#e5dec9] overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <!-- Top Pill Eyebrow matching screenshot -->
    <div class="mb-5">
      <span class="inline-block px-4 py-1 rounded-full bg-white text-[#082213] text-[11px] sm:text-xs font-bold tracking-widest uppercase border border-[#ded5c5] shadow-2xs">
        OUR BENEFITS
      </span>
    </div>

    <!-- Main Two-Column Intro Grid with Large Heading and Decorative Arrows -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center mb-12 sm:mb-16">
      
      <!-- Left: Large Bold Headline matching screenshot -->
      <div class="lg:col-span-7">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[#082213] leading-[1.2] tracking-tight">
          <span class="text-[#e85438]">Our Enterprise Has Been</span> Present For Over 20 Years In Natural Care!
        </h2>
      </div>

      <!-- Right: Explanatory Copy & Diagonal Arrows Graphic matching screenshot -->
      <div class="lg:col-span-5 flex items-start justify-between gap-6">
        <p class="text-xs sm:text-[13.5px] text-[#4d5e52] leading-relaxed font-normal">
          Rooted in Mangaluru’s timeless coastal botanical heritage, Kshithija Enterprises fosters an inspiring, ethical workplace where passion for holistic health and pure formulations thrives. We believe our strength lies in nurturing our people.
        </p>

        <!-- Modern Diagonal Arrows Graphic (Exact visual element from screenshot) -->
        <div class="shrink-0 flex flex-col items-center justify-center text-[#082213] select-none pointer-events-none p-2">
          <!-- Top Right Arrow -->
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-[#082213] animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7" />
            <polyline points="7 7 17 7 17 17" />
          </svg>
          <!-- Bottom Left Arrow -->
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-[#082213] -mt-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="17" y1="7" x2="7" y2="17" />
            <polyline points="17 17 7 17 7 7" />
          </svg>
        </div>
      </div>

    </div>

    <!-- 3 Benefit Cards Row (Exact match to reference screenshot) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      
      <!-- Card 1: Award Winning -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-[#ded5c5] shadow-xs flex items-center gap-4 hover:shadow-md transition-all">
        <!-- Dark Circle Icon -->
        <div class="w-12 h-12 rounded-full bg-[#082213] text-white flex items-center justify-center text-xl shrink-0 shadow-xs">
          <svg class="w-6 h-6 fill-current text-[#eaf4ed]" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-[#082213] tracking-tight">
            Award winning
          </h3>
          <p class="text-[11px] sm:text-xs text-[#526357] leading-snug mt-0.5">
            Recognized for 100% natural, lab-tested formulations across coastal Karnataka.
          </p>
        </div>
      </div>

      <!-- Card 2: Well Allowance (Coral/Orange Accent Circle matching screenshot) -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-[#ded5c5] shadow-xs flex items-center gap-4 hover:shadow-md transition-all">
        <!-- Coral Circle Icon -->
        <div class="w-12 h-12 rounded-full bg-[#e85438] text-white flex items-center justify-center text-xl shrink-0 shadow-xs">
          <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <line x1="12" y1="8" x2="12" y2="16" />
            <line x1="8" y1="12" x2="16" y2="12" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-[#082213] tracking-tight">
            Well allowance
          </h3>
          <p class="text-[11px] sm:text-xs text-[#526357] leading-snug mt-0.5">
            Competitive compensation, travel stipends, and performance incentives.
          </p>
        </div>
      </div>

      <!-- Card 3: Full Insurance -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-[#ded5c5] shadow-xs flex items-center gap-4 hover:shadow-md transition-all">
        <!-- Dark Circle Icon -->
        <div class="w-12 h-12 rounded-full bg-[#082213] text-white flex items-center justify-center text-xl shrink-0 shadow-xs">
          <svg class="w-6 h-6 fill-current text-[#eaf4ed]" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-[#082213] tracking-tight">
            Full Insurance
          </h3>
          <p class="text-[11px] sm:text-xs text-[#526357] leading-snug mt-0.5">
            Comprehensive health coverage and complimentary personal care packages.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

