---
// src/components/Careers/OpeningsAndForm.astro

const jobOpenings = [
  {
    id: 'bde',
    title: 'Business Development Executive',
    type: '',
    location: '',
    badge: '',
    description:
      'Are you passionate about building relationships, driving growth, and creating new opportunities? If yes, a Business Development Executive (BDE) role is the perfect career path for you. At our organization, we believe in empowering individuals who are enthusiastic, goal-driven, and ready to make an impact in a fast-growing environment.',
  },
  
];
---

<section id="vacancies" class="relative w-full bg-[#fbf9f4] py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b border-[#e8dfcf]">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header (Exact match to reference screenshot & kshithija.in copy) -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <!-- Eyebrow Pill matching screenshot -->
    

      <!-- Exact Core Copy from kshithija.in/careers/ -->
    
    </div>

    <!-- Main Grid: 2x2 Job Openings (Left 7-8 cols) + Application Form (Right 4-5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- Left Column: 2x2 Grid of Job Openings -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6 w-250">
        {jobOpenings.map((job) => (
          <article 
            class={`bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-7 border transition-all duration-300 flex flex-col justify-between group hover:-translate-y-0.5 shadow-xs hover:shadow-lg ${
              job.badge ? 'border-[#1c643b]/40 ring-1 ring-[#1c643b]/20 relative' : 'border-[#e8dfcf]'
            }`}
          >
            <div>
              <!-- Top Row: Job Type Tag + Optional Badge -->
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="inline-block text-[11px] font-semibold text-[#6d7e73] tracking-wide">
                  {job.type}
                </span>
                {job.badge && (
                  <span class="inline-block text-[10px] font-bold uppercase tracking-wider bg-[#eaf4ed] text-[#1c643b] px-2 py-0.5 rounded-full border border-[#b8dfc4]">
                    ★ {job.badge}
                  </span>
                )}
              </div>

              <!-- Job Title -->
              <h3 class="text-lg sm:text-xl font-bold text-[#082213] group-hover:text-[#1c643b] transition-colors mb-2 tracking-tight font-serif">
                {job.title}
              </h3>

              <!-- Location Tag -->
              <div class="flex items-center gap-1.5 text-[11px] text-[#1c643b] font-medium mb-3">
               
                <span>{job.location}</span>
              </div>

              <!-- Job Description -->
              <p class="text-xs sm:text-[13px] text-[#55695b] leading-relaxed mb-6 font-normal">
                {job.description}
              </p>
            </div>

            <!-- Apply Now Button (Vibrant Coral/Orange Pill matching reference screenshot) -->
            <div>
             
            </div>
          </article>
        ))}
      </div>

      <!-- Right Column: Application Form Card (Matching kshithija.in/careers & screenshot) -->
      <div class="lg:col-span-5 sticky top-24">
        <div 
          id="application-form-card"
          class="bg-white rounded-3xl p-6 sm:p-8 border border-[#e8dfcf] shadow-xl relative transition-all duration-300"
        >
          
          <!-- Top Header Dark Navy / Forest Green Badge matching screenshot -->
          <div class="w-full mb-6 text-center">
            <span class="inline-block w-full py-3 px-6 rounded-2xl bg-[#082213] text-white text-sm sm:text-base font-bold tracking-wide shadow-md">
              Application Form
            </span>
          </div>

          <!-- Exact Form mirroring https://kshithija.in/careers/ -->
          <form 
            id="myForm" 
            action="https://formsubmit.co/kjobsales@gmail.com" 
            method="POST"
            class="space-y-4"
          >
            
            <!-- Hidden Settings from kshithija.in -->
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_subject" value="New Application Form Submission - Kshithija Enterprises" />

            <!-- Field 1: Your Name (Matching kshithija.in) -->
            <div>
              <label for="applicant-name" class="sr-only">Your Name</label>
              <input
                type="text"
                id="applicant-name"
                name="Name"
                required
                placeholder="Your Name*"
                class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
              />
            </div>

            <!-- Field 2: Mobile Number (Matching kshithija.in) -->
            <div>
              <label for="applicant-mobile" class="sr-only">Mobile Number</label>
              <input
                type="tel"
                id="applicant-mobile"
                name="Mobile Number"
                required
                placeholder="Mobile Number*"
                class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
              />
            </div>

            <!-- Field 3: Email Address (Matching kshithija.in) -->
            <div>
              <label for="applicant-email" class="sr-only">Email Address</label>
              <input
                type="email"
                id="applicant-email"
                name="Email"
                required
                placeholder="Email Address*"
                class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
              />
            </div>

            <!-- Field 4: City (Matching kshithija.in) -->
            <div>
              <label for="applicant-city" class="sr-only">City</label>
              <input
                type="text"
                id="applicant-city"
                name="City"
                required
                placeholder="City (e.g. Mangaluru, Udupi, Bengaluru)*"
                class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-[#f7f5ef] border border-[#e8dfcf] text-[#082213] placeholder-[#8c9e92] focus:outline-none focus:ring-2 focus:ring-[#1c643b] focus:bg-white transition-all"
              />
            </div>

         

            <!-- Submit Button (Coral/Orange Pill matching reference screenshot) -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 px-6 rounded-xl bg-[#e85438] hover:bg-[#d44327] active:scale-[0.98] text-white text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-md hover:shadow-lg cursor-pointer"
            >
              SEND APPLICATION
            </button>
          </form>

          <!-- Thank You Message (Matching kshithija.in id="thankyou") -->
          <div 
            id="thankyou" 
            class="hidden mt-4 p-4 rounded-xl bg-[#eaf4ed] border border-[#b8dfc4] text-center"
          >
            <h4 class="text-sm font-bold text-[#082213]">
              ✅ Thank you! Your form has been submitted.
            </h4>
            
          </div>

       

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Client Script matching kshithija.in's exact sendToWhatsApp handler -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const applyButtons = document.querySelectorAll('[data-apply-role]');
    const positionSelect = document.getElementById('applicant-position');
    const formCard = document.getElementById('application-form-card');
    const form = document.getElementById('myForm');
    const thankyou = document.getElementById('thankyou');
    const nameInput = document.getElementById('applicant-name');

    // Clicking "APPLY NOW" selects the role and scrolls to the form
    applyButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const role = e.currentTarget.getAttribute('data-apply-role');
        if (positionSelect && role) {
          positionSelect.value = role;
        }

        if (formCard) {
          formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          formCard.classList.add('ring-4', 'ring-[#e85438]/30');
          setTimeout(() => {
            formCard.classList.remove('ring-4', 'ring-[#e85438]/30');
          }, 1500);

          if (nameInput) {
            nameInput.focus();
          }
        }
      });
    });

    if (form) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const name = document.querySelector('input[name="Name"]')?.value || '';
        const mobile = document.querySelector('input[name="Mobile Number"]')?.value || '';
        const email = document.querySelector('input[name="Email"]')?.value || '';
        const city = document.querySelector('input[name="City"]')?.value || '';
        const position = positionSelect?.value || 'Business Development Executive';

        const message = encodeURIComponent(
          `New Application Form:\nName: ${name}\nMobile: ${mobile}\nEmail: ${email}\nCity: ${city}\nPosition: ${position}`
        );

        // Open WhatsApp to Kshithija's exact HR number (+91 94821 26493)
        window.open(`https://wa.me/9482126493?text=${message}`, '_blank');

        // Submit form data asynchronously to email endpoint
        const formData = new FormData(form);
        fetch('https://formsubmit.co/kjobsales@gmail.com', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        }).catch(() => {});

        // Hide form and show exact thank you message from website
        form.classList.add('hidden');
        if (thankyou) {
          thankyou.classList.remove('hidden');
        }
      });
    }
  });
</script>
